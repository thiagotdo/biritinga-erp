model Escola {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  inep        String?  // Código INEP (MEC)
  situacao    SituacaoEscola @default(ATIVA)

  cep         String?
  logradouro  String?
  bairro      String?
  zona        String?  // URBANA/RURAL
  telefone    String?
  email       String?

  diretor     String?
  secretario  String?

  // Capacidade
  salas       Int?
  capacidadeTotal Int?

  turmas      Turma[]
  servidores  ServidorEducacao[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, situacao])
}

model ServidorEducacao {
  id          String   @id @default(cuid())
  escolaId    String
  municipioId String

  nome        String
  cpf         String?
  cargo       String   // PROFESSOR/DIRETOR/COORDENADOR/MERENDEIRA/AUXILIAR
  disciplina  String?  // para professores
  formacao    String?  // licenciatura, especialização…
  habilitacao String?  // área de habilitação
  regime      String?  // CLT/ESTATUTARIO
  cargaHoraria Int?    // horas semanais
  ativo       Boolean  @default(true)

  escola      Escola @relation(fields: [escolaId], references: [id])
  turmas      TurmaServidor[]

  criadoEm    DateTime @default(now())

  @@index([escolaId])
  @@index([municipioId])
}

model Turma {
  id          String   @id @default(cuid())
  escolaId    String
  municipioId String

  codigo      String   // ex: "1A", "2B"
  etapa       EtapaEnsino
  ano         Int      // ano letivo
  serie       String?  // "1º Ano", "5º Ano"…
  turno       TurnoTurma
  capacidade  Int
  sala        String?

  professores TurmaServidor[]
  matriculas  Matricula[]
  frequencias RegistroFrequencia[]

  escola      Escola @relation(fields: [escolaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([escolaId, codigo, ano])
  @@index([escolaId])
  @@index([municipioId, ano])
  @@index([municipioId, etapa])
}

model TurmaServidor {
  id          String @id @default(cuid())
  turmaId     String
  servidorId  String
  disciplina  String?
  turma       Turma   @relation(fields: [turmaId], references: [id])
  servidor    ServidorEducacao @relation(fields: [servidorId], references: [id])
  @@unique([turmaId, servidorId])
}

model Aluno {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  cpf         String?
  dataNascimento DateTime?
  sexo        String?
  nomeMae     String?
  nomePai     String?
  responsavel String?
  telefoneResponsavel String?
  logradouro  String?
  bairro      String?
  zona        String?  // URBANA/RURAL — para transporte
  nee         Boolean  @default(false)  // necessidades educacionais especiais
  laudoNEE    String?  // CID da deficiência
  ativo       Boolean  @default(true)

  matriculas  Matricula[]
  frequencias RegistroFrequencia[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, bairro])
}

model Matricula {
  id          String   @id @default(cuid())
  alunoId     String
  turmaId     String
  municipioId String

  anoLetivo   Int
  situacao    SituacaoMatricula @default(ATIVA)
  dataMatricula DateTime @default(now())
  dataTransferencia DateTime?
  motivoTransferencia String?
  escolaDestino String?
  numeroChamada Int?

  aluno       Aluno @relation(fields: [alunoId], references: [id])
  turma       Turma @relation(fields: [turmaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([alunoId, turmaId, anoLetivo])
  @@index([turmaId])
  @@index([municipioId, anoLetivo])
  @@index([municipioId, situacao])
}

model RegistroFrequencia {
  id          String   @id @default(cuid())
  turmaId     String
  alunoId     String
  municipioId String

  data        DateTime
  presente    Boolean
  justificada Boolean  @default(false)
  observacao  String?

  turma       Turma @relation(fields: [turmaId], references: [id])
  aluno       Aluno @relation(fields: [alunoId], references: [id])

  criadoEm    DateTime @default(now())

  @@unique([turmaId, alunoId, data])
  @@index([turmaId, data])
  @@index([alunoId])
  @@index([municipioId])
}

model CardapioMerenda {
  id          String   @id @default(cuid())
  escolaId    String?  // null = cardápio geral de todas as escolas
  municipioId String

