  dataVencimento DateTime?
  dataRevogacao  DateTime?
  motivoRevogacao String?

  // Referência externa (NIS, número do benefício federal)
  referenciaExterna String?
  observacoes       String?

  usuarioId   String
  criadoEm   DateTime @default(now())

  @@index([municipioId, familiaId])
  @@index([municipioId, tipo, situacao])
}

