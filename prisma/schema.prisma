// ─── schema-patrimonio.prisma ───
// ─── PATRIMÔNIO PÚBLICO ───────────────────────────────────────────────────────
// Lei 4.320/1964 — Normas Gerais de Direito Financeiro (Art. 94-105 bens públicos)
// NBR 14653 — Avaliação de bens
// NBC T 16.9 — Depreciação, amortização e exaustão no setor público (CFC)
// MCASP — Manual de Contabilidade Aplicada ao Setor Público
// Decreto 93.872/1986 — Inventário anual obrigatório
// Lei 8.666/1993 / Lei 14.133/2021 — aquisições licitadas

enum CategoriaBem {
  IMOVEL              // terrenos, prédios, galpões
  VEICULO             // frota (integra com módulo frota)
  MOVEL               // mesas, cadeiras, armários
  EQUIPAMENTO         // computadores, impressoras, servidores
  ELETRODOMESTICO     // geladeiras, ar-condicionado
  FERRAMENTA          // ferramentas e utensílios
  MAQUINA             // máquinas industriais e agrícolas
  OBRA_ARTE           // acervo cultural
  SEMOVENTE           // animais (bovinos etc.)
  INTANGIVEL          // softwares, licenças perpétuas
  OUTRO

enum EstadoConservacao {
  OTIMO
  BOM
  REGULAR
  RUIM
  PESSIMO
  IRRECUPERAVEL

enum SituacaoBem {
  ATIVO
  EM_MANUTENCAO
  EXTRAVIADO
  CEDIDO
  ALIENADO            // doação, leilão, permuta
  BAIXADO             // descartado/sucata
  DEPRECIADO_TOTAL    // valor residual atingido

enum TipoMovimentacao {
  ENTRADA             // aquisição, doação recebida
  TRANSFERENCIA       // entre secretarias/setores
  CESSAO              // cessão temporária p/ terceiros
  DEVOLUCAO           // retorno de cessão
  MANUTENCAO_SAIDA    // saiu para manutenção
  MANUTENCAO_RETORNO  // retornou da manutenção
  BAIXA               // descarte, sucata, perda
  ALIENACAO           // doação, leilão, permuta

enum SituacaoInventario {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO

model BemPatrimonial {
  id              String            @id @default(cuid())
  municipioId     String
  numeroPlaqueta  String            // número de tombamento/plaqueta
  descricao       String
  categoria       CategoriaBem
  marca           String?
  modelo          String?
  fabricante      String?
  serie           String?           // número de série
  anoFab          Int?
  cor             String?

  // Localização atual
  secretaria      String
  setor           String?
  local           String?           // sala, andar, prédio
  responsavel     String?           // servidor responsável pelo bem

  // Valores (MCASP — custo histórico)
  valorAquisicao  Decimal           @db.Decimal(12, 2)
  dataAquisicao   DateTime
  valorAtual      Decimal           @db.Decimal(12, 2)  // após depreciações
  valorResidual   Decimal           @db.Decimal(12, 2)  @default(0)  // valor mínimo

  // Depreciação (NBC T 16.9)
  vidaUtilAnos    Int?              // vida útil estimada em anos
  taxaDepAnual    Decimal?          @db.Decimal(5, 4)   // ex: 0.1000 = 10% a.a.
  depAcumulada    Decimal           @db.Decimal(12, 2)  @default(0)
  ultimaDepreciacao DateTime?

  // Aquisição
  fornecedor      String?
  nfNumero        String?
  processo        String?           // processo licitatório
  origemRecurso   String?           // federal, estadual, próprio

  // Estado
  estado          EstadoConservacao @default(BOM)
  situacao        SituacaoBem       @default(ATIVO)

  // Gestão
  seguro          Boolean           @default(false)
  seguradora      String?
  apolice         String?
  vencSeguro      DateTime?
  observacoes     String?           @db.Text
  ativo           Boolean           @default(true)
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  movimentacoes   MovimentacaoBem[]
  itensInventario InventarioBemItem[]

  @@unique([municipioId, numeroPlaqueta])
  @@index([municipioId, categoria])
  @@index([municipioId, situacao])
  @@index([municipioId, secretaria])

model MovimentacaoBem {
  id              String            @id @default(cuid())
  municipioId     String
  bemId           String
  tipo            TipoMovimentacao
  dataMovimentacao DateTime         @default(now())

  // Origem → Destino
  secretariaOrigem String?
  setorOrigem     String?
  secretariaDestino String?
  setorDestino    String?
  responsavelOrigem String?
  responsavelDestino String?

  motivo          String            @db.Text
  documento       String?           // número do ato/portaria
  observacoes     String?           @db.Text
  usuarioId       String?

  bem             BemPatrimonial    @relation(fields: [bemId], references: [id])

  @@index([municipioId, bemId])
  @@index([municipioId, tipo])
  @@index([municipioId, dataMovimentacao])

model DepreciacaoRegistro {
  id              String    @id @default(cuid())
  municipioId     String
  bemId           String
  competencia     String    // "2026-11" — mês de referência
  valorDepreciado Decimal   @db.Decimal(10, 2)
  valorAnterior   Decimal   @db.Decimal(12, 2)
  valorApos       Decimal   @db.Decimal(12, 2)
  metodo          String    @default("LINEAR")
  usuarioId       String?
  criadoEm        DateTime  @default(now())

  @@unique([bemId, competencia])
  @@index([municipioId, competencia])

model Inventario {
  id              String              @id @default(cuid())
  municipioId     String
  ano             Int
  descricao       String?
  situacao        SituacaoInventario  @default(ABERTO)
  dataInicio      DateTime            @default(now())
  dataFim         DateTime?
  responsavel     String
  observacoes     String?             @db.Text
  totalBens       Int?
  bensConfirmados Int?
  bensNaoEncontrados Int?
  usuarioId       String?
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  itens           InventarioBemItem[]

  @@unique([municipioId, ano])
  @@index([municipioId])

model InventarioBemItem {
  id              String    @id @default(cuid())
  inventarioId    String
  bemId           String
  municipioId     String

  // Estado encontrado no inventário
  encontrado      Boolean?
  estadoEncontrado EstadoConservacao?
  localEncontrado String?
  responsavelEncontrado String?
  observacoes     String?
  conferidoEm    DateTime?
  conferidoPor   String?

  inventario      Inventario      @relation(fields: [inventarioId], references: [id])
  bem             BemPatrimonial  @relation(fields: [bemId], references: [id])

  @@unique([inventarioId, bemId])
  @@index([inventarioId])
  @@index([municipioId])

// ─── schema-patrimonio.prisma ───
// ─── PATRIMÔNIO PÚBLICO ───────────────────────────────────────────────────────
// Lei 4.320/1964 Art. 94-105 — bens patrimoniais, alta e baixa
// NBC T 16.9 (CFC) — depreciação, amortização, exaustão de bens públicos
// Decreto-Lei 25/1937 — tombamento de bens culturais
// Lei 8.666/1993 Art. 17 — alienação de bens públicos
// CF Art. 183/191 — usucapião; Art. 100 — bens públicos inalienáveis (uso comum, especial)
// IN SEGES 205/1988 — gestão de material e patrimônio federal (referência)
  url      = env("DATABASE_URL")

enum TipoBem {
  IMOVEL          // Terrenos, edificações, benfeitorias
  MOVEL           // Móveis, equipamentos, veículos
  INTANGIVEL      // Software, marcas, direitos
  SEMOVENTE       // Animais
  INFRAESTRUTURA  // Redes, estradas, pontes

enum ClassificacaoBem {
  USO_COMUM       // Praças, ruas — inalienável CF Art. 99 I
  USO_ESPECIAL    // Prédios públicos — inalienável CF Art. 99 II
  DOMINICAL       // Patrimônio disponível — alienável

enum SituacaoBem {
  ATIVO
  EM_MANUTENCAO
  CEDIDO
  TRANSFERIDO
  BAIXADO
  TOMBADO

enum MetodoDepreciacao {
  LINHA_RETA        // NBC T 16.9 — método padrão setor público
  SOMA_DIGITOS      // Para bens com obsolescência acelerada
  UNIDADES_PRODUCAO // Para equipamentos mensuráveis por uso

enum TipoMovimentacao {
  INCORPORACAO      // Alta patrimonial
  TRANSFERENCIA     // Mudança de setor/unidade
  CESSAO            // Cessão de uso para terceiros
  RETORNO_CESSAO    // Retorno de cessão
  MANUTENCAO        // Envio/retorno manutenção
  BAIXA             // Baixa patrimonial (Lei 8.666 Art. 17)
  TOMBAMENTO        // Registro tombamento cultural
  REAVALIACAO       // Reavaliação do valor (NBC T 16.9)

model Bem {
  id                   String              @id @default(cuid())
  municipioId          String
  numeroBem            String              // Número patrimonial único
  descricao            String
  tipo                 TipoBem
  classificacao        ClassificacaoBem    @default(DOMINICAL)
  situacao             SituacaoBem         @default(ATIVO)

  // Localização
  setorId              String?
  setor                SetorPatrimonio?    @relation(fields: [setorId], references: [id])
  localizacao          String?             // Descrição do local
  responsavelId        String?             // Servidor responsável
  responsavelNome      String?

  // Valores (NBC T 16.9)
  valorAquisicao       Decimal             @db.Decimal(14,2)
  dataAquisicao        DateTime
  valorAtual           Decimal             @db.Decimal(14,2)  // Pós-depreciação
  valorResidual        Decimal?            @db.Decimal(14,2)  // Valor mínimo após depreciação total
  vidaUtilAnos         Int?                // Vida útil em anos

  // Depreciação
  metodoDepreciacao    MetodoDepreciacao   @default(LINHA_RETA)
  taxaDepreciacaoAnual Decimal?            @db.Decimal(6,4)   // Ex: 0.1000 = 10% a.a.
  depreciacaoAcumulada Decimal             @db.Decimal(14,2)  @default(0)
  ultimaDepreciacao    DateTime?

  // Tombamento (Decreto-Lei 25/1937)
  tombado              Boolean             @default(false)
  numeroTombamento     String?
  dataTombamento       DateTime?
  orgaoTombamento      String?             // IPHAN, IPAC, Conselho Municipal
  motivoTombamento     String?

  // Documento de origem
  fornecedor           String?
  notaFiscal           String?
  empenho              String?
  origemRecurso        String?             // Federal, estadual, municipal

  // Placa / identificação física
  numeroPlaquet        String?
  numeroChassi         String?
  numeroCertReg        String?             // Matrícula imovel / Cert. Registro

  ativo                Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  movimentacoes        MovimentacaoPatrimonial[]
  depreciacoes         RegistroDepreciacao[]
  inventarios          ItemInventario[]

  @@unique([municipioId, numeroBem])
  @@index([municipioId, tipo, situacao])
  @@index([municipioId, setorId])
  @@map("bens_patrimoniais")

model SetorPatrimonio {
  id          String   @id @default(cuid())
  municipioId String
  nome        String
  codigo      String
  responsavel String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  bens        Bem[]

  @@unique([municipioId, codigo])
  @@map("setores_patrimonio")

model MovimentacaoPatrimonial {
  id              String           @id @default(cuid())
  municipioId     String
  bemId           String
  bem             Bem              @relation(fields: [bemId], references: [id])
  tipo            TipoMovimentacao
  dataMovimento   DateTime         @default(now())
  usuarioId       String
  usuarioNome     String

  // Para transferências / cessões
  setorOrigemId   String?
  setorOrigemNome String?
  setorDestinoId  String?
  setorDestinoNome String?
  responsavelAnterior String?
  responsavelNovo String?

  // Para cessão
  cessionario     String?          // Nome do cessionário
  prazoMeses      Int?
  dataFimCessao   DateTime?

  // Para baixa (Lei 8.666 Art. 17)
  motivoBaixa     String?          // Leilão, doação, permuta, sinistro, obsolescência
  valorBaixa      Decimal?         @db.Decimal(14,2)
  autorizacaoBaixa String?         // Número do decreto/portaria autorizando

  // Para reavaliação
  valorAnterior   Decimal?         @db.Decimal(14,2)
  valorNovo       Decimal?         @db.Decimal(14,2)
  laudoAvaliacao  String?

  observacao      String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([municipioId, bemId])
  @@index([municipioId, tipo, dataMovimento])
  @@map("movimentacoes_patrimoniais")

model RegistroDepreciacao {
  id              String   @id @default(cuid())
  municipioId     String
  bemId           String
  bem             Bem      @relation(fields: [bemId], references: [id])
  competencia     String   // "YYYY-MM"
  valorDepreciado Decimal  @db.Decimal(14,2)  // Valor depreciado no período
  valorAcumulado  Decimal  @db.Decimal(14,2)  // Acumulado até este período
  valorContabil   Decimal  @db.Decimal(14,2)  // Valor após depreciação
  metodo          MetodoDepreciacao
  createdAt       DateTime @default(now())

  @@unique([bemId, competencia])
  @@index([municipioId, competencia])
  @@map("registros_depreciacao")

model Inventario {
  id          String   @id @default(cuid())
  municipioId String
  exercicio   Int
  dataInicio  DateTime
  dataFim     DateTime?
  responsavel String
  situacao    String   @default("EM_ANDAMENTO") // EM_ANDAMENTO, CONCLUIDO, APROVADO
  totalBens   Int      @default(0)
  bensLocalizados Int  @default(0)
  bensNaoLocalizados Int @default(0)
  observacoes String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       ItemInventario[]

  @@unique([municipioId, exercicio])
  @@map("inventarios")

model ItemInventario {
  id           String    @id @default(cuid())
  municipioId  String
  inventarioId String
  inventario   Inventario @relation(fields: [inventarioId], references: [id])
  bemId        String
  bem          Bem        @relation(fields: [bemId], references: [id])
  localizado   Boolean?   // null = não verificado, true/false
  condicao     String?    // BOM, REGULAR, RUIM, INSERVIVEL
  localizacaoEncontrada String?
  observacao   String?
  verificadoEm DateTime?
  verificadoPor String?

  @@unique([inventarioId, bemId])
  @@map("itens_inventario")

// ─── schema-pgm.prisma ───
// ─── PGM — Procuradoria Geral do Município ────────────────────────────────────

enum TipoProcesso {
  ACAO_ORDINARIA
  MANDADO_SEGURANCA
  ACAO_POPULAR
  EXECUCAO_FISCAL
  DESAPROPRIACAO
  ACAO_CIVIL_PUBLICA
  RECURSO_ADMINISTRATIVO
  IMPUGNACAO_LICITACAO
  OUTROS

enum PoloProcesso {
  ATIVO        // município é autor
  PASSIVO      // município é réu
  TERCEIRO     // intervenção de terceiro

enum StatusProcesso {
  ATIVO
  SUSPENSO
  AGUARDANDO_PRAZO
  JULGADO
  ARQUIVADO
  TRANSITADO_EM_JULGADO

enum FaseProcesso {
  INICIAL
  INSTRUCAO
  ALEGACOES_FINAIS
  JULGAMENTO
  RECURSO
  EXECUCAO
  CUMPRIMENTO_SENTENCA

enum ResultadoProcesso {
  PROCEDENTE        // município ganhou (polo ativo) / reclamante ganhou
  IMPROCEDENTE      // município perdeu (polo ativo) / reclamante perdeu
  PARCIALMENTE_PROCEDENTE
  ACORDO
  EXTINCAO_SEM_JULGAMENTO

enum TipoContratoJuridico {
  ADMINISTRATIVO
  CONVENIADO
  CONSORCIO
  LOCACAO
  PRESTACAO_SERVICO
  OBRA
  FORNECIMENTO
  OUTROS

enum StatusContratoJuridico {
  MINUTA          // em elaboração
  APROVADO        // parecer jurídico emitido
  VIGENTE
  VENCIDO
  RESCINDIDO
  SUSPENSO

enum TipoParecer {
  CONTRATO
  LICITACAO
  ATOS_ADMINISTRATIVOS
  CONSULTA_JURIDICA
  RECURSO
  OUTROS

enum StatusParecer {
  SOLICITADO
  EM_ANALISE
  EMITIDO
  RETIFICADO

enum ClassificacaoParecer {
  FAVORAVEL
  DESFAVORAVEL
  COM_RESSALVAS
  INFORMATIVO

// ─── Processo Judicial / Administrativo ──────────────────────────────────────

model ProcessoJuridico {
  id                String             @id @default(cuid())
  municipioId       String
  numero            String             // "0001234-12.2026.8.05.0000"
  numeroInterno     String             // "PJ-2026-001"
  tipo              TipoProcesso
  polo              PoloProcesso
  status            StatusProcesso     @default(ATIVO)
  fase              FaseProcesso       @default(INICIAL)
  resultado         ResultadoProcesso?
  assunto           String
  descricao         String?
  vara              String?            // Vara / Tribunal
  comarca           String?
  juiz              String?
  parteContraria    String             // nome da parte adversa
  advogadoExterno   String?
  procuradorId      String?            // usuário responsável
  valorCausa        Decimal?           @db.Decimal(15,2)
  valorCondenacao   Decimal?           @db.Decimal(15,2)
  dataDistribuicao  DateTime
  dataTransito      DateTime?
  proximoPrazo      DateTime?          // próximo prazo processual
  observacoes       String?
  ativo             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  movimentos        MovimentoProcesso[]
  documentos        DocumentoProcesso[]

  @@unique([municipioId, numeroInterno])
  @@index([municipioId, status])
  @@index([municipioId, proximoPrazo])
  @@index([municipioId, tipo])

// ─── Movimentação Processual ──────────────────────────────────────────────────

model MovimentoProcesso {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  data        DateTime
  descricao   String
  tipoAto     String?   // "Sentença", "Despacho", "Intimação", etc.
  prazoFim    DateTime? // novo prazo gerado pelo ato
  usuarioId   String?
  createdAt   DateTime  @default(now())

  processo    ProcessoJuridico @relation(fields: [processoId], references: [id])

  @@index([processoId, data])

// ─── Documento Processual ─────────────────────────────────────────────────────

model DocumentoProcesso {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  nome        String
  tipo        String    // "Petição inicial", "Contestação", "Recurso", etc.
  url         String?
  usuarioId   String?
  createdAt   DateTime  @default(now())

  processo    ProcessoJuridico @relation(fields: [processoId], references: [id])

  @@index([processoId])

// ─── Contrato Jurídico (análise/controle) ─────────────────────────────────────

model ContratoJuridico {
  id              String                  @id @default(cuid())
  municipioId     String
  numero          String                  // "CJ-2026-001"
  tipo            TipoContratoJuridico
  status          StatusContratoJuridico  @default(MINUTA)
  objeto          String
  parteContratada String
  cnpjCpf         String?
  valor           Decimal?                @db.Decimal(15,2)
  dataAssinatura  DateTime?
  dataInicio      DateTime?
  dataFim         DateTime?
  procuradorId    String?
  parecerEmitido  Boolean                 @default(false)
  parecerFavoravel Boolean?
  cláusulas       String?                 // observações jurídicas relevantes
  observacoes     String?
  ativo           Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@index([municipioId, dataFim])

// ─── Parecer Jurídico ─────────────────────────────────────────────────────────

model ParecerJuridico {
  id              String                @id @default(cuid())
  municipioId     String
  numero          String                // "PAR-2026-001"
  tipo            TipoParecer
  status          StatusParecer         @default(SOLICITADO)
  classificacao   ClassificacaoParecer?
  assunto         String
  solicitante     String                // secretaria/setor solicitante
  solicitanteId   String?
  procuradorId    String?
  dataSolicitacao DateTime              @default(now())
  prazoResposta   DateTime?
  dataEmissao     DateTime?
  ementa          String?               // resumo do parecer
  fundamentacao   String?               // fundamentação jurídica
  conclusao       String?
  ressalvas       String?
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@index([municipioId, prazoResposta])

// ─── schema-portal.prisma ───
// ─── ERP Municipal — Módulo PORTAL DO CIDADÃO ─────────────────────────────────
// Lei 12.527/2011 — Lei de Acesso à Informação (LAI)
// Lei 13.460/2017 — Código de Defesa dos Usuários dos Serviços Públicos
// Decreto 9.492/2018 — regulamenta ombudsman / ouvidoria federal
// Lei 9.265/1996 — gratuidade em atos de cidadania
// Carta de Serviços ao Usuário — Lei 13.460 Art. 7
// LGPD (Lei 13.709/2018) — dados pessoais dos cidadãos
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoManifestacao {
  RECLAMACAO          // descontentamento com serviço
  DENUNCIA            // irregularidade / ilegalidade
  SUGESTAO            // proposta de melhoria
  ELOGIO              // reconhecimento positivo
  SOLICITACAO_INFO    // pedido de informação (LAI)
  RECURSO_LAI         // recurso de resposta LAI

enum SituacaoManifestacao {
  RECEBIDA
  EM_ANALISE
  ENCAMINHADA         // para órgão competente
  EM_RESPOSTA
  RESPONDIDA
  ARQUIVADA
  CANCELADA

enum PrioridadeManifestacao {
  URGENTE
  ALTA
  MEDIA
  BAIXA

enum TipoServicoCidadao {
  DOCUMENTO           // certidão, declaração, etc.
  LICENCA             // alvará, habite-se
  FISCAL              // 2ª via boleto, parcelamento
  INFRAESTRUTURA      // solicitação de serviço urbano
  SAUDE
  EDUCACAO
  ASSISTENCIA_SOCIAL
  OUTROS

enum SituacaoSolicitacao {
  RECEBIDA
  EM_ANALISE
  EM_ATENDIMENTO
  AGUARDANDO_CIDADAO  // documentos pendentes
  CONCLUIDA
  INDEFERIDA
  CANCELADA

// ─── Manifestação de Ouvidoria ────────────────────────────────────────────────

model Manifestacao {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "OUV-2026-000001"

  tipo        TipoManifestacao
  situacao    SituacaoManifestacao @default(RECEBIDA)
  prioridade  PrioridadeManifestacao @default(MEDIA)

  // Identificação do cidadão (pode ser anônima)
  anonimo     Boolean  @default(false)
  cidadaoNome String?
  cidadaoCPF  String?
  cidadaoEmail String?
  cidadaoTelefone String?
  cidadaoEndereco String?

  // Conteúdo
  assunto     String
  descricao   String   @db.Text
  orgaoRelacionado String?  // secretaria relacionada
  localOcorrencia  String?
  dataOcorrencia   DateTime?

  // Gestão interna
  analista    String?  // servidor responsável
  priorizado  Boolean  @default(false)
  sigiloso    Boolean  @default(false)  // LGPD / LAI

  // Resposta
  resposta    String?  @db.Text
  dataResposta DateTime?
  satisfacao  Int?     // 1-5 avaliação do cidadão

  // Prazos legais
  // LAI: 20 dias úteis (prorrogável +10)
  // Lei 13.460: prazo definido pelo órgão
  prazoResposta DateTime?
  dataLimite    DateTime?

  anexos      AnexoManifestacao[]
  tramitacoes TramitacaoManifestacao[]

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, cidadaoCPF])

model AnexoManifestacao {
  id            String @id @default(cuid())
  manifestacaoId String
  nomeArquivo   String
  url           String
  tamanho       Int?
  criadoEm      DateTime @default(now())

  manifestacao Manifestacao @relation(fields: [manifestacaoId], references: [id])

model TramitacaoManifestacao {
  id            String   @id @default(cuid())
  manifestacaoId String
  situacaoAnterior String?
  situacaoNova     String
  descricao        String  @db.Text
  responsavel      String?
  dataTramitacao   DateTime @default(now())

  manifestacao Manifestacao @relation(fields: [manifestacaoId], references: [id])

  @@index([manifestacaoId])

// ─── Carta de Serviços ao Cidadão ─────────────────────────────────────────────

model ServicoCidadao {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoServicoCidadao
  nome        String
  descricao   String   @db.Text
  requisitos  String?  @db.Text     // documentos necessários
  etapas      String?  @db.Text     // passo a passo
  prazoAtendimento String?          // ex: "5 dias úteis"
  taxas       Decimal? @db.Decimal(10,2)
  canais      String?               // presencial, online, telefone
  unidadeResponsavel String?
  horarioAtendimento String?
  legislacao  String?               // base legal

  ativo     Boolean  @default(true)
  destaque  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  solicitacoes SolicitacaoServico[]

  @@index([municipioId, tipo])
  @@index([municipioId, ativo])

// ─── Solicitação de Serviço ───────────────────────────────────────────────────

model SolicitacaoServico {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "SOL-2026-000001"
  servicoId   String

  situacao    SituacaoSolicitacao @default(RECEBIDA)

  // Cidadão
  cidadaoNome String
  cidadaoCPF  String
  cidadaoEmail String?
  cidadaoTelefone String?

  // Detalhes
  descricaoSolicitacao String? @db.Text
  documentosAnexados   String? @db.Text  // lista de docs enviados

  // Atendimento
  analista    String?
  resposta    String?  @db.Text
  motivoIndeferimento String? @db.Text
  dataPrevAtendimento DateTime?
  dataAtendimento     DateTime?

  satisfacao  Int?

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servico ServicoCidadao @relation(fields: [servicoId], references: [id])

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, cidadaoCPF])

// ─── Pedido LAI (Acesso à Informação) ────────────────────────────────────────

model PedidoLAI {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "LAI-2026-000001"

  // Requerente
  requerenteNome String
  requerenteCPF  String?
  requerenteEmail String
  requerenteTelefone String?
  requerenteEndereco String?

  // Pedido
  assunto     String
  descricao   String   @db.Text
  formatoResposta String @default("DIGITAL")  // DIGITAL / IMPRESSO / CONSULTA_LOCAL
  finalidade  String?

  situacao    String   @default("RECEBIDO")  // RECEBIDO / EM_ANALISE / RESPONDIDO / RECURSO_1 / RECURSO_2 / CONCLUIDO / NEGADO

  // Resposta
  resposta    String?  @db.Text
  dataResposta DateTime?
  motivoNegativa String? @db.Text  // hipóteses do Art. 23 da LAI
  formatoRespostaFinal String?

  // Prazos LAI
  dataLimiteResposta DateTime?   // 20 dias úteis (Art. 11)
  dataLimiteProrrogado DateTime? // +10 dias (Art. 11 §2)

  // Recurso
  recurso1    String?  @db.Text
  dataRecurso1 DateTime?
  respostaRecurso1 String? @db.Text
  recurso2    String?  @db.Text
  dataRecurso2 DateTime?
  respostaRecurso2 String? @db.Text

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])

// ─── schema-rh.prisma ───
// ─── ERP Municipal — Módulo RECURSOS HUMANOS & FOLHA ─────────────────────────
// CF/88 Arts. 37-41 — Regime Jurídico dos servidores públicos
// Lei 8.112/1990 — Estatuto dos Servidores Federais (referência)
// CLT — para servidores celetistas (emprego público)
// Lei 9.717/1998 — RPPS — Regime Próprio de Previdência Social
// IN RFB 971/2009 — contribuição previdenciária (INSS)
// Lei 7.713/1988 / RIR — IRRF tabela progressiva
// FGTS — Fundo de Garantia (celetistas) — Lei 8.036/1990
// LC 101/2000 — Lei de Responsabilidade Fiscal (limite folha: 60% RCL)
// CAGED / eSocial — obrigações acessórias
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RegimeJuridico {
  ESTATUTARIO       // concurso público, estabilidade
  CLT               // emprego público, celetista
  COMISSIONADO      // cargo em comissão, sem estabilidade
  ESTAGIARIO
  TEMPORARIO        // Lei 8.745/93 equivalente municipal

enum SituacaoServidor {
  ATIVO
  AFASTADO
  FERIAS
  CEDIDO
  LICENCA
  APOSENTADO
  EXONERADO
  DEMITIDO
  FALECIDO

enum VinculoFuncional {
  EFETIVO
  COMISSAO
  DESIGNACAO_FUNCAO
  CONTRATO_TEMPORARIO

enum TipoAfastamento {
  LICENCA_MEDICA
  LICENCA_MATERNIDADE     // 120-180 dias
  LICENCA_PATERNIDADE     // 5-20 dias
  LICENCA_GALA            // 8 dias
  LICENCA_LUTO            // 8 dias
  LICENCA_INTERESSE_PARTICULAR
  CEDENCIA
  MANDATO_ELETIVO
  MANDATO_CLASSISTA
  SUSPENSAO_DISCIPLINAR
  OUTROS

enum SituacaoFolha {
  RASCUNHO
  PROCESSADA
  FECHADA
  PAGA
  RETIFICADA

enum TipoFolha {
  MENSAL
  DECIMO_TERCEIRO_PRIMEIRO  // 1ª parcela (nov)
  DECIMO_TERCEIRO_SEGUNDO   // 2ª parcela (dez)
  FERIAS
  RESCISAO
  COMPLEMENTAR

enum TipoRubrica {
  PROVENTO      // acréscimo
  DESCONTO      // subtração
  INFORMATIVO   // não impacta líquido

enum SituacaoFerias {
  PROGRAMADA
  EM_GOZO
  CONCLUIDA
  CANCELADA
  CONVERTIDA_PECUNIA   // Art. 143 Lei 8.112 — conversão em abono pecuniário

// ─── Cargo / Função ───────────────────────────────────────────────────────────

model Cargo {
  id          String   @id @default(cuid())
  municipioId String

  codigo       String
  descricao    String
  cbo          String?    // Código Brasileiro de Ocupação
  nivelEscolaridade String?
  cargaHorariaSemanal Float @default(40)

  // Tabela salarial
  salarioBase  Decimal  @db.Decimal(10,2)

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  servidores Servidor[]

  @@unique([municipioId, codigo])
  @@index([municipioId])

// ─── Departamento / Secretaria ────────────────────────────────────────────────

model Departamento {
  id          String   @id @default(cuid())
  municipioId String

  codigo    String
  nome      String
  sigla     String?
  superiorId String?   // hierarquia
  responsavelId String?

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  servidores Servidor[]

  @@unique([municipioId, codigo])
  @@index([municipioId])

// ─── Servidor ─────────────────────────────────────────────────────────────────

model Servidor {
  id          String   @id @default(cuid())
  municipioId String
  matricula   String   // "SRV-000001"

  // Dados pessoais
  nome         String
  cpf          String
  rg           String?
  dataNascimento DateTime?
  sexo         String?   // M/F/O
  estadoCivil  String?
  nomeMae      String?
  naturalidade String?
  nacionalidade String @default("Brasileira")

  // Contato
  email        String?
  telefone     String?
  celular      String?
  enderecoRua  String?
  enderecoNumero String?
  enderecoBairro String?
  enderecoMunicipio String?
  enderecoUF   String?
  enderecoCEP  String?

  // Dados funcionais
  cargoId      String
  departamentoId String?
  regimeJuridico RegimeJuridico @default(ESTATUTARIO)
  vinculoFuncional VinculoFuncional @default(EFETIVO)
  situacao     SituacaoServidor @default(ATIVO)

  dataAdmissao  DateTime
  dataExoneracao DateTime?
  numeroPIS     String?   // NIT/PIS/PASEP
  numeroCtps    String?
  serieCtps     String?

  // Remuneração
  salarioBruto  Decimal  @db.Decimal(10,2)
  salarioBase   Decimal? @db.Decimal(10,2)

  // Conta bancária
  bancoNome    String?
  bancoCodigo  String?
  agencia      String?
  contaCorrente String?
  tipoConta    String?

  // Previdência
  regimePrevidencia String @default("RPPS")  // RPPS | RGPS
  aliquotaPrevidencia Float @default(14.0)   // % contribuição servidor

  // Jornada
  cargaHorariaSemanal Float @default(40)

  foto         String?   // URL
  observacoes  String?   @db.Text

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cargo       Cargo        @relation(fields: [cargoId], references: [id])
  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  afastamentos AfastamentoServidor[]
  ferias       FeriasServidor[]
  contracheques Contracheque[]

  @@unique([municipioId, matricula])
  @@unique([municipioId, cpf])
  @@index([municipioId, situacao])
  @@index([municipioId, departamentoId])

// ─── Afastamento ──────────────────────────────────────────────────────────────

model AfastamentoServidor {
  id          String   @id @default(cuid())
  municipioId String
  servidorId  String

  tipo        TipoAfastamento
  dataInicio  DateTime
  dataFim     DateTime?
  diasAfastamento Int?

  cid         String?    // CID-10 (licença médica)
  motivoDetalhado String? @db.Text
  peritoNome  String?
  documentoNumero String?

  prorrogavel Boolean @default(false)
  remunerado  Boolean @default(true)

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servidor Servidor @relation(fields: [servidorId], references: [id])

  @@index([municipioId, servidorId])
  @@index([municipioId, tipo])

// ─── Férias ───────────────────────────────────────────────────────────────────

model FeriasServidor {
  id          String   @id @default(cuid())
  municipioId String
  servidorId  String

  periodoAquisitivo String    // "2025/2026"
  dataInicioGozo   DateTime?
  dataFimGozo      DateTime?
  diasDireito      Int       @default(30)
  diasGozo         Int       @default(30)
  diasAbono        Int       @default(0)   // até 10 dias convertíveis

  situacao    SituacaoFerias @default(PROGRAMADA)
  valorAbono  Decimal? @db.Decimal(10,2)   // 1/3 constitucional

  dataVencimento DateTime?   // prazo máximo para gozar

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servidor Servidor @relation(fields: [servidorId], references: [id])

  @@unique([municipioId, servidorId, periodoAquisitivo])
  @@index([municipioId, situacao])

// ─── Rubrica (tabela de verbas) ───────────────────────────────────────────────

model Rubrica {
  id          String   @id @default(cuid())
  municipioId String

  codigo      String
  descricao   String
  tipo        TipoRubrica @default(PROVENTO)

  // Configuração de cálculo
  calculoAutomatico Boolean @default(false)
  baseCalculo  String?   // ex: "SALARIO_BASE", "BRUTO"
  percentual   Float?
  valorFixo    Decimal? @db.Decimal(10,2)

  incideINSS   Boolean @default(true)
  incideIRRF   Boolean @default(true)
  incideFGTS   Boolean @default(true)

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  itens ItemFolha[]

  @@unique([municipioId, codigo])
  @@index([municipioId])

// ─── Folha de Pagamento ───────────────────────────────────────────────────────

model FolhaPagamento {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "FOLHA-2026-11"

  competencia  String   // "2026-11"
  tipo         TipoFolha @default(MENSAL)
  situacao     SituacaoFolha @default(RASCUNHO)

  // Totais agregados
  totalProventos   Decimal @db.Decimal(14,2) @default(0)
  totalDescontos   Decimal @db.Decimal(14,2) @default(0)
  totalLiquido     Decimal @db.Decimal(14,2) @default(0)
  totalINSS        Decimal @db.Decimal(14,2) @default(0)
  totalIRRF        Decimal @db.Decimal(14,2) @default(0)
  totalFGTS        Decimal @db.Decimal(14,2) @default(0)
  quantidadeServid Int @default(0)

  dataProcessamento DateTime?
  dataFechamento    DateTime?
  dataPagamento     DateTime?

  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contracheques Contracheque[]

  @@unique([municipioId, numero])
  @@unique([municipioId, competencia, tipo])
  @@index([municipioId, situacao])

// ─── Contracheque (holerite individual) ───────────────────────────────────────

model Contracheque {
  id          String   @id @default(cuid())
  municipioId String
  folhaId     String
  servidorId  String

  competencia  String

  salarioBruto Decimal @db.Decimal(10,2)
  totalProventos Decimal @db.Decimal(10,2) @default(0)
  totalDescontos Decimal @db.Decimal(10,2) @default(0)
  totalLiquido   Decimal @db.Decimal(10,2) @default(0)

  // Encargos patronais
  inssServidor   Decimal @db.Decimal(10,2) @default(0)
  inssPatronal   Decimal @db.Decimal(10,2) @default(0)
  irrfRetido     Decimal @db.Decimal(10,2) @default(0)
  fgtsDeposito   Decimal @db.Decimal(10,2) @default(0)

  // Base de cálculo
  baseINSS       Decimal @db.Decimal(10,2) @default(0)
  baseIRRF       Decimal @db.Decimal(10,2) @default(0)

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  folha    FolhaPagamento @relation(fields: [folhaId], references: [id])
  servidor Servidor       @relation(fields: [servidorId], references: [id])
  itens    ItemFolha[]

  @@unique([municipioId, folhaId, servidorId])
  @@index([municipioId, servidorId])
  @@index([municipioId, folhaId])

// ─── Item da Folha (rubrica por contracheque) ─────────────────────────────────

model ItemFolha {
  id             String   @id @default(cuid())
  municipioId    String
  contrachequeId String
  rubricaId      String

  valor     Decimal @db.Decimal(10,2)
  referencia String?   // ex: "30 dias", "40h", "15%"

  contracheque Contracheque @relation(fields: [contrachequeId], references: [id])
  rubrica      Rubrica      @relation(fields: [rubricaId], references: [id])

  @@index([municipioId, contrachequeId])

// ─── schema-saude.prisma ───
// ─── ERP Municipal — Módulo SAÚDE MUNICIPAL ───────────────────────────────────
// Lei 8.080/1990 — Lei Orgânica da Saúde (SUS)
// Lei 8.142/1990 — Controle Social (Conselho Municipal de Saúde)
// EC 29/2000 — vinculação de receitas para saúde (mín. 15% da receita líquida)
// LC 141/2012 — regulamenta EC 29 (definição de ações e serviços de saúde)
// Lei 11.350/2006 — ACS e ACE (Agente Comunitário de Saúde)
// Lei 10.507/2002 — criação do ACS
// Portaria GM/MS 2.436/2017 — Política Nacional de Atenção Básica (PNAB)
// Portaria GM/MS 3.992/2017 — financiamento das ações em saúde
// Resolução CFM 2.217/2018 — Código de Ética Médica
// LGPD (Lei 13.709/2018) Art. 11 — dados sensíveis de saúde: tratamento restrito
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoUnidadeSaude {
  UBS            // Unidade Básica de Saúde
  UBSF           // UBS com Estratégia Saúde da Família
  UPA_24H        // Unidade de Pronto Atendimento
  CAPS           // Centro de Atenção Psicossocial
  CRAS           // referência assistência social
  FARMACIA       // Farmácia Municipal
  LABORATORIO
  CENTRO_ESPECIALIDADES
  HOSPITAL_MUNICIPAL

enum TipoProfissional {
  MEDICO
  ENFERMEIRO
  TECNICO_ENFERMAGEM
  DENTISTA
  FARMACEUTICO
  PSICOLOGO
  FISIOTERAPEUTA
  NUTRICIONISTA
  ASSISTENTE_SOCIAL
  ACS            // Agente Comunitário de Saúde
  ACE            // Agente de Combate às Endemias
  ADMINISTRATIVO

enum SituacaoAgendamento {
  AGENDADO
  CONFIRMADO
  ATENDIDO
  FALTOU
  CANCELADO
  REMARCADO

enum TipoAtendimento {
  CONSULTA_MEDICA
  CONSULTA_ENFERMAGEM
  CONSULTA_ODONTOLOGICA
  PROCEDIMENTO
  VACINACAO
  CURATIVOS
  VISITA_DOMICILIAR
  PRE_NATAL
  PUERICULTURA
  HIPERTENSAO_DIABETES   // HiperDia
  SAUDE_MENTAL
  URGENCIA_EMERGENCIA

enum SituacaoAtendimento {
  EM_ESPERA
  EM_ATENDIMENTO
  CONCLUIDO
  TRANSFERIDO
  OBITO

enum TipoOcorrenciaEpid {
  DENGUE
  CHIKUNGUNYA
  ZIKA
  FEBRE_AMARELA
  LEPTOSPIROSE
  TUBERCULOSE
  HANSENIASE
  COVID_19
  INFLUENZA
  DOENCA_EXANTEMATICA
  OUTROS

// ─── Unidade de Saúde ────────────────────────────────────────────────────────

model UnidadeSaude {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  tipo        TipoUnidadeSaude
  cnes        String?   // Cadastro Nacional de Estabelecimentos de Saúde
  cep         String?
  logradouro  String?
  bairro      String?
  telefone    String?
  email       String?
  responsavel String?
  ativo       Boolean  @default(true)

  // Configuração de agendamento
  horaAberturaLun String? // "07:30"
  horaFechamentoLun String? // "17:00"
  vagas           Int?    // vagas por dia

  profissionais   ProfissionalSaude[]
  agendamentos    Agendamento[]
  atendimentos    Atendimento[]
  equipes         EquipeESF[]

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, tipo])

// ─── Profissional de Saúde ───────────────────────────────────────────────────

model ProfissionalSaude {
  id          String   @id @default(cuid())
  unidadeId   String
  municipioId String

  nome        String
  tipo        TipoProfissional
  registro    String?   // CRM/COREN/CRO
  cpf         String?
  especialidade String?
  cbo         String?   // Classificação Brasileira de Ocupações
  ativo       Boolean  @default(true)

  unidade     UnidadeSaude @relation(fields: [unidadeId], references: [id])
  agendamentos Agendamento[]
  atendimentos Atendimento[]

  criadoEm    DateTime @default(now())

  @@index([unidadeId])
  @@index([municipioId])

// ─── Paciente (Cidadão) ──────────────────────────────────────────────────────
// LGPD Art. 11 — dados de saúde são dados sensíveis; acesso restrito

model Paciente {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  cpf         String?  @unique
  cns         String?  // Cartão Nacional de Saúde
  dataNascimento DateTime?
  sexo        String?  // M/F/I
  raca        String?  // branca/preta/parda/amarela/indígena (IBGE)
  nomeMae     String?
  telefone    String?
  logradouro  String?
  bairro      String?
  microarea   String?  // para ESF/ACS
  ativo       Boolean  @default(true)

  agendamentos Agendamento[]
  atendimentos Atendimento[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, bairro])

// ─── Agendamento ─────────────────────────────────────────────────────────────

model Agendamento {
  id          String   @id @default(cuid())
  municipioId String

  unidadeId   String
  profissionalId String?
  pacienteId  String

  tipoAtendimento TipoAtendimento
  dataAgendamento DateTime
  horaAgendamento String    // "08:30"
  situacao    SituacaoAgendamento @default(AGENDADO)

  observacao  String?
  motivoCancelamento String?
  criadoPor   String?

  unidade     UnidadeSaude @relation(fields: [unidadeId], references: [id])
  profissional ProfissionalSaude? @relation(fields: [profissionalId], references: [id])
  paciente    Paciente @relation(fields: [pacienteId], references: [id])
  atendimento Atendimento?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, dataAgendamento])
  @@index([unidadeId])
  @@index([pacienteId])
  @@index([profissionalId])

// ─── Atendimento ─────────────────────────────────────────────────────────────
// Prontuário eletrônico simplificado
// LGPD — acesso somente por profissionais autorizados

model Atendimento {
  id          String   @id @default(cuid())
  agendamentoId String? @unique
  municipioId String

  unidadeId   String
  profissionalId String?
  pacienteId  String

  tipo        TipoAtendimento
  situacao    SituacaoAtendimento @default(EM_ESPERA)
  dataAtendimento DateTime @default(now())

  // Anamnese / SOAP
  queixaPrincipal String? @db.Text
  historicoDoenca String? @db.Text
  exameFisico     String? @db.Text
  hipoteseDiagnostica String?
  cid10           String?    // CID-10
  conduta         String? @db.Text
  prescricao      String? @db.Text

  // Sinais vitais (opcional)
  pressaoArterial String?   // "120/80"
  temperatura     Decimal?  @db.Decimal(4,1)
  peso            Decimal?  @db.Decimal(5,2)
  altura          Decimal?  @db.Decimal(4,1)
  glicemia        Int?      // mg/dL

  encaminhamento  String?   // referência para especialidade
  retorno         DateTime?

  unidade     UnidadeSaude @relation(fields: [unidadeId], references: [id])
  profissional ProfissionalSaude? @relation(fields: [profissionalId], references: [id])
  paciente    Paciente @relation(fields: [pacienteId], references: [id])
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, dataAtendimento])
  @@index([pacienteId])
  @@index([unidadeId])
  @@index([profissionalId])
  @@index([cid10])

// ─── Equipe ESF ──────────────────────────────────────────────────────────────
// Portaria GM/MS 2.436/2017 — Estratégia Saúde da Família
// Composição mínima: médico + enfermeiro + tec. enfermagem + 4-6 ACS

model EquipeESF {
  id          String   @id @default(cuid())
  unidadeId   String
  municipioId String

  ine         String?   // Identificador Nacional de Equipe (CNES)
  nome        String
  area        String?   // área de abrangência
  microareas  String?   // lista de microáreas (JSON)
  populacaoTotal Int?
  familiasTotal  Int?
  ativo       Boolean  @default(true)

  unidade     UnidadeSaude @relation(fields: [unidadeId], references: [id])
  membros     MembroEquipeESF[]
  visitasACS  VisitaACS[]

  criadoEm    DateTime @default(now())

  @@index([unidadeId])
  @@index([municipioId])

model MembroEquipeESF {
  id          String   @id @default(cuid())
  equipeId    String
  nome        String
  tipo        TipoProfissional
  registro    String?
  microarea   String?   // para ACS: microárea de responsabilidade
  ativo       Boolean  @default(true)

  equipe      EquipeESF @relation(fields: [equipeId], references: [id])

  @@index([equipeId])

// ─── Visita ACS ──────────────────────────────────────────────────────────────
// Portaria PNAB — meta: visitar 100% das famílias mensalmente

model VisitaACS {
  id          String   @id @default(cuid())
  equipeId    String
  municipioId String

  acsNome     String
  microarea   String
  mes         String    // "2026-10"
  familiasCadastradas Int
  familiasVisitadas   Int
  gestantesAcomp      Int  @default(0)
  criancasAcomp       Int  @default(0)
  idososAcomp         Int  @default(0)
  hipertensosAcomp    Int  @default(0)
  diabeticosAcomp     Int  @default(0)

  equipe      EquipeESF @relation(fields: [equipeId], references: [id])
  criadoEm    DateTime  @default(now())

  @@unique([equipeId, acsNome, mes])
  @@index([municipioId, mes])

// ─── Vigilância Epidemiológica ───────────────────────────────────────────────
// Lei 6.259/1975 — organização das ações de vigilância epidemiológica
// Portaria GM/MS 204/2016 — Lista Nacional de Notificação Compulsória

model OcorrenciaEpidemiologica {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoOcorrenciaEpid
  semanaEpidemiologica Int
  ano         Int
  casos       Int
  obitos      Int  @default(0)
  bairro      String?
  confirmados Int  @default(0)
  suspeitos   Int  @default(0)
  descartados Int  @default(0)
  observacao  String? @db.Text

  criadoEm    DateTime @default(now())

  @@index([municipioId, ano])
  @@index([municipioId, tipo])

// ─── Vacinação ───────────────────────────────────────────────────────────────
// Calendário Nacional de Vacinação (PNI — Programa Nacional de Imunizações)

model RegistroVacinacao {
  id          String   @id @default(cuid())
  municipioId String
  unidadeId   String?

  vacina      String    // ex: "Poliomielite", "Hepatite B"
  mes         String    // "2026-10"
  dosesTipo   String    // "D1", "D2", "D3", "DR", "DU"
  meta        Int
  aplicadas   Int
  pctCobertura Decimal? @db.Decimal(5,2) // aplicadas/meta*100

  criadoEm    DateTime @default(now())

  @@unique([municipioId, vacina, mes, dosesTipo])
  @@index([municipioId, mes])

// ─── schema-seagri.prisma ───
// ─── SEAGRI — Secretaria de Agricultura e Meio Ambiente ──────────────────────

enum TipoPropriedade {
  RURAL
  CHACARA
  SITIO
  FAZENDA
  ASSENTAMENTO
  QUILOMBOLA
  OUTROS

enum SituacaoProdutor {
  ATIVO
  INATIVO
  FALECIDO
  TRANSFERIDO

enum TipoAtividade {
  AGRICULTURA
  PECUARIA
  PISCICULTURA
  APICULTURA
  EXTRATIVISMO
  AGROINDUSTRIA
  OUTROS

enum StatusPrograma {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  SUSPENSO

enum TipoPrograma {
  ASSISTENCIA_TECNICA
  CREDITO_RURAL
  DISTRIBUICAO_INSUMOS
  CAPACITACAO
  CERTIFICACAO
  REGULARIZACAO_AMBIENTAL
  OUTROS

enum StatusInscricao {
  AGUARDANDO
  APROVADA
  EM_ATENDIMENTO
  CONCLUIDA
  CANCELADA
  LISTA_ESPERA

enum TipoLicenca {
  LICENCA_PREVIA
  LICENCA_INSTALACAO
  LICENCA_OPERACAO
  DECLARACAO_DISPENSA
  OUTORGA_AGUA
  CAR         // Cadastro Ambiental Rural
  OUTROS

enum StatusLicenca {
  SOLICITADA
  EM_ANALISE
  APROVADA
  INDEFERIDA
  VENCIDA
  RENOVACAO_PENDENTE

// ─── Produtor Rural ───────────────────────────────────────────────────────────

model ProdutorRural {
  id              String           @id @default(cuid())
  municipioId     String
  codigo          String           // "PR-2026-001"
  nome            String
  cpfCnpj         String
  dataNascimento  DateTime?
  sexo            String?          // M / F / O
  telefone        String?
  email           String?
  endereco        String?
  bairro          String?
  situacao        SituacaoProdutor @default(ATIVO)
  dap             String?          // DAP/CAF — Declaração de Aptidão ao Pronaf
  dapVencimento   DateTime?
  car             String?          // número do CAR
  pronafCategoria String?          // A, B, C, D, E, V
  observacoes     String?
  ativo           Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  propriedades    PropriedadeRural[]
  inscricoes      InscricaoPrograma[]
  licencas        LicencaAmbiental[]

  @@unique([municipioId, cpfCnpj])
  @@unique([municipioId, codigo])
  @@index([municipioId, situacao])

// ─── Propriedade Rural ────────────────────────────────────────────────────────

model PropriedadeRural {
  id              String           @id @default(cuid())
  municipioId     String
  produtorId      String
  nome            String
  tipo            TipoPropriedade  @default(RURAL)
  areaTotal       Float            // hectares
  areaAgricultavel Float?
  areaPreservacao Float?
  nirf            String?          // número do NIRF / ITR
  car             String?          // CAR da propriedade
  logradouro      String?
  comunidade      String?
  coordLat        Float?
  coordLng        Float?
  atividades      TipoAtividade[]  // JSON no banco
  principaisCulturas String?       // texto livre
  sistemaIrrigacao   Boolean       @default(false)
  aguaDisponivel     String?       // poço, rio, barragem etc.
  observacoes     String?
  ativo           Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  produtor        ProdutorRural    @relation(fields: [produtorId], references: [id])
  producoes       ProducaoAgricola[]

  @@index([produtorId])
  @@index([municipioId])

// ─── Produção Agrícola ────────────────────────────────────────────────────────

model ProducaoAgricola {
  id             String          @id @default(cuid())
  municipioId    String
  propriedadeId  String
  safra          String          // "2026/1" ou "2026"
  cultura        String          // milho, feijão, etc.
  areaPlantada   Float           // ha
  producaoKg     Float?          // kg colhidos
  produtividadeKg Float?         // kg/ha calculado
  valorVendaTotal Decimal?       @db.Decimal(15,2)
  destinoProducao String?        // consumo próprio, PNAE, mercado, etc.
  observacoes    String?
  createdAt      DateTime        @default(now())

  propriedade    PropriedadeRural @relation(fields: [propriedadeId], references: [id])

  @@index([propriedadeId])
  @@index([municipioId, safra])

// ─── Programa / Serviço Agrícola ──────────────────────────────────────────────

model ProgramaAgricola {
  id              String          @id @default(cuid())
  municipioId     String
  codigo          String          // "PG-2026-001"
  nome            String
  tipo            TipoPrograma
  status          StatusPrograma  @default(ABERTO)
  descricao       String?
  publicoAlvo     String?         // ex: "pequenos produtores com área < 4 módulos"
  vagas           Int?
  dataInicio      DateTime
  dataFim         DateTime?
  responsavelId   String?         // servidor responsável
  orcamento       Decimal?        @db.Decimal(15,2)
  parceiro        String?         // EMBRAPA, EBDA/BAHIATER, SENAR, etc.
  resultados      String?         // texto de resultados ao final
  ativo           Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  inscricoes      InscricaoPrograma[]

  @@unique([municipioId, codigo])
  @@index([municipioId, status])

// ─── Inscrição em Programa ────────────────────────────────────────────────────

model InscricaoPrograma {
  id            String          @id @default(cuid())
  municipioId   String
  programaId    String
  produtorId    String
  status        StatusInscricao @default(AGUARDANDO)
  dataInscricao DateTime        @default(now())
  dataAtendimento DateTime?
  observacoes   String?
  tecnicoId     String?         // técnico responsável pelo atendimento
  resultadoAtendimento String?

  programa      ProgramaAgricola @relation(fields: [programaId], references: [id])
  produtor      ProdutorRural    @relation(fields: [produtorId], references: [id])

  @@unique([programaId, produtorId])
  @@index([produtorId])
  @@index([programaId, status])

// ─── Licença Ambiental ────────────────────────────────────────────────────────

model LicencaAmbiental {
  id             String          @id @default(cuid())
  municipioId    String
  produtorId     String?
  requerente     String          // nome do requerente (pode não ser produtor cadastrado)
  cpfCnpjRequerente String?
  tipo           TipoLicenca
  status         StatusLicenca   @default(SOLICITADA)
  numero         String?         // número da licença emitida
  atividade      String          // atividade sujeita ao licenciamento
  empreendimento String?
  localizacao    String?
  areaHa         Float?
  dataProtocolo  DateTime        @default(now())
  dataEmissao    DateTime?
  dataVencimento DateTime?
  condicoes      String?         // condicionantes
  parecerTecnico String?
  tecnicoId      String?
  observacoes    String?
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  produtor       ProdutorRural?  @relation(fields: [produtorId], references: [id])

  @@index([municipioId, status])
  @@index([municipioId, tipo])
  @@index([produtorId])

