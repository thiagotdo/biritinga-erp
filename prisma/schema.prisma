  descricao       String?
  local           String?
  espacoId        String?
  dataInicio      DateTime
  dataFim         DateTime?
  horario         String?       // "19h às 23h"
  gratuito        Boolean       @default(true)
  valorIngresso   Decimal?      @db.Decimal(10,2)
  capacidade      Int?
  publicoEsperado Int?
  publicoRealizado Int?
  orcamento       Decimal?      @db.Decimal(15,2)
  responsavelId   String?
  parceiros       String?       // JSON array de parceiros
  fotos           String?       // JSON array de URLs
  transmissaoLink String?
  observacoes     String?
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  espaco          EspacoCultural? @relation(fields: [espacoId], references: [id])

  @@unique([municipioId, codigo])
  @@index([municipioId, status])
  @@index([municipioId, dataInicio])

// ─── Espaço Cultural / Esportivo ──────────────────────────────────────────────

model EspacoCultural {
  id              String        @id @default(cuid())
  municipioId     String
  nome            String
  tipo            TipoEspaco
  status          StatusEspaco  @default(DISPONIVEL)
  endereco        String?
  bairro          String?
  capacidade      Int?
  areaM2          Float?
  responsavel     String?
  telefone        String?
  horarioFuncionamento String?  // "seg-sex 8h-17h"
  acessivel       Boolean       @default(false) // acessibilidade
  comodidades     String?       // JSON array: wifi, estacionamento, etc.
  observacoes     String?
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eventos         EventoCultural[]
  reservas        ReservaEspaco[]

  @@index([municipioId, tipo])
  @@index([municipioId, status])

// ─── Reserva de Espaço ────────────────────────────────────────────────────────

model ReservaEspaco {
  id            String    @id @default(cuid())
  municipioId   String
  espacoId      String
  solicitante   String
  finalidade    String
  dataInicio    DateTime
  dataFim       DateTime
  aprovada      Boolean   @default(false)
  responsavelId String?
  observacoes   String?
  createdAt     DateTime  @default(now())

  espaco        EspacoCultural @relation(fields: [espacoId], references: [id])

  @@index([espacoId, dataInicio])

// ─── Atleta ───────────────────────────────────────────────────────────────────

model Atleta {
  id              String              @id @default(cuid())
  municipioId     String
  codigo          String              // "AT-2026-001"
  nome            String
  cpf             String
  dataNascimento  DateTime
  sexo            String              // M / F / O
  telefone        String?
  email           String?
  responsavel     String?             // para menores
  modalidade      ModalidadeEsportiva
  categoria       CategoriaAtleta
  situacao        SituacaoAtleta      @default(ATIVO)
  clube           String?
  tecnicoId       String?
  numeroCbf       String?             // registro federação
  observacoes     String?
  ativo           Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  resultados      ResultadoEsportivo[]

  @@unique([municipioId, cpf])
  @@unique([municipioId, codigo])
  @@index([municipioId, modalidade])
  @@index([municipioId, situacao])

// ─── Resultado Esportivo ──────────────────────────────────────────────────────

model ResultadoEsportivo {
  id            String    @id @default(cuid())
  municipioId   String
  atletaId      String
  competicao    String
  modalidade    ModalidadeEsportiva
  categoria     CategoriaAtleta
  data          DateTime
  local         String?
  colocacao     Int?       // 1º, 2º, 3º ...
  medalha       String?    // OURO / PRATA / BRONZE
  marca         String?    // tempo, distância, pontos
  observacoes   String?
  createdAt     DateTime   @default(now())

  atleta        Atleta    @relation(fields: [atletaId], references: [id])

  @@index([atletaId])
  @@index([municipioId, data])

// ─── Patrimônio / Ponto Turístico ─────────────────────────────────────────────

model PontoTuristico {
  id              String             @id @default(cuid())
  municipioId     String
  nome            String
  tipo            TipoPontoTuristico
  descricao       String?
  historia        String?
  endereco        String?
  bairro          String?
  coordLat        Float?
  coordLng        Float?
  horarioVisita   String?
  valorEntrada    Decimal?           @db.Decimal(10,2)
  capacidadeDiaria Int?
  contato         String?
  site            String?
  fotos           String?            // JSON array URLs
  destaque        Boolean            @default(false)
  ativo           Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([municipioId, tipo])
  @@index([municipioId, destaque])

// ─── schema-sefin.prisma ───
// ─── ERP Municipal Biritinga — Módulo SEFIN (Secretaria de Finanças) ──────────
// Baseado em: Lei 4.320/1964, LRF (LC 101/2000), PCASP, MCASP 10.ª edição

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum NaturezaDespesa {
  PESSOAL_ENCARGOS        // 3.1
  JUROS_ENCARGOS_DIVIDA   // 3.2
  OUTRAS_CORRENTES        // 3.3
  INVESTIMENTOS           // 4.4
  INVERSOES_FINANCEIRAS   // 4.5
  AMORTIZACAO_DIVIDA      // 4.6

enum NaturezaReceita {
  TRIBUTARIA              // 1.1
  CONTRIBUICOES           // 1.2
  PATRIMONIAL             // 1.3
  AGROPECUARIA            // 1.4
  INDUSTRIAL              // 1.5
  SERVICOS                // 1.6
  TRANSFERENCIAS_CORRENTES // 1.7
  OUTRAS_CORRENTES        // 1.9
  OPERACOES_CREDITO       // 2.1
  ALIENACAO_BENS          // 2.2
  TRANSFERENCIAS_CAPITAL  // 2.4
  OUTRAS_CAPITAL          // 2.9

enum ModalidadeEmpenho {
  ORDINARIO               // Art. 60 Lei 4.320 — empenho normal
  ESTIMATIVA              // Valor estimado (serviços continuados)
  GLOBAL                  // Contrato com parcelas mensais

enum SituacaoEmpenho {
  EMITIDO
  LIQUIDADO               // Bem/serviço recebido (Art. 63 Lei 4.320)
  PAGO                    // Pagamento efetuado (Art. 64 Lei 4.320)
  ANULADO                 // Cancelado parcial ou total
  INSCRITO_RP             // Inscrito em Restos a Pagar

enum TipoLiquidacao {
  TOTAL
  PARCIAL

enum TipoPagamento {
  TRANSFERENCIA_BANCARIA
  BOLETO
  CHEQUE
  DINHEIRO
  PIX

enum SituacaoOrcamento {
  ELABORACAO
  APROVADO_PL             // Projeto de Lei encaminhado
  VIGENTE                 // Lei aprovada e em vigor
  ENCERRADO               // Encerrado após exercício

enum TipoSuplemento {
  SUPLEMENTACAO           // Reforço de dotação existente
  ESPECIAL                // Para despesa sem dotação prévia
  EXTRAORDINARIO          // Calamidade/urgência (MP ou decreto)

enum SituacaoReceita {
  PREVISTA
  LANCADA                 // Fato gerador identificado
  ARRECADADA
  CANCELADA

// ═══════════════════════════════════════════════════════════════════════════════
// ORÇAMENTO — Lei Orçamentária Anual (LOA)
// ═══════════════════════════════════════════════════════════════════════════════

model Orcamento {
  id              String            @id @default(cuid())
  municipioId     String
  exercicio       Int               // ano do orçamento
  situacao        SituacaoOrcamento @default(ELABORACAO)
  totalDespesa    Decimal           @db.Decimal(14,2)  // soma de todas as dotações
  totalReceita    Decimal           @db.Decimal(14,2)  // receita orçada
  leiNumero       String?           // "Lei Municipal n.º 123/2026"
  leiData         DateTime?
  decretoAbertura String?
  observacoes     String?           @db.Text
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  dotacoes        Dotacao[]
  suplementos     Suplemento[]
  receitasPrevistas ReceitaPrevista[]

  @@unique([municipioId, exercicio])
  @@index([municipioId])

// ─── Dotação orçamentária ─────────────────────────────────────────────────────

model Dotacao {
  id              String          @id @default(cuid())
  orcamentoId     String
  orcamento       Orcamento       @relation(fields: [orcamentoId], references: [id])
  municipioId     String

  // Classificação orçamentária completa (PCASP)
  unidadeGestora  String          // Ex: "02" (Prefeitura)
  unidadeOrcamentaria String      // Ex: "02.01" (Secretaria)
  funcao          String          // Ex: "04" (Administração)
  subfuncao       String          // Ex: "122" (Administração Geral)
  programa        String          // Ex: "0001"
  acao            String          // Ex: "2001" (Manutenção)
  natureza        NaturezaDespesa
  fonte           String          // Ex: "00" (Recursos Ordinários)

  // Identificação
  codigo          String          // código reduzido / identificador
  descricao       String

  // Valores
  valorOriginal   Decimal         @db.Decimal(14,2)  // valor na LOA
  valorAtual      Decimal         @db.Decimal(14,2)  // após suplementações/reduções
  valorEmpenhado  Decimal         @db.Decimal(14,2) @default(0)
  valorLiquidado  Decimal         @db.Decimal(14,2) @default(0)
  valorPago       Decimal         @db.Decimal(14,2) @default(0)

  secretaria      String?
  ativo           Boolean         @default(true)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  empenhos        Empenho[]
  suplementos     Suplemento[]

  @@unique([orcamentoId, codigo])
  @@index([municipioId, orcamento: { exercicio: true }])
  @@index([municipioId])

// ─── Suplementação / redução orçamentária ────────────────────────────────────

model Suplemento {
  id              String          @id @default(cuid())
  municipioId     String
  orcamentoId     String
  orcamento       Orcamento       @relation(fields: [orcamentoId], references: [id])
  dotacaoId       String
  dotacao         Dotacao         @relation(fields: [dotacaoId], references: [id])
  tipo            TipoSuplemento
  valor           Decimal         @db.Decimal(14,2)  // positivo=suplementação, negativo=redução
  decreto         String?
  dataDecreto     DateTime?
  justificativa   String?         @db.Text
  usuarioId       String?
  criadoEm        DateTime        @default(now())

  @@index([municipioId, orcamentoId])

// ═══════════════════════════════════════════════════════════════════════════════
// EMPENHO — Estágio 1 da despesa (Art. 58 Lei 4.320)
// ═══════════════════════════════════════════════════════════════════════════════

model Empenho {
  id              String            @id @default(cuid())
  municipioId     String
  numero          String            // "EMP-2026-00001"
  dotacaoId       String
  dotacao         Dotacao           @relation(fields: [dotacaoId], references: [id])

  modalidade      ModalidadeEmpenho @default(ORDINARIO)
  situacao        SituacaoEmpenho   @default(EMITIDO)

  // Credor
  credorNome      String
  credorCpfCnpj   String
  credorBanco     String?
  credorAgencia   String?
  credorConta     String?
  credorPix       String?

  // Valores
  valorOriginal   Decimal           @db.Decimal(14,2)
  valorLiquidado  Decimal           @db.Decimal(14,2) @default(0)
  valorPago       Decimal           @db.Decimal(14,2) @default(0)
  valorAnulado    Decimal           @db.Decimal(14,2) @default(0)

  // Referências
  contratoNumero  String?
  licitacaoNumero String?
  processoNumero  String?           // número do processo administrativo
  notaFiscal      String?

  descricao       String            @db.Text
  dataEmissao     DateTime          @default(now())
  dataVencimento  DateTime?
  competencia     String            // "2026-11"

  observacoes     String?           @db.Text
  usuarioId       String?
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  liquidacoes     Liquidacao[]
  pagamentos      Pagamento[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, competencia])
  @@index([municipioId, credorCpfCnpj])

// ─── Liquidação — Estágio 2 (Art. 63 Lei 4.320) ──────────────────────────────

model Liquidacao {
  id              String          @id @default(cuid())
  municipioId     String
  empenhoId       String
  empenho         Empenho         @relation(fields: [empenhoId], references: [id])
  tipo            TipoLiquidacao  @default(TOTAL)
  valor           Decimal         @db.Decimal(14,2)
  notaFiscal      String?
  dataDocumento   DateTime?
  dataLiquidacao  DateTime        @default(now())
  descricao       String?
  usuarioId       String?
  criadoEm        DateTime        @default(now())

  @@index([empenhoId])
  @@index([municipioId])

// ─── Pagamento — Estágio 3 (Art. 64 Lei 4.320) ───────────────────────────────

model Pagamento {
  id              String          @id @default(cuid())
  municipioId     String
  empenhoId       String
  empenho         Empenho         @relation(fields: [empenhoId], references: [id])
  valor           Decimal         @db.Decimal(14,2)
  tipo            TipoPagamento   @default(TRANSFERENCIA_BANCARIA)
  dataPagamento   DateTime        @default(now())
  banco           String?
  agencia         String?
  conta           String?
  autenticacao    String?         // autenticação bancária / ID da transação
  descricao       String?
  usuarioId       String?
  criadoEm        DateTime        @default(now())

  @@index([empenhoId])
  @@index([municipioId, dataPagamento])

// ═══════════════════════════════════════════════════════════════════════════════
// RECEITA
// ═══════════════════════════════════════════════════════════════════════════════

model ReceitaPrevista {
  id              String          @id @default(cuid())
  municipioId     String
  orcamentoId     String
  orcamento       Orcamento       @relation(fields: [orcamentoId], references: [id])
  codigo          String          // código da receita (PCASP)
  descricao       String
  natureza        NaturezaReceita
  fonte           String          @default("00")
  valorPrevisto   Decimal         @db.Decimal(14,2)
  criadoEm        DateTime        @default(now())

  lancamentos     LancamentoReceita[]

  @@unique([orcamentoId, codigo])
  @@index([municipioId])

model LancamentoReceita {
  id              String          @id @default(cuid())
  municipioId     String
  receitaPrevistaId String
  receitaPrevista ReceitaPrevista @relation(fields: [receitaPrevistaId], references: [id])
  situacao        SituacaoReceita @default(ARRECADADA)
  valor           Decimal         @db.Decimal(14,2)
  dataArrecadacao DateTime        @default(now())
  competencia     String          // "2026-11"
  documentoOrigem String?         // DAM, GRU, Nota de Lançamento
  descricao       String?
  usuarioId       String?
  criadoEm        DateTime        @default(now())

  @@index([municipioId, competencia])
  @@index([receitaPrevistaId])

// ─── schema-semad.prisma ───
// ─── ERP Municipal Biritinga — Módulo SEMAD (Secretaria de Administração) ──────
// Baseado em: Lei 14.133/2021 (Nova Lei de Licitações), Lei 8.666/93 (legado),
//             Lei 11.079/2004 (PPP), Lei 10.520/2002 (Pregão)

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — LICITAÇÃO
// ═══════════════════════════════════════════════════════════════════════════════

enum ModalidadeLicitacao {
  CONCORRENCIA          // Art. 29, I Lei 14.133 — obras/serviços > R$3,3M
  CONCURSO              // Art. 29, II — trabalho técnico, científico, artístico
  LEILAO                // Art. 29, III — alienação de bens
  PREGAO_ELETRONICO     // Art. 29, IV — bens/serviços comuns
  PREGAO_PRESENCIAL     // Lei 10.520/2002 (legado)
  DISPENSA_LICITACAO    // Art. 75 Lei 14.133 — valor < R$57.900 (serv.) / R$115.800 (obras)
  INEXIGIBILIDADE       // Art. 74 Lei 14.133 — fornecedor exclusivo / notória especialização
  CHAMAMENTO_PUBLICO    // OS/OSCIP/parcerias
  REGISTRO_PRECOS       // Art. 82 Lei 14.133 — SRP

enum SituacaoLicitacao {
  RASCUNHO
  PUBLICADA             // Aviso publicado no PNCP e DOU
  EM_ANDAMENTO          // Dentro do prazo de propostas
  JULGAMENTO            // Propostas recebidas, em análise
  HOMOLOGADA            // Vencedor homologado
  DESERTA               // Sem propostas
  FRACASSADA            // Propostas inabilitadas ou preços acima do orçamento
  REVOGADA
  ANULADA
  ADJUDICADA            // Objeto adjudicado ao vencedor
  CONTRATADA            // Contrato assinado

enum CriterioJulgamento {
  MENOR_PRECO
  MAIOR_DESCONTO
  MELHOR_TECNICA        // Art. 36 Lei 14.133
  TECNICA_E_PRECO
  MAIOR_LANCE           // Leilão
  CONTEUDO_ARTISTICO    // Concurso

enum TipoObjeto {
  OBRAS
  SERVICOS_ENGENHARIA
  SERVICOS_COMUNS
  COMPRAS
  LOCACAO_IMOVEIS
  CONCESSAO
  ALIENACAO

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — CONTRATO
// ═══════════════════════════════════════════════════════════════════════════════

enum SituacaoContrato {
  MINUTA               // Elaborando
  ASSINADO             // Vigente
  EM_EXECUCAO          // Fiscalização ativa
  SUSPENSO
  RESCINDIDO           // Art. 137 Lei 14.133
  CONCLUIDO
  EXPIRADO             // Venceu sem renovação

enum TipoAditivo {
  PRAZO                // Prorrogação de vigência
  VALOR                // Acréscimo/decréscimo financeiro
  PRAZO_E_VALOR
  OBJETO               // Alteração qualitativa
  SUBCONTRATACAO
  CESSAO

enum TipoGarantia {
  CAUCAO_DINHEIRO
  TITULO_CREDITO
  SEGURO_GARANTIA
  FIANCA_BANCARIA

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — PATRIMÔNIO
// ═══════════════════════════════════════════════════════════════════════════════

enum SituacaoBem {
  ATIVO               // Em uso normal
  EM_MANUTENCAO
  CEDIDO              // Cessão de uso a outro órgão
  BAIXADO             // Desincorporado (venda, doação, sucata)
  PERDIDO_FURTADO
  INVENTARIO_PENDENTE

enum TipoBaixaBem {
  ALIENACAO_VENDA
  ALIENACAO_DOACAO
  PERMUTA
  SINISTRO
  SUCATA             // Inservível
  EXTRAVIO

enum ClassificacaoBem {
  // MCASP — Ativo Imobilizado
  BENS_MOVEIS_INFORMATICA
  BENS_MOVEIS_MOVEIS_UTENSILIOS
  BENS_MOVEIS_MAQUINAS_EQUIPAMENTOS
  BENS_MOVEIS_VEICULOS
  BENS_IMOVEIS_TERRENOS
  BENS_IMOVEIS_PREDIOS
  BENS_IMOVEIS_OBRAS_ANDAMENTO
  BENS_INTANGIVEIS_SOFTWARE
  BENS_INTANGIVEIS_OUTROS

// ═══════════════════════════════════════════════════════════════════════════════
// LICITAÇÃO
// ═══════════════════════════════════════════════════════════════════════════════

model Licitacao {
  id               String               @id @default(cuid())
  municipioId      String
  numero           String               // "LIC-2026-001"
  modalidade       ModalidadeLicitacao
  criterio         CriterioJulgamento   @default(MENOR_PRECO)
  tipoObjeto       TipoObjeto
  situacao         SituacaoLicitacao    @default(RASCUNHO)

  // Objeto e valores
  objeto           String               @db.Text
  valorEstimado    Decimal?             @db.Decimal(14,2)
  valorHomologado  Decimal?             @db.Decimal(14,2)

  // Prazos legais
  dataPublicacao   DateTime?            // aviso publicado
  dataAbertura     DateTime?            // sessão pública
  dataHomologacao  DateTime?
  dataAdjudicacao  DateTime?

  // Referências legais
  empenhoId        String?              // dotação orçamentária vinculada
  processoNumero   String?              // processo administrativo
  pncpNumero       String?              // número no PNCP (Portal Nacional)
  fundamentoLegal  String?              // "Art. 75, II Lei 14.133/2021"

  // Comissão
  pregoeiro        String?
  equipeApoio      String?              @db.Text

  observacoes      String?              @db.Text
  usuarioId        String?
  criadoEm         DateTime             @default(now())
  atualizadoEm     DateTime             @updatedAt

  lotes            LoteLicitacao[]
  participantes    ParticipanteLicitacao[]
  contratos        Contrato[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, modalidade])

// ─── Lote / Item da licitação ─────────────────────────────────────────────────

model LoteLicitacao {
  id              String      @id @default(cuid())
  licitacaoId     String
  licitacao       Licitacao   @relation(fields: [licitacaoId], references: [id])
  numero          Int         // 1, 2, 3…
  descricao       String
  unidade         String      // UN, M², H, KG…
  quantidade      Decimal     @db.Decimal(12,4)
  valorUnitario   Decimal?    @db.Decimal(14,4)  // referência orçamentária
  valorTotal      Decimal?    @db.Decimal(14,2)
  vencedorId      String?     // ParticipanteLicitacao.id
  valorVencedor   Decimal?    @db.Decimal(14,2)
  criadoEm        DateTime    @default(now())

  @@index([licitacaoId])

// ─── Participantes / Propostas ────────────────────────────────────────────────

model ParticipanteLicitacao {
  id              String      @id @default(cuid())
  licitacaoId     String
  licitacao       Licitacao   @relation(fields: [licitacaoId], references: [id])
  nomeEmpresa     String
  cnpj            String
  representante   String?
  email           String?
  telefone        String?
  habilitado      Boolean     @default(true)
  motivoInabilitacao String?
  valorProposta   Decimal?    @db.Decimal(14,2)
  classificacao   Int?        // 1º, 2º, 3º…
  criadoEm        DateTime    @default(now())

  @@unique([licitacaoId, cnpj])
  @@index([licitacaoId])

// ═══════════════════════════════════════════════════════════════════════════════
// CONTRATO
// ═══════════════════════════════════════════════════════════════════════════════

model Contrato {
  id               String          @id @default(cuid())
  municipioId      String
  numero           String          // "CONT-2026-001"
  licitacaoId      String?
  licitacao        Licitacao?      @relation(fields: [licitacaoId], references: [id])
  situacao         SituacaoContrato @default(MINUTA)

  // Partes
  contratadoNome   String
  contratadoCnpj   String
  contratadoEmail  String?
  contratadoTelefone String?

  // Objeto e valores
  objeto           String          @db.Text
  valorInicial     Decimal         @db.Decimal(14,2)
  valorAtual       Decimal         @db.Decimal(14,2)  // após aditivos
  percentualAcrescimo Decimal      @db.Decimal(5,2) @default(0)  // % acumulado

  // Vigência
  dataAssinatura   DateTime?
  dataVigenciaInicio DateTime?
  dataVigenciaFim  DateTime?
  dataReajuste     DateTime?       // próximo reajuste contratual

  // Fiscalização (Art. 117 Lei 14.133)
  fiscalId         String?         // usuário gestor/fiscal do contrato
  fiscalNome       String?
  fiscalMatricula  String?

  // Garantia contratual (Art. 96 Lei 14.133 — até 5% do valor)
  garantiaTipo     TipoGarantia?
  garantiaValor    Decimal?        @db.Decimal(14,2)
  garantiaVencimento DateTime?

  processoNumero   String?
  empenhoId        String?
  fundamentoLegal  String?
  observacoes      String?         @db.Text
  usuarioId        String?
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt

  aditivos         AditivoContrato[]
  medicoes         MedicaoContrato[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, dataVigenciaFim])

// ─── Aditivo contratual ───────────────────────────────────────────────────────

model AditivoContrato {
  id              String          @id @default(cuid())
  municipioId     String
  contratoId      String
  contrato        Contrato        @relation(fields: [contratoId], references: [id])
  numero          String          // "1º Aditivo"
  tipo            TipoAditivo
  dataAssinatura  DateTime
  motivoJustificativa String      @db.Text

  // Prorrogação
  novaDataFim     DateTime?       // se tipo inclui PRAZO

  // Acréscimo financeiro (limite: 25% obras/serv, 50% compras — Art. 125 Lei 14.133)
  valorAcrescimo  Decimal?        @db.Decimal(14,2)  // positivo ou negativo
  percentualSobreOriginal Decimal? @db.Decimal(5,2)

  usuarioId       String?
  criadoEm        DateTime        @default(now())

  @@index([contratoId])

// ─── Medições / atestes ───────────────────────────────────────────────────────

model MedicaoContrato {
  id              String      @id @default(cuid())
  municipioId     String
  contratoId      String
  contrato        Contrato    @relation(fields: [contratoId], references: [id])
  numero          Int         // 1, 2, 3…
  periodo         String      // "2026-11"
  descricao       String      @db.Text
  valorMedicao    Decimal     @db.Decimal(14,2)
  dataAteste      DateTime?   // assinatura do fiscal
  dataEnvioFinanceiro DateTime?
  empenhoId       String?     // empenho SEFIN vinculado
  atestado        Boolean     @default(false)
  observacoes     String?
  usuarioId       String?
  criadoEm        DateTime    @default(now())

  @@unique([contratoId, numero])
  @@index([municipioId, contratoId])

// ═══════════════════════════════════════════════════════════════════════════════
// PATRIMÔNIO
// ═══════════════════════════════════════════════════════════════════════════════

model BemPatrimonial {
  id               String             @id @default(cuid())
  municipioId      String
  tombamento       String             // "PATRIM-00001"
  classificacao    ClassificacaoBem
  situacao         SituacaoBem        @default(ATIVO)

  // Descrição
  descricao        String
  marca            String?
  modelo           String?
  serie            String?
  cor              String?
  especificacoes   String?            @db.Text

  // Localização
  secretaria       String?
  setor            String?
  responsavel      String?            // nome do servidor responsável
  responsavelId    String?            // usuário/servidor RH

  // Aquisição
  dataAquisicao    DateTime?
  fornecedorNome   String?
  fornecedorCnpj   String?
  notaFiscal       String?
  processoNumero   String?
  contratoId       String?            // contrato de compra
  empenhoId        String?

  // Valores
  valorAquisicao   Decimal?           @db.Decimal(14,2)
  valorAtual       Decimal?           @db.Decimal(14,2)  // após depreciação
  taxaDepreciacao  Decimal?           @db.Decimal(5,4)   // % ao ano (MCASP)
  dataUltimaDepreciacao DateTime?

  // Garantia / vida útil
  garantiaVencimento DateTime?
  vidaUtilAnos     Int?

  // Manutenções
  ultimaManutencao DateTime?
  proximaManutencao DateTime?

  observacoes      String?            @db.Text
  ativo            Boolean            @default(true)
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt

  movimentacoes    MovimentacaoBem[]
  manutencoes      ManutencaoBem[]

  @@unique([municipioId, tombamento])
  @@index([municipioId, situacao])
  @@index([municipioId, classificacao])
  @@index([municipioId, secretaria])

// ─── Movimentação patrimonial ─────────────────────────────────────────────────

model MovimentacaoBem {
  id              String       @id @default(cuid())
  municipioId     String
  bemId           String
  bem             BemPatrimonial @relation(fields: [bemId], references: [id])
  tipo            String       // TRANSFERENCIA, CESSAO, DEVOLUCAO, BAIXA, INVENTARIO
  origemSetor     String?
  destinoSetor    String?
  origemResponsavel String?
  destinoResponsavel String?
  dataMovimentacao DateTime    @default(now())
  motivoBaixa     TipoBaixaBem?
  valorBaixa      Decimal?     @db.Decimal(14,2)
  justificativa   String?      @db.Text
  documentoAutorizacao String?
  usuarioId       String?
  criadoEm        DateTime     @default(now())

  @@index([bemId])
  @@index([municipioId])

// ─── Manutenção ───────────────────────────────────────────────────────────────

model ManutencaoBem {
  id              String       @id @default(cuid())
  municipioId     String
  bemId           String
  bem             BemPatrimonial @relation(fields: [bemId], references: [id])
  tipo            String       // PREVENTIVA, CORRETIVA, GARANTIA
  descricao       String       @db.Text
  fornecedorNome  String?
  valorManutencao Decimal?     @db.Decimal(14,2)
  dataInicio      DateTime
  dataConclusao   DateTime?
  empenhoId       String?
  concluida       Boolean      @default(false)
  usuarioId       String?
  criadoEm        DateTime     @default(now())

  @@index([bemId])
  @@index([municipioId])

// ─── schema-semas.prisma ───
// ============================================================
// MÓDULO SEMAS — Secretaria de Assistência Social
// Adicionar ao schema principal do ERP Municipal
// ============================================================

// ── Enums ───────────────────────────────────────────────────

enum SituacaoFamilia {
  ATIVA
  INATIVA
  TRANSFERIDA
  DESLIGADA

enum NivelVulnerabilidade {
  BAIXO
  MEDIO
  ALTO
  MUITO_ALTO

enum TipoMoradia {
  PROPRIA
  ALUGADA
  CEDIDA
  OCUPACAO
  SEM_MORADIA

enum CondicaoMoradia {
  BOA
  REGULAR
  PRECARIA
  INSALUBRE

enum RelacaoFamiliar {
  RESPONSAVEL
  CONJUGE
  FILHO
  FILHA
  PAI
  MAE
  IRMAO
  IRMA
  AVO
  NETO
  OUTRO

enum SituacaoMembro {
  ATIVO
  FALECIDO
  AUSENTE

enum TipoAtendimento {
  RECEPCAO_TRIAGEM
  ATENDIMENTO_TECNICO
  ACOMPANHAMENTO_FAMILIAR
  VISITA_DOMICILIAR
  PLANTAO_SOCIAL
  GRUPO_FAMILIAR
  OFICINA
  REUNIAO

enum StatusAtendimento {
  ABERTO
  EM_ANDAMENTO
  ENCERRADO
  SUSPENSO

enum TipoBeneficio {
  BPC_LOAS
  BOLSA_FAMILIA
  AUXILIO_BRASIL
  CESTA_BASICA
  PASSAGEM
  BENEFICIO_EVENTUAL
  MATERIAL_CONSTRUCAO
  OUTROS

enum StatusBeneficio {
  SOLICITADO
  EM_ANALISE
  APROVADO
  NEGADO
  CANCELADO
  SUSPENSO

enum TipoEncaminhamento {
  SAUDE
  EDUCACAO
  TRABALHO_RENDA
  HABITACAO
  JURIDICO
  CRAS
  CREAS
  MINISTERIO_PUBLICO
  CONSELHO_TUTELAR
  OUTROS

enum StatusEncaminhamento {
  AGUARDANDO
  REALIZADO
  SEM_RETORNO
  CANCELADO

enum TipoVisita {
  DIAGNOSTICO
  ACOMPANHAMENTO
  VERIFICACAO
  EMERGENCIA

enum ResultadoVisita {
  POSITIVO
  NEGATIVO
  PARCIAL
  FAMILIA_AUSENTE

// ── Models ──────────────────────────────────────────────────

model Familia {
  id               String              @id @default(cuid())
  municipioId      String
  codigo           String              // Código interno (ex: FAM-2026-00123)
  nomeReferencia   String              // Nome do responsável familiar
  cpfReferencia    String
  nis              String?             // NIS — Número de Identificação Social (NIS Família)
  prontuarioNum    String?             // Número do prontuário CRAS/CREAS
  unidadeId        String?             // CRAS/CREAS de referência
  tecnicoId        String?             // Técnico social responsável
  situacao         SituacaoFamilia     @default(ATIVA)
  vulnerabilidade  NivelVulnerabilidade @default(MEDIO)

  // Endereço
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  referencia       String?
  tipoMoradia      TipoMoradia?
  condicaoMoradia  CondicaoMoradia?
  temAguaEncanada  Boolean?
  temEsgoto        Boolean?
  temEnergiaEletrica Boolean?
  temColetaLixo    Boolean?

  // Renda
  rendaFamiliarTotal Float?
  rendaPerCapita   Float?
  qtdPessoasRenda  Int?

  // ESF / território
  microarea        String?
  agenteSaudeId    String?

  // Flags especiais
  familiaRural     Boolean @default(false)
  quilombola       Boolean @default(false)
  indigena         Boolean @default(false)
  cigana           Boolean @default(false)

  // Situações de risco
  violenciaDomestica   Boolean @default(false)
  exploracaoInfantil   Boolean @default(false)
  trabalhoInfantil     Boolean @default(false)
  usoDrogas            Boolean @default(false)
  semMoradia           Boolean @default(false)
  migranteRefugiado    Boolean @default(false)

  observacoes      String?             @db.Text
  ativo            Boolean             @default(true)
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  membros          MembroFamilia[]
  atendimentos     AtendimentoSocial[]
  beneficios       BeneficioSocial[]
  visitas          VisitaDomiciliar[]
  encaminhamentos  EncaminhamentoSocial[]
  evolucoes        EvolucaoFamiliar[]
  unidade          UnidadeSemas?       @relation(fields: [unidadeId], references: [id])

  @@unique([municipioId, codigo])
  @@index([municipioId, situacao])
  @@index([municipioId, vulnerabilidade])
  @@index([municipioId, cpfReferencia])

model MembroFamilia {
  id               String           @id @default(cuid())
  familiaId        String
  nome             String
  cpf              String?
  nis              String?
  dataNascimento   DateTime?
  sexo             String?          // M / F
  relacao          RelacaoFamiliar  @default(OUTRO)
  situacao         SituacaoMembro   @default(ATIVO)

  // Situações
  deficiencia      Boolean @default(false)
  tipoDeficiencia  String?
  gestante         Boolean @default(false)
  idoso            Boolean @default(false)
  crianca          Boolean @default(false)
  adolescente      Boolean @default(false)

  // Educação / Trabalho
  escolaridade     String?
  frequentaEscola  Boolean?
  series           String?
  trabalhando      Boolean?
  profissao        String?
  rendaMensal      Float?

  // Saúde
  possuiCNS        String?
  condicaoSaude    String?

  familia          Familia          @relation(fields: [familiaId], references: [id])

  @@index([familiaId])
  @@index([cpf])

model UnidadeSemas {
  id        String   @id @default(cuid())
  nome      String
  tipo      String   // CRAS, CREAS, CENTRO_DIA, ABRIGO, etc.
  endereco  String?
  familias  Familia[]

model AtendimentoSocial {
  id               String            @id @default(cuid())
  municipioId      String
  familiaId        String
  tecnicoId        String
  dataAtendimento  DateTime          @default(now())
  tipo             TipoAtendimento
  status           StatusAtendimento @default(ABERTO)

  // Conteúdo
  demanda          String            @db.Text
  intervencao      String?           @db.Text
  resultadoParcial String?           @db.Text
  conclusao        String?           @db.Text
  planoAcao        String?           @db.Text

  // Flags
  situacaoRisco    Boolean           @default(false)
  acaoImediata     Boolean           @default(false)
  requerVisita     Boolean           @default(false)

  proximoAtend     DateTime?
  encerradoEm      DateTime?

  familia          Familia           @relation(fields: [familiaId], references: [id])
  encaminhamentos  EncaminhamentoSocial[]

  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  @@index([municipioId, familiaId])
  @@index([municipioId, dataAtendimento])
  @@index([municipioId, tecnicoId])

model BeneficioSocial {
  id               String          @id @default(cuid())
  municipioId      String
  familiaId        String
  membroId         String?         // Beneficiário específico (pode ser a família toda)
  tipo             TipoBeneficio
  status           StatusBeneficio @default(SOLICITADO)

  dataRequerimento DateTime        @default(now())
  dataAnalise      DateTime?
  dataConcessao    DateTime?
  dataVencimento   DateTime?
  dataCancelamento DateTime?

  valor            Float?
  quantidade       Int?            // Para cestas, passagens, etc.
  descricao        String?
  motivoNegativa   String?
  tecnicoId        String?
  aprovadoPor      String?

  observacoes      String?         @db.Text

  familia          Familia         @relation(fields: [familiaId], references: [id])

  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt

  @@index([municipioId, familiaId])
  @@index([municipioId, tipo, status])

model VisitaDomiciliar {
  id               String          @id @default(cuid())
  municipioId      String
  familiaId        String
  tecnicoId        String
  dataVisita       DateTime
  tipo             TipoVisita      @default(ACOMPANHAMENTO)
  resultado        ResultadoVisita?

  // Relatório
  objetivo         String?         @db.Text
  observacoes      String?         @db.Text
  condicoesMoradia String?         @db.Text
  situacaoFamilia  String?         @db.Text
  acoesTomadas     String?         @db.Text
  proximosPassos   String?         @db.Text

  requerRetorno    Boolean         @default(false)
  dataRetorno      DateTime?

  familia          Familia         @relation(fields: [familiaId], references: [id])

  criadoEm         DateTime        @default(now())

  @@index([municipioId, familiaId])
  @@index([municipioId, dataVisita])

model EncaminhamentoSocial {
  id               String               @id @default(cuid())
  municipioId      String
  familiaId        String
  atendimentoId    String?
  tipo             TipoEncaminhamento
  status           StatusEncaminhamento @default(AGUARDANDO)
  destino          String               // Serviço / instituição destino
  responsavel      String?
  dataSolicitacao  DateTime             @default(now())
  dataRealizacao   DateTime?
  observacoes      String?              @db.Text
  retorno          String?              @db.Text

  familia          Familia              @relation(fields: [familiaId], references: [id])
  atendimento      AtendimentoSocial?   @relation(fields: [atendimentoId], references: [id])

  @@index([municipioId, familiaId])
  @@index([municipioId, status])

model EvolucaoFamiliar {
  id          String   @id @default(cuid())
  familiaId   String
  tecnicoId   String
  dataRegistro DateTime @default(now())
  registro    String   @db.Text  // Nota de evolução / histórico
  tipo        String?            // ex: "visita", "atendimento", "beneficio"

  familia     Familia  @relation(fields: [familiaId], references: [id])

  @@index([familiaId])

// ─── schema-semma.prisma ───
// ─── SEMMA — Secretaria Municipal de Meio Ambiente ───────────────────────────
// Lei 6.938/1981 — Política Nacional do Meio Ambiente
// Resolução CONAMA 237/1997 — licenciamento ambiental
// Lei 9.605/1998 — crimes ambientais
// Lei 12.651/2012 — Código Florestal Brasileiro
// Resolução CONAMA 369/2006 — intervenção em APP

// ─── Licença Ambiental ────────────────────────────────────────────────────────
model LicencaAmbiental {
  id            String          @id @default(cuid())
  municipioId   String
  numero        String          // ex: "LA-2025-001"
  tipo          TipoLicenca
  status        StatusLicenca   @default(EM_ANALISE)

  // Requerente
  requerenteNome   String
  requerenteCpfCnpj String
  requerenteTelefone String?
  requerenteEmail  String?

  // Empreendimento
  empreendimentoNome String
  atividadePrincipal String    // CNAE / descrição
  localizacao        String
  coordLat           Decimal?  @db.Decimal(10, 7)
  coordLng           Decimal?  @db.Decimal(10, 7)
  areaHectares       Decimal?  @db.Decimal(10, 4)

  // Prazos e valores
  dataRequerimento   DateTime  @default(now())
  dataEmissao        DateTime?
  dataVencimento     DateTime?
  valorTaxa          Decimal?  @db.Decimal(10, 2)
  dataPagamento      DateTime?

  // Condicionantes
  condicionantes     String?   @db.Text
  observacao         String?   @db.Text
  parecerTecnico     String?   @db.Text
  tecnicoResponsavel String?

  ativo          Boolean       @default(true)
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  autuacoes      AutoInfracaoAmbiental[]

  @@unique([municipioId, numero])
  @@index([municipioId, tipo, status])
  @@map("licenca_ambiental")

enum TipoLicenca {
  LP    // Licença Prévia — viabilidade do projeto
  LI    // Licença de Instalação — início das obras
  LO    // Licença de Operação — funcionamento
  LAS   // Licença Ambiental Simplificada — baixo impacto
  LAC   // Licença Ambiental por Compromisso
  LUR   // Licença Urbanística (uso do solo)

enum StatusLicenca {
  EM_ANALISE
  AGUARDANDO_VISTORIA
  AGUARDANDO_DOCUMENTOS
  AGUARDANDO_PAGAMENTO
  EMITIDA
  VENCIDA
  CASSADA
  INDEFERIDA
  CANCELADA

// ─── Auto de Infração Ambiental ───────────────────────────────────────────────
model AutoInfracaoAmbiental {
  id             String         @id @default(cuid())
  municipioId    String
  numero         String         // ex: "AIA-2025-042"
  dataAuto       DateTime
  fiscal         String
  autuadoNome    String
  autuadoCpfCnpj String
  localizacao    String?

  // Infração
  tipoInfracao   TipoInfracaoAmb
  descricao      String         @db.Text
  artLegal       String?        // ex: "Lei 9.605/1998 Art. 50"

  // Valores
  valorMulta     Decimal        @db.Decimal(12, 2)
  valorMultaReducao Decimal?    @db.Decimal(12, 2)  // com desconto por pagamento antecipado

  // Status
  status         StatusAutoAmb  @default(LAVRADO)
  dataDefesa     DateTime?
  resultadoDefesa String?       @db.Text
  dataPagamento  DateTime?

  licencaId      String?
  licenca        LicencaAmbiental? @relation(fields: [licencaId], references: [id])

  observacao     String?        @db.Text
  criadoEm      DateTime        @default(now())

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@map("auto_infracao_ambiental")

enum TipoInfracaoAmb {
  DESMATAMENTO
  QUEIMADA
  POLUICAO_AGUA
  POLUICAO_AR
  POLUICAO_SOLO
  CACA_PESCA_ILEGAL
  CONSTRUCAO_APP    // Área de Preservação Permanente
  EXTRATIVISMO_ILEGAL
  RESIDUOS_IRREGULARES
  OUTRO

enum StatusAutoAmb {
  LAVRADO
  NOTIFICADO
  EM_DEFESA
  JULGADO_PROCEDENTE
  JULGADO_IMPROCEDENTE
  PAGO
  INSCRITO_DIVIDA

// ─── Arborização Urbana ────────────────────────────────────────────────────────
model ArvoreUrbana {
  id            String         @id @default(cuid())
  municipioId   String
  codigo        String         // ex: "ARV-2025-0042"
  especie       String
  nomePopular   String?
  localizacao   String         // rua, número, bairro
  coordLat      Decimal?       @db.Decimal(10, 7)
  coordLng      Decimal?       @db.Decimal(10, 7)

  situacao      SituacaoArvore @default(BOA)
  alturaMetros  Decimal?       @db.Decimal(5, 2)
  dapCm         Decimal?       @db.Decimal(6, 2)  // Diâmetro à Altura do Peito
  idadeAnos     Int?

  // Histórico de podas/supressões
  ultimaPoda    DateTime?
  proximaPoda   DateTime?
  suprimida     Boolean        @default(false)
  dataSuppressao DateTime?
  motivoSuppressao String?

  observacao    String?        @db.Text
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@unique([municipioId, codigo])
  @@index([municipioId, situacao])
  @@map("arvore_urbana")

enum SituacaoArvore {
  BOA
  ATENCAO     // risco médio
  RISCO       // risco alto — poda urgente
  MORTA
  SUPRIMIDA

// ─── schema-semob.prisma ───
// ─── ERP Municipal Biritinga — Módulo SEMOB (Secretaria de Obras) ────────────
// Baseado em: Lei 14.133/2021, NBR 12.721, Lei 10.257/2001 (Estatuto da Cidade),
//             Decreto-Lei 271/1967, Lei 6.766/1979, CF Art. 182/183

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — OBRAS PÚBLICAS
// ═══════════════════════════════════════════════════════════════════════════════

enum TipoObra {
  PAVIMENTACAO          // asfalto, paralelepípedo, calçada
  DRENAGEM              // sarjetas, bocas de lobo, galerias
  EDIFICACAO            // creche, UBS, escola, prédio público
  REFORMA               // reforma/ampliação de edificação existente
  SANEAMENTO            // água, esgoto, fossa séptica coletiva
  ILUMINACAO_PUBLICA    // postes, luminárias, rede elétrica
  PONTES_VIADUTOS
  PARQUES_PRACAS
  OUTROS

enum SituacaoObra {
  PLANEJAMENTO          // projeto em elaboração
  LICITACAO_PENDENTE    // aguardando processo licitatório
  LICITADA              // contrato assinado, não iniciada
  EM_ANDAMENTO          // execução física em curso
  PARALISADA            // suspensa temporariamente
  CONCLUIDA             // obra entregue
  CANCELADA

enum SituacaoCronograma {
  NO_PRAZO
  ATRASADA
  ADIANTADA
  CONCLUIDA

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — ALVARÁS
// ═══════════════════════════════════════════════════════════════════════════════

enum TipoAlvara {
  CONSTRUCAO            // nova edificação
  REFORMA               // sem alteração de área
  AMPLIACAO             // aumento de área construída
  DEMOLICAO
  REGULARIZACAO         // regularização de construção existente
  LOCALIZACAO_FUNCIONAMENTO // alvará comercial
  PUBLICIDADE           // outdoor, fachada, letreiro
  PARCELAMENTO_SOLO     // loteamento, desmembramento
  EVENTOS

enum SituacaoAlvara {
  SOLICITADO            // protocolo recebido
  EM_ANALISE            // técnico analisando
  PENDENTE_DOCUMENTOS   // aguardando doc. do requerente
  APROVADO              // aprovado, aguardando pagamento
  EMITIDO               // alvará emitido e válido
  VENCIDO               // prazo expirado
  SUSPENSO
  CASSADO
  INDEFERIDO

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — FISCALIZAÇÃO
// ═══════════════════════════════════════════════════════════════════════════════

enum TipoFiscalizacao {
  ROTINA                // vistoria periódica programada
  DENUNCIA              // originada de denúncia/reclamação
  AUTO_INFRACAO         // notificação de irregularidade
  EMBARGO               // paralisação de obra irregular
  VERIFICACAO_CONCLUSAO // aceite de obra concluída
  REINCIDENCIA          // reincidência de infração

enum SituacaoFiscalizacao {
  ABERTA
  EM_CAMPO              // fiscal em vistoria
  AGUARDANDO_PRAZO      // notificado, dentro do prazo
  CUMPRIDA
  AUTO_INFRACAO_EMITIDO
  EMBARGADA
  ENCERRADA

// ═══════════════════════════════════════════════════════════════════════════════
// OBRAS PÚBLICAS
// ═══════════════════════════════════════════════════════════════════════════════

model ObraPublica {
  id               String          @id @default(cuid())
  municipioId      String
  numero           String          // "OBRA-2026-001"
  tipo             TipoObra
  situacao         SituacaoObra    @default(PLANEJAMENTO)

  // Identificação
  nome             String
  descricao        String          @db.Text
  bairro           String?
  logradouro       String?
  coordLatitude    Decimal?        @db.Decimal(10,7)
  coordLongitude   Decimal?        @db.Decimal(10,7)

  // Referências contratuais
  contratoId       String?         // Contrato SEMAD
  licitacaoId      String?         // Licitação SEMAD
  empenhoId        String?         // Empenho SEFIN
  processoNumero   String?

  // Executora
  empresaNome      String?
  empresaCnpj      String?
  engenheiroNome   String?
  engeheiroArt     String?         // número ART no CREA/CAU

  // Valores
  valorContratado  Decimal?        @db.Decimal(14,2)
  valorAditivos    Decimal         @db.Decimal(14,2) @default(0)
  valorMedido      Decimal         @db.Decimal(14,2) @default(0)
  percentualFisico Decimal         @db.Decimal(5,2)  @default(0)

  // Prazos
  dataOrdemServico DateTime?       // OS emitida
  dataInicioReal   DateTime?
  dataPrevistaConclusao DateTime?
  dataConclusao    DateTime?
  prazoMeses       Int?

  // Projeto
  areaTotal        Decimal?        @db.Decimal(10,2) // m²
  extensao         Decimal?        @db.Decimal(10,2) // m linear (pavimentação)
  fonteCusteio     String?         // "PAC 2026 / Recurso Próprio / Conv. Fed."
  programaFederal  String?         // "Novo PAC / FNHIS / FNDE"
  convenioNumero   String?

  // Fiscalização interna
  fiscalId         String?
  fiscalNome       String?

  observacoes      String?         @db.Text
  ativo            Boolean         @default(true)
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt

  medicoes         MedicaoObra[]
  cronograma       EtapaCronograma[]
  fotos            FotoObra[]
  fiscalizacoes    FiscalizacaoObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])

// ─── Medições de obra ─────────────────────────────────────────────────────────

model MedicaoObra {
  id               String      @id @default(cuid())
  municipioId      String
  obraId           String
  obra             ObraPublica @relation(fields: [obraId], references: [id])
  numero           Int         // 1ª, 2ª, 3ª medição…
  periodo          String      // "2026-11"
  descricao        String      @db.Text
  percentualPeriodo Decimal    @db.Decimal(5,2)  // % executado neste período
  percentualAcumulado Decimal  @db.Decimal(5,2)  // % acumulado até esta medição
  valorMedicao     Decimal     @db.Decimal(14,2)
  valorAcumulado   Decimal     @db.Decimal(14,2)
  atestado         Boolean     @default(false)
  dataAteste       DateTime?
  empenhoId        String?
  observacoes      String?
  usuarioId        String?
  criadoEm         DateTime    @default(now())

  @@unique([obraId, numero])
  @@index([obraId])

// ─── Cronograma físico-financeiro ─────────────────────────────────────────────

model EtapaCronograma {
  id               String      @id @default(cuid())
  obraId           String
  obra             ObraPublica @relation(fields: [obraId], references: [id])
  ordem            Int
  descricao        String
  responsavel      String?
  percentualFisico Decimal     @db.Decimal(5,2)  // peso % desta etapa
  valorPrevisto    Decimal?    @db.Decimal(14,2)
  dataInicioPrevista DateTime?
  dataFimPrevista  DateTime?
  dataInicioReal   DateTime?
  dataFimReal      DateTime?
  situacao         SituacaoCronograma @default(NO_PRAZO)
  percentualConcluido Decimal  @db.Decimal(5,2) @default(0)
  criadoEm         DateTime    @default(now())

  @@index([obraId])

// ─── Fotos de obra ────────────────────────────────────────────────────────────

model FotoObra {
  id               String      @id @default(cuid())
  municipioId      String
  obraId           String
  obra             ObraPublica @relation(fields: [obraId], references: [id])
  url              String
  legenda          String?
  dataFoto         DateTime    @default(now())
  medicaoId        String?     // vinculada à medição
  usuarioId        String?
  criadoEm         DateTime    @default(now())

  @@index([obraId])

// ═══════════════════════════════════════════════════════════════════════════════
// ALVARÁS
// ═══════════════════════════════════════════════════════════════════════════════

model Alvara {
  id               String          @id @default(cuid())
  municipioId      String
  numero           String          // "ALV-2026-001"
  tipo             TipoAlvara
  situacao         SituacaoAlvara  @default(SOLICITADO)

  // Requerente
  requerenteNome   String
  requerenteCpfCnpj String
  requerenteEmail  String?
  requerenteTelefone String?

  // Imóvel / Localização
  logradouro       String
  numero_imovel    String?
  bairro           String?
  inscricaoImobiliaria String?     // número no IPTU
  coordLatitude    Decimal?        @db.Decimal(10,7)
  coordLongitude   Decimal?        @db.Decimal(10,7)

  // Descrição do projeto (construção/reforma)
  descricaoObra    String?         @db.Text
  areaTotal        Decimal?        @db.Decimal(10,2)
  areaConstruida   Decimal?        @db.Decimal(10,2)
  numeroPavimentos Int?
  usoEdificacao    String?         // "Residencial unifamiliar / Comercial / Misto"

  // Responsável técnico
  responsavelNome  String?
  responsavelCrea  String?
  artNumero        String?

  // Tramitação
  dataProtocolo    DateTime        @default(now())
  dataAnalise      DateTime?
  dataAprovacao    DateTime?
  dataEmissao      DateTime?
  dataVencimento   DateTime?
  dataValidade     Int?            // dias de validade (padrão 365)

  // Taxas
  valorTaxa        Decimal?        @db.Decimal(10,2)
  dataPagamentoTaxa DateTime?
  nossaNumero      String?

  // Documentos exigidos
  documentosExigidos Json?         // lista dinâmica por tipo de alvará
  documentosRecebidos Json?

  motivoIndeferimento String?      @db.Text
  tecnicoResponsavel String?       // servidor que analisou
  observacoes      String?         @db.Text
  usuarioId        String?
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt

  fiscalizacoes    FiscalizacaoObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, requerenteCpfCnpj])

// ═══════════════════════════════════════════════════════════════════════════════
// FISCALIZAÇÃO DE OBRAS / POSTURAS MUNICIPAIS
// ═══════════════════════════════════════════════════════════════════════════════

model FiscalizacaoObra {
  id               String               @id @default(cuid())
  municipioId      String
  numero           String               // "FISC-2026-001"
  tipo             TipoFiscalizacao
  situacao         SituacaoFiscalizacao @default(ABERTA)

  // Origem
  obraId           String?
  obra             ObraPublica?         @relation(fields: [obraId], references: [id])
  alvaraId         String?
  alvara           Alvara?              @relation(fields: [alvaraId], references: [id])
  origemDenuncia   String?              @db.Text // se tipo=DENUNCIA

  // Localização
  logradouro       String
  numero_local     String?
  bairro           String?
  referencia       String?

  // Infrator
  infratoresNomes  String?
  infratoresCpfCnpj String?

  // Vistoria
  dataAbertura     DateTime            @default(now())
  dataVistoria     DateTime?
  fiscalNome       String
  fiscalMatricula  String?
  relatorioVistoria String?            @db.Text
  fotosUrls        Json?               // lista de URLs

  // Notificação / auto
  dataNotiicacao   DateTime?
  prazoRegularizacao Int?              // dias para regularizar
  dataLimiteRegularizacao DateTime?
  numeroAutoInfracao String?
  valorMulta       Decimal?            @db.Decimal(10,2)

  // Embargo
  dataEmbargo      DateTime?
  motivoEmbargo    String?             @db.Text
  dataLevantamento DateTime?

  // Encerramento
  dataCumprimento  DateTime?
  dataEncerramento DateTime?
  resultadoFinal   String?             @db.Text

  usuarioId        String?
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([obraId])
  @@index([alvaraId])

// ─── schema-servicos.prisma ───
// ─── ERP Municipal — Módulo SERVIÇOS URBANOS & LIMPEZA PÚBLICA ───────────────
// Lei 11.445/2007 — Saneamento básico (serviços de limpeza urbana e manejo de RSU)
// Lei 12.305/2010 — Política Nacional de Resíduos Sólidos (PNRS)
// NBR 10.004/2004 — Resíduos sólidos (classificação)
// Resolução CONAMA 275/2001 — código de cores para coleta seletiva
// CTB — Código de Trânsito Brasileiro (licenciamento de veículos)
  url      = env("DATABASE_URL")

enum TipoServico {
  COLETA_LIXO
  COLETA_SELETIVA
  CAPINA
  ROÇAGEM
  PODA_ARVORE
  TAPA_BURACO
  MANUTENCAO_CALÇADA
  LIMPEZA_VALA
  LIMPEZA_LOGRADOURO
  DEDETIZACAO
  MANUTENCAO_PRACA
  ILUMINACAO_PUBLICA
  SINALIZACAO_VIARIA
  MANUTENCAO_ESTRADA_RURAL
  OUTROS

enum PrioridadeOS {
  BAIXA
  NORMAL
  ALTA
  URGENTE

enum SituacaoOS {
  ABERTA
  EM_ATENDIMENTO
  AGUARDANDO_MATERIAL
  CONCLUIDA
  CANCELADA
  REABERTA

enum OrigemOS {
  PROGRAMADA
  DEMANDA_CIDADAO
  OUVIDORIA
  DETERMINACAO_SUPERIOR
  VISTORIA
  EMERGENCIA

enum TipoVeiculo {
  CAMINHAO_COLETOR
  CAMINHAO_PIPA
  CAMINHAO_BASCULANTE
  TRATOR
  RETRO_ESCAVADEIRA
  PA_CARREGADEIRA
  MOTONIVELADORA
  VEICULO_LEVE
  MOTO
  MICRO_ONIBUS
  ONIBUS
  OUTROS

enum SituacaoVeiculo {
  DISPONIVEL
  EM_USO
  MANUTENCAO
  INATIVO
  ALIENADO

enum SituacaoRoteiro {
  PROGRAMADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
  INTERROMPIDO

model OrdemServico {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "OS-2026-00001"

  tipo        TipoServico
  prioridade  PrioridadeOS @default(NORMAL)
  situacao    SituacaoOS @default(ABERTA)
  origem      OrigemOS @default(PROGRAMADA)

  // Localização
  logradouro  String?
  bairro      String?
  referencia  String?
  lat         Float?
  lng         Float?

  // Descrição
  descricao   String   @db.Text
  observacoes String?  @db.Text
  solicitante String?
  telefone    String?

  // Atribuição
  equipeResponsavel String?
  veiculoId         String?

  // Datas
  dataAbertura  DateTime @default(now())
  dataLimite    DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?

  // Material utilizado (JSON)
  materiaisUsados String? @db.Text

  // Avaliação
  avaliacao   Int?
  feedbackCidadao String? @db.Text

  // Vínculo ouvidoria
  protocoloOuvidoria String?

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, bairro])

model Veiculo {
  id          String   @id @default(cuid())
  municipioId String

  placa           String
  tipo            TipoVeiculo
  marca           String?
  modelo          String?
  anoFabricacao   Int?
  anoModelo       Int?
  cor             String?
  chassi          String?
  patrimonio      String?
  situacao        SituacaoVeiculo @default(DISPONIVEL)

  renavam           String?
  dataLicenciamento DateTime?
  seguroApolice     String?
  dataVencSeguro    DateTime?

  kmAtual       Int @default(0)
  kmProxRevisao Int?

  tipoCombustivel  String?
  tanqueCapacidade Float?

  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  ordens         OrdemServico[]
  manutencoes    ManutencaoVeiculo[]
  abastecimentos AbastecimentoVeiculo[]
  itensRoteiro   ItemRoteiro[]

  @@unique([municipioId, placa])
  @@index([municipioId, situacao])

model ManutencaoVeiculo {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "MNT-2026-00001"
  veiculoId   String

  tipo        String
  descricao   String   @db.Text
  oficina     String?
  kmMedicao   Int?
  valor       Decimal  @db.Decimal(10,2) @default(0)
  dataEntrada DateTime @default(now())
  dataSaida   DateTime?
  observacoes String?  @db.Text
  concluida   Boolean  @default(false)

  usuarioId String?
  criadoEm  DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, veiculoId])

model AbastecimentoVeiculo {
  id          String   @id @default(cuid())
  municipioId String
  veiculoId   String

  dataAbastecimento DateTime @default(now())
  combustivel  String
  litros       Float
  valorLitro   Decimal @db.Decimal(6,3)
  valorTotal   Decimal @db.Decimal(10,2)
  kmAtual      Int?
  posto        String?
  condutorNome String?

  usuarioId String?
  criadoEm  DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, veiculoId])

model RoteiroColeta {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "ROT-2026-001"

  nome         String
  tipo         String
  situacao     SituacaoRoteiro @default(PROGRAMADO)
  diaSemana    String?
  periocidade  String?

  dataHoraInicio  DateTime?
  dataHoraFim     DateTime?
  responsavelNome String?

  toneladas    Float?
  kmPercorrido Float?
  observacoes  String? @db.Text

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())

  itens ItemRoteiro[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])

model ItemRoteiro {
  id          String   @id @default(cuid())
  municipioId String
  roteiroId   String
  veiculoId   String?

  logradouro  String
  bairro      String?
  sequencia   Int
  estimativaKg Float?

  concluido    Boolean  @default(false)
  kgColetado   Float?
  horaConclusao DateTime?

  roteiro RoteiroColeta @relation(fields: [roteiroId], references: [id])
  veiculo Veiculo? @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, roteiroId])

// ─── schema-transparencia.prisma ───
// ─── ERP Municipal — Módulo TRANSPARÊNCIA PÚBLICA ─────────────────────────────
// Lei Complementar 131/2009 — Transparência Fiscal (atualiza LC 101/2000 LRF)
// Lei 12.527/2011 — Lei de Acesso à Informação
// Decreto 7.185/2010 — Sistema de Finanças Públicas
// Portaria STN 548/2010 — detalhes mínimos de transparência
// Decreto 10.540/2020 — SICONFI / SIAFIC
// CF/88 Art. 165 §3 — publicidade do orçamento
// Lei 4.320/1964 — Normas de Direito Financeiro
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoPublicacao {
  RECEITA_PREVISTA
  RECEITA_REALIZADA
  DESPESA_ORCADA
  DESPESA_EMPENHADA
  DESPESA_LIQUIDADA
  DESPESA_PAGA
  LICITACAO
  CONTRATO
  CONVENIO
  FOLHA_PAGAMENTO
  BALANCETE
  BALANÇO_ANUAL
  RELATORIO_LRF       // RREO / RGF
  DIARIO_OFICIAL
  ATA_CAMARA
  DECRETO
  PORTARIA
  RESOLUCAO

enum NaturezaReceita {
  TRIBUTARIA          // impostos, taxas, contribuições
  PATRIMONIAL         // alugueis, dividendos
  AGROPECUARIA
  INDUSTRIAL
  SERVICOS
  TRANSFERENCIAS_CORRENTES
  OUTRAS_CORRENTES
  OPERACOES_CREDITO
  ALIENACAO_BENS
  AMORTIZACAO_EMPRESTIMOS
  TRANSFERENCIAS_CAPITAL
  OUTRAS_CAPITAL
  INTRAORCAMENTARIAS

enum NaturezaDespesa {
  PESSOAL_ENCARGOS
  JUROS_ENCARGOS_DIVIDA
  OUTRAS_DESPESAS_CORRENTES
  INVESTIMENTOS
  INVERSOES_FINANCEIRAS
  AMORTIZACAO_DIVIDA

enum SituacaoPublicacao {
  RASCUNHO
  PUBLICADA
  RETIFICADA
  REVOGADA

enum PeriodoLRF {
  BIMESTRAL_1   // jan-fev
  BIMESTRAL_2   // mar-abr
  BIMESTRAL_3   // mai-jun
  BIMESTRAL_4   // jul-ago
  BIMESTRAL_5   // set-out
  BIMESTRAL_6   // nov-dez
  QUADRIMESTRAL_1 // jan-abr
  QUADRIMESTRAL_2 // mai-ago
  QUADRIMESTRAL_3 // set-dez
  ANUAL

// ─── Publicação do Portal da Transparência ───────────────────────────────────

model PublicacaoTransparencia {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoPublicacao
  situacao    SituacaoPublicacao @default(PUBLICADA)

  titulo      String
  descricao   String?  @db.Text
  periodo     String?           // "2026-01", "2026", "1º Bimestre 2026"
  exercicio   Int?              // ano de referência

  // Valor consolidado (quando aplicável)
  valorTotal  Decimal? @db.Decimal(15,2)

  // Arquivo
  urlArquivo  String?
  nomeArquivo String?
  tamanho     Int?

  tags        String?           // busca full-text

  publicadoEm DateTime @default(now())
  usuarioId   String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, tipo])
  @@index([municipioId, exercicio])
  @@index([municipioId, situacao])

// ─── Receita (execução orçamentária) ─────────────────────────────────────────

model ReceitaOrcamentaria {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  mes         Int               // 1–12
  competencia String            // "2026-01"

  // Classificação
  codigoReceita String          // ex: "1.1.1.0.00" — IRRF
  natureza      NaturezaReceita
  descricao     String
  fonte         String?         // ex: "Recursos Próprios"
  unidadeGestora String?

  // Valores
  previsto      Decimal  @db.Decimal(15,2) @default(0)
  arrecadado    Decimal  @db.Decimal(15,2) @default(0)

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, competencia, codigoReceita])
  @@index([municipioId, exercicio])
  @@index([municipioId, competencia])
  @@index([municipioId, natureza])

// ─── Despesa (execução orçamentária) ─────────────────────────────────────────

model DespesaOrcamentaria {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  mes         Int
  competencia String

  // Classificação funcional-programática
  orgao        String            // ex: "02 — Secretaria de Educação"
  unidade      String?
  funcao       String?           // ex: "12 — Educação"
  subfuncao    String?
  programa     String?
  acao         String?
  natureza     NaturezaDespesa

  // Classificação econômica
  elementoDespesa String?       // ex: "3390.39 — Outros Serv. Terceiros PJ"

  descricao    String
  fonte        String?

  // Estágios
  orcado       Decimal  @db.Decimal(15,2) @default(0)
  empenhado    Decimal  @db.Decimal(15,2) @default(0)
  liquidado    Decimal  @db.Decimal(15,2) @default(0)
  pago         Decimal  @db.Decimal(15,2) @default(0)

  // Credor (quando aplicável)
  credorNome   String?
  credorCPFCNPJ String?

  // Documento
  numeroEmpenho String?
  documentoFiscal String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, exercicio])
  @@index([municipioId, competencia])
  @@index([municipioId, natureza])
  @@index([municipioId, credorCPFCNPJ])

// ─── Relatórios LRF (RREO / RGF) ─────────────────────────────────────────────

model RelatorioLRF {
  id          String   @id @default(cuid())
  municipioId String

  tipo        String            // RREO ou RGF
  periodo     PeriodoLRF
  exercicio   Int
  situacao    SituacaoPublicacao @default(RASCUNHO)

  // Dados consolidados
  receitaRealizada  Decimal? @db.Decimal(15,2)
  despesaRealizada  Decimal? @db.Decimal(15,2)
  resultadoPrimario Decimal? @db.Decimal(15,2)
  dividaConsolidada Decimal? @db.Decimal(15,2)
  despesaPessoal    Decimal? @db.Decimal(15,2)
  limitePessoal     Decimal? @db.Decimal(15,2)   // % da RCL

  // LRF Art. 55 — dívida consolidada líquida
  dividaConsolidadaLiquida Decimal? @db.Decimal(15,2)
  receitaCorrenteLiquida   Decimal? @db.Decimal(15,2)

  urlArquivo  String?
  observacoes String? @db.Text

  publicadoEm DateTime?
  dataEnvioSIAPE DateTime?
  dataEnvioSIAFIC DateTime?

  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, tipo, periodo, exercicio])
  @@index([municipioId, exercicio])

// ─── schema-tributacao.prisma ───
// ─── TRIBUTAÇÃO MUNICIPAL ─────────────────────────────────────────────────────
// CTN Lei 5.172/1966 — Código Tributário Nacional
// LC 116/2003 — ISS (Imposto Sobre Serviços de Qualquer Natureza)
// LC 157/2016 — Alíquota mínima ISS 2% / máxima 5%
// Lei 10.257/2001 (Estatuto da Cidade) — IPTU progressivo / IPTU Social
// CF/88 Art.156 — competência municipal: IPTU, ITBI, ISS
// Lei 6.830/1980 — Execução Fiscal (Dívida Ativa)
// Resolução CGSN 140/2018 — ISS Simples Nacional

enum TipoPessoa {
  FISICA
  JURIDICA

enum SituacaoContribuinte {
  ATIVO
  SUSPENSO       // em processo administrativo
  BAIXADO        // empresas encerradas
  CANCELADO      // inscrição cancelada
  INAPTO         // irregular na Receita Federal

enum TipoImovel {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  RURAL
  MISTO          // residencial + comercial
  TERRENO        // sem edificação
  ESPECIAL       // hospitais, igrejas, escolas

enum SituacaoLancamento {
  ABERTO         // aguardando pagamento
  PAGO           // quitado integralmente
  PARCELADO      // em parcelamento ativo
  CANCELADO      // lançamento cancelado
  PRESCRITO      // prescrito (CTN Art.174 — 5 anos)
  PROTESTADO     // enviado a protesto extrajudicial
  AJUIZADO       // em execução fiscal (Lei 6.830/80)
  SUSPENSO       // suspenso por recurso/liminar

enum TipoLancamento {
  ISS_FIXO       // profissional autônomo / sociedade uniprofissional
  ISS_VARIAVEL   // base = receita bruta (tomadores que retêm na fonte)
  ISS_RETIDO     // retido pelo tomador de serviço (LC 116 Art.6)
  IPTU           // Imposto Predial e Territorial Urbano
  ITBI           // Imposto de Transmissão de Bens Imóveis
  TAXA_LIMPEZA   // TLP — Taxa de Limpeza Pública
  TAXA_OBRAS     // TCO — Taxa de Conservação e Obras
  TAXA_ALVARA    // TFA — Taxa de Fiscalização e Alvará
  TAXA_PUBLICIDADE // TPA — Taxa de Publicidade
  COSIP          // Contribuição Social Iluminação Pública
  DIVIDA_ATIVA   // lançamento ex-officio dívida inscrita

enum OrigemDebito {
  DECLARACAO     // declarado pelo próprio contribuinte (DES)
  ARBITRAMENTO   // arbitrado pelo fisco (CTN Art.148)
  RETENCAO       // retido na fonte
  AUTO_INFRACAO  // auto de infração lavrado pela fiscalização
  INSCRICAO      // inscrição automática em dívida ativa
  PARCELAMENTO   // parcela de acordo de parcelamento

// ─── CONTRIBUINTE ─────────────────────────────────────────────────────────────
model Contribuinte {
  id              String              @id @default(cuid())
  municipioId     String
  inscricaoMunicipal String           // "ISS-2026-00001" ou "CAD-00001"
  tipoPessoa      TipoPessoa
  situacao        SituacaoContribuinte @default(ATIVO)

  // Pessoa Física
  cpf             String?
  nomeCompleto    String?

  // Pessoa Jurídica
  cnpj            String?
  razaoSocial     String?
  nomeFantasia    String?
  inscricaoEstadual String?
  dataAbertura    DateTime?
  dataEncerramento DateTime?
  naturezaJuridica String?            // "206-2 — LTDA" (código IBGE)

  // Endereço fiscal
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  uf              String?             @default("BA")
  cep             String?

  // Contato
  email           String?
  telefone        String?
  responsavelNome String?
  responsavelCpf  String?

  // Classificação ISS (LC 116/2003)
  cnae            String?             // CNAE principal (7 dígitos)
  listaServicoLC116 String?           // "1.01", "7.09", etc.
  regimeTributario String?            // SIMPLES_NACIONAL, LUCRO_PRESUMIDO, LUCRO_REAL, MEI, AUTONOMO
  aliquotaISS     Decimal?            @db.Decimal(5,2) // % (2% a 5%)
  issFixoAnual    Decimal?            @db.Decimal(10,2) // para autônomos/soc. uniprofissional

  // ISS retido na fonte (tomador)
  responsavelRetencao Boolean         @default(false) // é tomador obrigado a reter?

  ativo           Boolean             @default(true)
  usuarioId       String?
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  imoveis         Imovel[]
  lancamentos     LancamentoTributario[]
  desss           DesServicos[]       // Declarações Eletrônicas de Serviços

  @@unique([municipioId, inscricaoMunicipal])
  @@unique([municipioId, cpf])
  @@unique([municipioId, cnpj])
  @@index([municipioId, situacao])
  @@index([municipioId, cnae])

// ─── IMÓVEL (IPTU) ───────────────────────────────────────────────────────────
model Imovel {
  id              String              @id @default(cuid())
  municipioId     String
  inscricaoImobiliaria String         // "0001.001.0001.001" (setor.quadra.lote.sub)
  contribuinteId  String?

  tipoImovel      TipoImovel          @default(RESIDENCIAL)
  situacao        String              @default("ATIVO") // ATIVO, ISENTO, DEMOLIDO, RURAL

  // Localização
  logradouro      String
  numero          String?
  complemento     String?
  bairro          String?
  cep             String?
  latitude        Decimal?            @db.Decimal(10,7)
  longitude       Decimal?            @db.Decimal(10,7)

  // Características físicas
  areaTerreno     Decimal             @db.Decimal(10,2) // m²
  areaConstruida  Decimal?            @db.Decimal(10,2) // m²
  testada         Decimal?            @db.Decimal(8,2)  // m (frente do lote)
  profundidade    Decimal?            @db.Decimal(8,2)  // m

  // Avaliação fiscal (Planta Genérica de Valores — PGV)
  valorVenalTerreno  Decimal          @db.Decimal(14,2) // R$ (base IPTU)
  valorVenalConstrucao Decimal?       @db.Decimal(14,2) // R$ (edificação)
  valorVenal      Decimal             @db.Decimal(14,2) // total para cálculo
  valorVenalAno   Int                 // ano da avaliação

  // IPTU
  aliquotaIPTU    Decimal             @db.Decimal(5,3) // % (ex: 0.600 = 0,6%)
  reducaoFiscal   Decimal?            @db.Decimal(5,2) // % desconto (isenção parcial)
  motivoReducao   String?             // "SERVIDOR_MUNICIPAL", "IDOSO", "BAIXA_RENDA"
  isento          Boolean             @default(false)
  motivoIsencao   String?             // "TEMPLO_RELIGIOSO", "ENTIDADE_BENEFICENTE"

  // IPTU Progressivo (Estatuto da Cidade Art.7)
  iptuProgressivo Boolean             @default(false)
  anoProgressivo  Int?                // início da progressividade
  aliquotaProgressiva Decimal?        @db.Decimal(5,3)

  // Proprietário (pode ser diferente do contribuinte)
  proprietarioNome String?
  proprietarioCpfCnpj String?

  ativo           Boolean             @default(true)
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  contribuinte    Contribuinte?       @relation(fields: [contribuinteId], references: [id])
  lancamentos     LancamentoTributario[]

  @@unique([municipioId, inscricaoImobiliaria])
  @@index([municipioId, tipoImovel])
  @@index([municipioId, bairro])

// ─── DECLARAÇÃO ELETRÔNICA DE SERVIÇOS (DES/NFS-e) ──────────────────────────
model DesServicos {
  id              String              @id @default(cuid())
  municipioId     String
  contribuinteId  String
  competencia     String              // "2026-01"
  numeroNfs       String?             // número da NFS-e
  tomadorCnpjCpf  String?
  tomadorNome     String?
  tomadorMunicipio String?
  tomadorUF       String?
  listaServico    String              // "7.09" (LC 116)
  descricaoServico String?
  valorServico    Decimal             @db.Decimal(14,2)
  valorDeducao    Decimal             @default(0) @db.Decimal(14,2) // materiais, subempreitada
  baseCalculo     Decimal             @db.Decimal(14,2) // valor - deduções
  aliquota        Decimal             @db.Decimal(5,2)  // %
  valorISS        Decimal             @db.Decimal(14,2)
  retidoFonte     Boolean             @default(false)   // ISS retido pelo tomador
  issRetido       Decimal?            @db.Decimal(14,2) // valor retido
  issDever        Decimal?            @db.Decimal(14,2) // valor a recolher (iss - retido)
  issRetidoAnterior Decimal?          @db.Decimal(14,2)

  status          String              @default("DECLARADA") // DECLARADA, RETIFICADA, CANCELADA
  usuarioId       String?
  criadoEm        DateTime            @default(now())

  contribuinte    Contribuinte        @relation(fields: [contribuinteId], references: [id])

  @@index([contribuinteId])
  @@index([municipioId, competencia])

// ─── LANÇAMENTO TRIBUTÁRIO ────────────────────────────────────────────────────
model LancamentoTributario {
  id              String              @id @default(cuid())
  municipioId     String
  contribuinteId  String?
  imovelId        String?             // para IPTU/ITBI/COSIP
  numeroCda       String?             // Certidão de Dívida Ativa

  tipoLancamento  TipoLancamento
  situacao        SituacaoLancamento  @default(ABERTO)
  origem          OrigemDebito        @default(DECLARACAO)

  exercicio       Int                 // ano de competência
  competencia     String?             // "2026-01" (mês a mês para ISS variável)
  vencimento      DateTime

  // Valores
  valorPrincipal  Decimal             @db.Decimal(14,2)
  valorMulta      Decimal             @default(0) @db.Decimal(14,2)
  valorJuros      Decimal             @default(0) @db.Decimal(14,2)
  valorCorrecao   Decimal             @default(0) @db.Decimal(14,2) // IPCA/SELIC
  valorTotal      Decimal             @db.Decimal(14,2) // calculado
  valorPago       Decimal             @default(0) @db.Decimal(14,2)
  valorSaldo      Decimal             @db.Decimal(14,2) // calculado

  // Dívida Ativa (Lei 6.830/80)
  datainscricaoCda DateTime?
  numeroProcessoExec String?

  descricao       String?             @db.Text
  observacoes     String?             @db.Text
  parcelas        ParcelamentoTributario[]
  pagamentos      PagamentoTributario[]

  ativo           Boolean             @default(true)
  usuarioId       String?
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  contribuinte    Contribuinte?       @relation(fields: [contribuinteId], references: [id])
  imovel          Imovel?             @relation(fields: [imovelId], references: [id])

  @@index([municipioId, situacao])
  @@index([municipioId, tipoLancamento])
  @@index([municipioId, exercicio])
  @@index([municipioId, vencimento])
  @@index([contribuinteId])
  @@index([imovelId])

// ─── PARCELAMENTO ─────────────────────────────────────────────────────────────
model ParcelamentoTributario {
  id              String              @id @default(cuid())
  municipioId     String
  lancamentoId    String
  numeroParcela   Int
  totalParcelas   Int
  vencimento      DateTime
  valorParcela    Decimal             @db.Decimal(14,2)
  valorPago       Decimal?            @db.Decimal(14,2)
  dataPagamento   DateTime?
  situacao        String              @default("ABERTA") // ABERTA, PAGA, VENCIDA

  lancamento      LancamentoTributario @relation(fields: [lancamentoId], references: [id])

  @@index([lancamentoId])

// ─── PAGAMENTO ────────────────────────────────────────────────────────────────
model PagamentoTributario {
  id              String              @id @default(cuid())
  municipioId     String
  lancamentoId    String
  dataCompetencia String?
  dataPagamento   DateTime
  valorPago       Decimal             @db.Decimal(14,2)
  formaPagamento  String              @default("PIX") // PIX, BOLETO, DINHEIRO, CARTAO, COMPENSACAO
  nossoNumero     String?             // boleto / Pix txid
  autenticacao    String?
  origem          String?             // "CAIXA_MUNICIPAL", "BANCO_DO_BRASIL", "API_PIX"
  usuarioId       String?
  criadoEm        DateTime            @default(now())

  lancamento      LancamentoTributario @relation(fields: [lancamentoId], references: [id])

  @@index([lancamentoId])
  @@index([municipioId, dataPagamento])

// ─── schema-tributacao.prisma ───
// ─── ERP Municipal — Módulo TRIBUTAÇÃO & FISCAL ───────────────────────────────
// CTN — Código Tributário Nacional (Lei 5.172/1966)
// Lei 10.257/2001 — Estatuto da Cidade (IPTU progressivo)
// LC 116/2003 — Imposto Sobre Serviços de Qualquer Natureza (ISS/ISSQN)
// Lei 6.830/1980 — Execução Fiscal (Dívida Ativa)
// Lei 4.320/1964 — Normas gerais de finanças municipais
// SELIC — taxa referencial para correção monetária e juros
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SituacaoLancamento {
  EM_ABERTO
  PAGO
  PARCELADO
  INSCRITO_DA       // Inscrito em Dívida Ativa
  CANCELADO
  REMIDO
  PRESCRITO

enum TipoImovel {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  RURAL
  MISTO
  ESPECIAL

enum SituacaoImovel {
  ATIVO
  ISENTO
  IMUNE
  INATIVO

enum TipoAliquotaISS {
  FIXO
  PERCENTUAL

enum SituacaoGuiaISS {
  EM_ABERTO
  PAGA
  PARCELADA
  INSCRITA_DA
  CANCELADA
  ISENTA

enum TipoContribuinteISS {
  PESSOA_FISICA
  PESSOA_JURIDICA
  MEI
  AUTONOMO

enum SituacaoParcelamento {
  EM_DIA
  EM_ATRASO
  QUITADO
  CANCELADO
  RENEGOCIADO

enum SituacaoDA {
  ATIVA
  PARCELADA
  QUITADA
  CANCELADA
  AJUIZADA
  PRESCRITA
  SUSPENSA_DECISAO

enum TipoOrigemDA {
  IPTU
  ISS
  TAXA_LIMPEZA
  TAXA_ILUMINACAO
  MULTA_AMBIENTAL
  MULTA_SANITARIA
  MULTA_OBRAS
  OUTROS

// ─── Cadastro Imobiliário (IPTU) ──────────────────────────────────────────────

model ImovelUrbano {
  id          String   @id @default(cuid())
  municipioId String

  // Identificação
  inscricaoCadastral String   // "0001.001.001.001" único por municipio
  inscricaoAnterior  String?

  // Localização
  logradouro     String
  numero         String?
  complemento    String?
  bairro         String
  cep            String?
  quadra         String?
  lote           String?
  lat            Float?
  lng            Float?

  // Proprietário
  cpfCnpjProprietario String?
  nomeProprietario    String
  enderecoCorrespondencia String?

  // Características do imóvel
  tipoImovel       TipoImovel   @default(RESIDENCIAL)
  situacaoImovel   SituacaoImovel @default(ATIVO)
  areaTerreno      Float?       // m²
  areaConstruida   Float?       // m²
  valorVenal       Decimal?     @db.Decimal(14,2)
  valorTerreno     Decimal?     @db.Decimal(14,2)
  valorConstrucao  Decimal?     @db.Decimal(14,2)

  // Alíquota e benefícios
  aliquota         Float        @default(1.0)  // %
  motivoIsencao    String?

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentosIPTU LancamentoIPTU[]

  @@unique([municipioId, inscricaoCadastral])
  @@index([municipioId, situacaoImovel])
  @@index([municipioId, bairro])
  @@index([municipioId, cpfCnpjProprietario])

model LancamentoIPTU {
  id          String   @id @default(cuid())
  municipioId String
  imovelId    String
  numero      String   // "IPTU-2026-000001"

  exercicio   Int      // ano fiscal
  situacao    SituacaoLancamento @default(EM_ABERTO)

  // Cálculo
  valorVenal       Decimal  @db.Decimal(14,2)
  aliquota         Float
  valorOriginal    Decimal  @db.Decimal(10,2)
  valorDesconto    Decimal  @db.Decimal(10,2) @default(0)
  valorFinal       Decimal  @db.Decimal(10,2)

  // Vencimentos (parcelas únicas ou em cota)
  dataVencimento   DateTime
  dataPagamento    DateTime?
  valorPago        Decimal?  @db.Decimal(10,2)
  formaPagamento   String?

  // Multa e juros (após vencimento)
  percentualMulta  Float    @default(2.0)
  percentualJuros  Float    @default(1.0)  // ao mês

  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  imovel      ImovelUrbano       @relation(fields: [imovelId], references: [id])
  parcelamentos ParcelamentoIPTU[]

  @@unique([municipioId, numero])
  @@index([municipioId, exercicio, situacao])
  @@index([municipioId, imovelId])

model ParcelamentoIPTU {
  id          String   @id @default(cuid())
  municipioId String
  lancamentoId String
  numero      String   // "PARC-IPTU-2026-00001"

  situacao    SituacaoParcelamento @default(EM_DIA)
  totalParcelas Int
  valorTotal  Decimal @db.Decimal(10,2)
  dataInicio  DateTime @default(now())
  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())

  lancamento  LancamentoIPTU @relation(fields: [lancamentoId], references: [id])
  parcelas    ParcelaIPTU[]

  @@unique([municipioId, numero])

model ParcelaIPTU {
  id              String   @id @default(cuid())
  municipioId     String
  parcelamentoId  String
  numeroParcela   Int
  valor           Decimal  @db.Decimal(10,2)
  dataVencimento  DateTime
  dataPagamento   DateTime?
  valorPago       Decimal?  @db.Decimal(10,2)
  pago            Boolean  @default(false)

  parcelamento ParcelamentoIPTU @relation(fields: [parcelamentoId], references: [id])

  @@index([municipioId, parcelamentoId])

// ─── ISS — Imposto Sobre Serviços ─────────────────────────────────────────────

model ContribuinteISS {
  id          String   @id @default(cuid())
  municipioId String

  cpfCnpj         String
  razaoSocial      String
  nomeFantasia     String?
  tipoContribuinte TipoContribuinteISS @default(PESSOA_JURIDICA)

  // Enquadramento
  codigoAtividade  String?   // código de serviço LC 116/2003
  descricaoAtividade String?
  aliquota         Float     @default(2.0)  // %
  tipoAliquota     TipoAliquotaISS @default(PERCENTUAL)
  valorFixoMensal  Decimal?  @db.Decimal(10,2)  // para profissional autônomo

  // Contato
  email     String?
  telefone  String?
  endereco  String?
  bairro    String?

  // Regime
  simplesNacional  Boolean @default(false)
  mei              Boolean @default(false)

  inscricaoMunicipal String?
  dataAbertura       DateTime?
  dataEncerramento   DateTime?

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  guias GuiaISS[]

  @@unique([municipioId, cpfCnpj])
  @@index([municipioId])

model GuiaISS {
  id          String   @id @default(cuid())
  municipioId String
  contribuinteId String
  numero      String   // "ISS-2026-000001"

  competencia  String   // "2026-10" (AAAA-MM)
  situacao     SituacaoGuiaISS @default(EM_ABERTO)

  // Cálculo
  baseCalculo      Decimal  @db.Decimal(14,2)
  aliquota         Float
  valorOriginal    Decimal  @db.Decimal(10,2)
  valorDesconto    Decimal  @db.Decimal(10,2) @default(0)
  valorFinal       Decimal  @db.Decimal(10,2)

  dataVencimento  DateTime
  dataPagamento   DateTime?
  valorPago       Decimal?  @db.Decimal(10,2)
  formaPagamento  String?

  percentualMulta Float @default(2.0)
  percentualJuros Float @default(1.0)

  // Nota fiscal vinculada
  nfseNumero     String?
  nfseDataEmissao DateTime?

  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contribuinte ContribuinteISS @relation(fields: [contribuinteId], references: [id])
  parcelamentos ParcelamentoISS[]

  @@unique([municipioId, numero])
  @@index([municipioId, competencia, situacao])

model ParcelamentoISS {
  id          String   @id @default(cuid())
  municipioId String
  guiaId      String
  numero      String   // "PARC-ISS-2026-00001"

  situacao      SituacaoParcelamento @default(EM_DIA)
  totalParcelas Int
  valorTotal    Decimal @db.Decimal(10,2)
  dataInicio    DateTime @default(now())
  observacoes   String? @db.Text
  usuarioId     String?
  criadoEm      DateTime @default(now())

  guia     GuiaISS @relation(fields: [guiaId], references: [id])
  parcelas ParcelaISS[]

  @@unique([municipioId, numero])

model ParcelaISS {
  id             String   @id @default(cuid())
  municipioId    String
  parcelamentoId String
  numeroParcela  Int
  valor          Decimal  @db.Decimal(10,2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  valorPago      Decimal? @db.Decimal(10,2)
  pago           Boolean  @default(false)

  parcelamento ParcelamentoISS @relation(fields: [parcelamentoId], references: [id])

  @@index([municipioId, parcelamentoId])

// ─── Dívida Ativa ─────────────────────────────────────────────────────────────

model DividaAtiva {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "DA-2026-000001"

  // Devedor
  cpfCnpjDevedor String
  nomeDevedor    String
  enderecoDevedor String?

  // Origem
  tipoOrigem    TipoOrigemDA
  origemId      String?   // id do lançamento IPTU ou guia ISS original
  exercicio     Int?
  situacao      SituacaoDA @default(ATIVA)

  // Valores
  valorOriginal   Decimal @db.Decimal(14,2)
  valorCorrecao   Decimal @db.Decimal(10,2) @default(0)
  valorJuros      Decimal @db.Decimal(10,2) @default(0)
  valorMulta      Decimal @db.Decimal(10,2) @default(0)
  valorHonorarios Decimal @db.Decimal(10,2) @default(0)
  valorTotal      Decimal @db.Decimal(14,2)
  valorPago       Decimal @db.Decimal(10,2) @default(0)

  dataInscricao   DateTime @default(now())
  dataAjuizamento DateTime?
  dataQuitacao    DateTime?
  dataCancelamento DateTime?

  // Número do processo de execução fiscal (Lei 6.830/80)
  numeroProcesso  String?
  varaJuizo       String?

  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  parcelamentos ParcelamentoDA[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, cpfCnpjDevedor])
  @@index([municipioId, tipoOrigem])

model ParcelamentoDA {
  id          String   @id @default(cuid())
  municipioId String
  dividaId    String
  numero      String   // "PARC-DA-2026-00001"

  situacao      SituacaoParcelamento @default(EM_DIA)
  totalParcelas Int
  valorTotal    Decimal @db.Decimal(14,2)
  valorEntrada  Decimal @db.Decimal(10,2) @default(0)
  dataInicio    DateTime @default(now())
  observacoes   String? @db.Text
  usuarioId     String?
  criadoEm      DateTime @default(now())

  divida   DividaAtiva  @relation(fields: [dividaId], references: [id])
  parcelas ParcelaDA[]

  @@unique([municipioId, numero])

model ParcelaDA {
  id             String   @id @default(cuid())
  municipioId    String
  parcelamentoId String
  numeroParcela  Int
  valor          Decimal  @db.Decimal(10,2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  valorPago      Decimal? @db.Decimal(10,2)
  pago           Boolean  @default(false)

  parcelamento ParcelamentoDA @relation(fields: [parcelamentoId], references: [id])

  @@index([municipioId, parcelamentoId])

// ─── schema-tributos.prisma ───
// ─── ERP Municipal — Módulo TRIBUTAÇÃO & ARRECADAÇÃO ─────────────────────────
// CTN Lei 5.172/1966 — Código Tributário Nacional
// LC 116/2003 — ISS (Imposto Sobre Serviços de Qualquer Natureza)
// Lei 10.257/2001 — Estatuto da Cidade (IPTU progressivo no tempo)
// LC 123/2006 — Simples Nacional; MEI
// LRF LC 101/2000 — transparência fiscal
// CF/88 Art. 156 — competência tributária dos municípios: IPTU, ITBI, ISS
// Lei 6.830/1980 — Lei de Execução Fiscal (cobrança da dívida ativa)
// Dec. 70.235/1972 — Processo Administrativo Fiscal (PAF)
// Res. CFC 1.330/2011 — NBCASP — contabilidade pública
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoTributo {
  IPTU           // Imposto Predial e Territorial Urbano — CF Art. 156 I
  ISSQN          // Imposto Sobre Serviços — LC 116/2003
  ITBI           // Imposto de Transmissão de Bens Imóveis — CF Art. 156 II
  COSIP          // Contribuição de Iluminação Pública — CF Art. 149-A
  TAXA_LIXO      // Taxa de coleta de resíduos sólidos
  TAXA_ALVARA    // Taxa de licença para funcionamento
  TAXA_PUBLICIDADE // Taxa de fiscalização de publicidade
  CONTRIBUICAO_MELHORIA // Art. 81 CTN
  MULTA_INFRAÇÃO // Autuações diversas
  OUTROS

enum SituacaoLancamento {
  ABERTO         // em aberto, não vencido
  VENCIDO        // vencido, não pago
  PAGO           // pago integral
  PAGO_PARCIAL   // pago parcialmente
  CANCELADO      // lançamento cancelado
  SUSPENSO       // suspenso por decisão judicial/admin
  INSCRITO_DA    // inscrito em dívida ativa

enum SituacaoDividaAtiva {
  INSCRITA
  EM_COBRANCA    // notificado/cobrado extrajudicialmente
  EM_EXECUCAO    // ajuizada Lei 6.830/1980
  PARCELADA
  QUITADA
  PRESCRITA      // CTN Art. 174 — 5 anos
  CANCELADA

enum SituacaoParcelamento {
  ATIVO
  ADIMPLENTE
  INADIMPLENTE   // 2+ parcelas em atraso
  CONCLUIDO
  ROMPIDO        // perdeu o parcelamento

enum TipoPessoa {
  FISICA
  JURIDICA

// ─── Contribuinte ─────────────────────────────────────────────────────────────
// CTN Art. 121 — sujeito passivo da obrigação principal

model Contribuinte {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoPessoa @default(FISICA)
  nome        String
  cpfCnpj     String
  inscricaoMunicipal String? // IM — cadastro tributário municipal
  email       String?
  telefone    String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cep         String?
  ativo       Boolean  @default(true)

  // Optante Simples Nacional / MEI — LC 123/2006
  simplesNacional Boolean @default(false)
  mei             Boolean @default(false)
  cnae            String? // atividade principal

  lancamentos LancamentoTributario[]
  imoveis     ImovelUrbano[]
  dividasAtivas DividaAtiva[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, cpfCnpj])
  @@index([municipioId])
  @@index([municipioId, tipo])

// ─── Imóvel Urbano ────────────────────────────────────────────────────────────
// IPTU — Lei 10.257/2001; CF Art. 156 I
// Progressividade no tempo — Art. 182 §4 CF c/c Art. 7 Lei 10.257/2001

model ImovelUrbano {
  id             String @id @default(cuid())
  contribuinteId String
  municipioId    String

  inscricaoCadastral String  // número cadastral do imóvel
  logradouro     String
  numero         String?
  complemento    String?
  bairro         String
  cep            String?
  quadra         String?
  lote           String?
  zona           String?   // ZR1/ZR2/ZC/ZI…

  // Dados físicos
  areaTerreno    Decimal? @db.Decimal(10,2)
  areaConstruida Decimal? @db.Decimal(10,2)
  testada        Decimal? @db.Decimal(8,2)
  tipoUso        String?  // RESIDENCIAL/COMERCIAL/INDUSTRIAL/MISTO

  // Valores venais (base cálculo IPTU)
  valorVenal     Decimal? @db.Decimal(15,2)
  valorVenalTerreno Decimal? @db.Decimal(15,2)
  valorVenalConstrucao Decimal? @db.Decimal(15,2)
  aliquota       Decimal? @db.Decimal(5,4) // ex: 0.0050 = 0,5%

  // IPTU progressivo — Lei 10.257/2001 Art. 7
  iptuProgressivo Boolean @default(false)
  anoProgressividade Int? // ano início da progressividade

  contribuinte   Contribuinte @relation(fields: [contribuinteId], references: [id])
  lancamentos    LancamentoTributario[]

  criadoEm    DateTime @default(now())

  @@unique([municipioId, inscricaoCadastral])
  @@index([contribuinteId])
  @@index([municipioId, bairro])

// ─── Lançamento Tributário ────────────────────────────────────────────────────
// CTN Art. 142 — lançamento: ato privativo da autoridade administrativa
// DAM — Documento de Arrecadação Municipal

model LancamentoTributario {
  id             String   @id @default(cuid())
  contribuinteId String
  imovelId       String?
  municipioId    String

  tipo           TipoTributo
  exercicio      Int         // ano fiscal
  parcela        Int?        // 1..12 para lançamentos parcelados
  totalParcelas  Int?

  // Valores
  valorPrincipal Decimal  @db.Decimal(15,2)
  valorDesconto  Decimal  @db.Decimal(15,2) @default(0)
  valorMulta     Decimal  @db.Decimal(15,2) @default(0)
  valorJuros     Decimal  @db.Decimal(15,2) @default(0)
  valorTotal     Decimal  @db.Decimal(15,2) // principal - desconto + multa + juros

  dataVencimento DateTime
  dataPagamento  DateTime?
  valorPago      Decimal? @db.Decimal(15,2)
  formaPagamento String?  // PIX/BOLETO/DINHEIRO/CARTAO

  situacao       SituacaoLancamento @default(ABERTO)
  observacao     String?

  // Código de barras / linha digitável (DAM)
  codigoBarras   String?
  linhaDigitavel String?

  contribuinte   Contribuinte @relation(fields: [contribuinteId], references: [id])
  imovel         ImovelUrbano? @relation(fields: [imovelId], references: [id])
  dividaAtiva    DividaAtiva?
  parcelasDivida ParcelaDivida[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([contribuinteId])
  @@index([municipioId, tipo, exercicio])
  @@index([municipioId, situacao])
  @@index([municipioId, dataVencimento])

// ─── Dívida Ativa ─────────────────────────────────────────────────────────────
// CTN Art. 201-204 — dívida ativa tributária
// Lei 6.830/1980 — Lei de Execução Fiscal
// CTN Art. 174 — prazo prescricional: 5 anos
// Res. CFC 1.330/2011 NBCASP — contabilização da dívida ativa

model DividaAtiva {
  id              String   @id @default(cuid())
  contribuinteId  String
  lancamentoId    String?  @unique
  municipioId     String

  numeroInscricao String   // "DA-2026-001234"
  dataInscricao   DateTime @default(now())

  tipo            TipoTributo
  exercicio       Int

  valorOriginal   Decimal  @db.Decimal(15,2)
  valorAtualizado Decimal  @db.Decimal(15,2) // com juros/multa atualizados
  valorMulta      Decimal  @db.Decimal(15,2) @default(0)
  valorJuros      Decimal  @db.Decimal(15,2) @default(0)
  valorCustas     Decimal  @db.Decimal(15,2) @default(0)

  situacao        SituacaoDividaAtiva @default(INSCRITA)

  // Cobrança judicial — Lei 6.830/1980
  numeroProcesso  String?  // número do processo de execução fiscal
  dataAjuizamento DateTime?
  dataConhecimento DateTime? // citação do devedor

  // Prescrição — CTN Art. 174
  dataPrescricao  DateTime // dataInscricao + 5 anos
  alertaPrescricao Boolean @default(false)

  observacao      String?

  contribuinte    Contribuinte @relation(fields: [contribuinteId], references: [id])
  lancamento      LancamentoTributario? @relation(fields: [lancamentoId], references: [id])
  parcelamentos   Parcelamento[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, numeroInscricao])
  @@index([contribuinteId])
  @@index([municipioId, situacao])
  @@index([municipioId, exercicio])
  @@index([municipioId, dataPrescricao])

// ─── Parcelamento de Dívida ───────────────────────────────────────────────────
// CTN Art. 151 II — parcelamento suspende a exigibilidade
// Código Tributário Municipal define condições de parcelamento

model Parcelamento {
  id             String   @id @default(cuid())
  dividaAtivaId  String
  contribuinteId String?
  municipioId    String

  numeroParcelamento String // "PARC-2026-0001"
  dataAcordo     DateTime @default(now())

  valorTotal     Decimal  @db.Decimal(15,2)
  totalParcelas  Int
  valorParcela   Decimal  @db.Decimal(15,2)
  diaVencimento  Int      // dia do mês (1-28)

  situacao       SituacaoParcelamento @default(ATIVO)
  parcelasQuitadas Int  @default(0)
  parcelasEmAtraso Int  @default(0)
  dataConclusao  DateTime?

  dividaAtiva    DividaAtiva @relation(fields: [dividaAtivaId], references: [id])
  parcelas       ParcelaDivida[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, numeroParcelamento])
  @@index([municipioId, situacao])
  @@index([dividaAtivaId])

model ParcelaDivida {
  id              String @id @default(cuid())
  parcelamentoId  String
  lancamentoId    String?
  municipioId     String

  numero          Int
  valor           Decimal @db.Decimal(15,2)
  dataVencimento  DateTime
  dataPagamento   DateTime?
  valorPago       Decimal? @db.Decimal(15,2)
  paga            Boolean @default(false)

  parcelamento    Parcelamento @relation(fields: [parcelamentoId], references: [id])
  lancamento      LancamentoTributario? @relation(fields: [lancamentoId], references: [id])

  @@index([parcelamentoId])
  @@index([municipioId, dataVencimento])

// ─── Core schema ───
// ─── CORE — Schema compartilhado (auth, RBAC, audit) ─────────────────────────
// Este arquivo define os modelos de base que todos os módulos referenciam.
// Em produção, todos os schemas são concatenados em um único schema.prisma.


  url      = env("DATABASE_URL")

// ─── Município (tenant raiz) ──────────────────────────────────────────────────

model Municipio {
  id        String   @id @default(cuid())
  nome      String
  uf        String   @db.Char(2)
  ibge      String   @unique            // código IBGE 7 dígitos
  cnpj      String?  @unique
  slug      String   @unique            // "biritinga" → biritinga.ba.gov.br
  dominio   String?                     // domínio personalizado
  logoUrl   String?
  corPrimaria String? @db.Char(7)       // "#1a56db"
  ativo     Boolean  @default(true)
  plano     String   @default("basico") // "basico" | "pro" | "enterprise"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  perfis    Perfil[]
  auditLogs AuditLog[]
  sessoes   Sessao[]

// ─── Usuário ──────────────────────────────────────────────────────────────────

enum PerfilPadrao {
  SUPER_ADMIN       // Anthropic / suporte — acesso total
  ADMIN_MUNICIPIO   // Secretário ou TI do município
  GESTOR            // gerente de secretaria
  OPERADOR          // servidor comum
  VISUALIZADOR      // somente leitura
  PORTAL_CIDADAO    // usuário externo (cidadão)

model Usuario {
  id            String       @id @default(cuid())
  municipioId   String
  nome          String
  email         String
  senhaHash     String
  cpf           String?
  telefone      String?
  cargo         String?
  secretaria    String?
  perfil        PerfilPadrao @default(OPERADOR)
  perfilId      String?      // Perfil customizado (sobrescreve perfil padrão)
  ativo         Boolean      @default(true)
  mfaAtivado    Boolean      @default(false)
  mfaSegredo    String?
  ultimoLogin   DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte  DateTime?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  municipio     Municipio    @relation(fields: [municipioId], references: [id])
  perfilCustom  Perfil?      @relation(fields: [perfilId], references: [id])
  sessoes       Sessao[]
  auditLogs     AuditLog[]

  @@unique([municipioId, email])
  @@unique([municipioId, cpf])
  @@index([municipioId, perfil])
  @@index([municipioId, secretaria])

// ─── Perfil de acesso customizável ───────────────────────────────────────────

model Perfil {
  id          String   @id @default(cuid())
  municipioId String
  nome        String                // "Procurador Chefe", "Fiscal de Obras"
  descricao   String?
  permissoes  String   @db.Text     // JSON: ["pgm:processo:create","semob:obra:read",...]
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuarios    Usuario[]

  @@unique([municipioId, nome])
  @@index([municipioId])

// ─── Sessão / Refresh token ───────────────────────────────────────────────────

model Sessao {
  id            String    @id @default(cuid())
  municipioId   String
  usuarioId     String
  refreshToken  String    @db.Text  // hash do refresh token
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  municipio     Municipio @relation(fields: [municipioId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([municipioId, expiresAt])

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  municipioId String
  usuarioId   String?
  acao        String   // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "EXPORT"
  modulo      String   // "semad" | "sefin" | "pgm" | "auth" | ...
  recurso     String   // "usuario" | "obra" | "processo" | ...
  registroId  String?  // ID do registro afetado
  dadosAntigos String? @db.LongText  // JSON before
  dadosNovos   String? @db.LongText  // JSON after
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([municipioId, modulo, createdAt])
  @@index([municipioId, usuarioId])
  @@index([registroId])

// ─── Token de redefinição de senha ───────────────────────────────────────────

model TokenResetSenha {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiresAt DateTime
  usadoEm   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
