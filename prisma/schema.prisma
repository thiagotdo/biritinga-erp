model ProcessoJuridico {
  id                String             @id @default(cuid())
  municipioId       String
  numero            String             // "0001234-12.2026.8.05.0000"
  numeroInterno     String             // "PJ-2026-001"
  tipo              TipoProcesso
  polo              PoloProcesso
  status            StatusProcesso     @default(ATIVO)
  fase              FaseProcesso       @default(INICIAL)
  resultado         ResultadoProcesso?
  assunto           String
  descricao         String?
  vara              String?            // Vara / Tribunal
  comarca           String?
  juiz              String?
  parteContraria    String             // nome da parte adversa
  advogadoExterno   String?
  procuradorId      String?            // usuário responsável
  valorCausa        Decimal?           @db.Decimal(15,2)
  valorCondenacao   Decimal?           @db.Decimal(15,2)
  dataDistribuicao  DateTime
  dataTransito      DateTime?
  proximoPrazo      DateTime?          // próximo prazo processual
  observacoes       String?
  ativo             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  movimentos        MovimentoProcesso[]
  documentos        DocumentoProcesso[]

  @@unique([municipioId, numeroInterno])
  @@index([municipioId, status])
  @@index([municipioId, proximoPrazo])
  @@index([municipioId, tipo])
}

model MovimentoProcesso {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
