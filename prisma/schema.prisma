model Familia {
  id               String              @id @default(cuid())
  municipioId      String
  codigo           String              // Código interno (ex: FAM-2026-00123)
  nomeReferencia   String              // Nome do responsável familiar
  cpfReferencia    String
  nis              String?             // NIS — Número de Identificação Social (NIS Família)
  prontuarioNum    String?             // Número do prontuário CRAS/CREAS
  unidadeId        String?             // CRAS/CREAS de referência
  tecnicoId        String?             // Técnico social responsável
  situacao         SituacaoFamilia     @default(ATIVA)
  vulnerabilidade  NivelVulnerabilidade @default(MEDIO)

  // Endereço
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  referencia       String?
  tipoMoradia      TipoMoradia?
  condicaoMoradia  CondicaoMoradia?
  temAguaEncanada  Boolean?
  temEsgoto        Boolean?
  temEnergiaEletrica Boolean?
  temColetaLixo    Boolean?

  // Renda
  rendaFamiliarTotal Float?
  rendaPerCapita   Float?
  qtdPessoasRenda  Int?

  // ESF / território
  microarea        String?
  agenteSaudeId    String?

  // Flags especiais
  familiaRural     Boolean @default(false)
  quilombola       Boolean @default(false)
  indigena         Boolean @default(false)
  cigana           Boolean @default(false)

  // Situações de risco
  violenciaDomestica   Boolean @default(false)
  exploracaoInfantil   Boolean @default(false)
  trabalhoInfantil     Boolean @default(false)
  usoDrogas            Boolean @default(false)
  semMoradia           Boolean @default(false)
  migranteRefugiado    Boolean @default(false)

  observacoes      String?             @db.Text
  ativo            Boolean             @default(true)
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  membros          MembroFamilia[]
  atendimentos     AtendimentoSocial[]
  beneficios       BeneficioSocial[]
  visitas          VisitaDomiciliar[]
  encaminhamentos  EncaminhamentoSocial[]
  evolucoes        EvolucaoFamiliar[]
  unidade          UnidadeSemas?       @relation(fields: [unidadeId], references: [id])

  @@unique([municipioId, codigo])
  @@index([municipioId, situacao])
  @@index([municipioId, vulnerabilidade])
  @@index([municipioId, cpfReferencia])
}

model MembroFamilia {
  id               String           @id @default(cuid())
  familiaId        String
  nome             String
  cpf              String?
  nis              String?
  dataNascimento   DateTime?
  sexo             String?          // M / F
  relacao          RelacaoFamiliar  @default(OUTRO)
  situacao         SituacaoMembro   @default(ATIVO)

  // Situações
  deficiencia      Boolean @default(false)
  tipoDeficiencia  String?
  gestante         Boolean @default(false)
  idoso            Boolean @default(false)
  crianca          Boolean @default(false)
  adolescente      Boolean @default(false)

  // Educação / Trabalho
  escolaridade     String?
  frequentaEscola  Boolean?
  series           String?
  trabalhando      Boolean?
  profissao        String?
  rendaMensal      Float?

  // Saúde
  possuiCNS        String?
  condicaoSaude    String?

  familia          Familia          @relation(fields: [familiaId], references: [id])

  @@index([familiaId])
  @@index([cpf])
}

model UnidadeSemas {
  id        String   @id @default(cuid())
  nome      String
  tipo      String   // CRAS, CREAS, CENTRO_DIA, ABRIGO, etc.
