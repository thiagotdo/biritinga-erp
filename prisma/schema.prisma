// ═══════════════════════════════════════════════════════════════════════════
// SCHEMA UNIFICADO — ERP Municipal Biritinga
// Gerado automaticamente — NÃO editar manualmente
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── schema-modulos.prisma ───
// ─── ModuloConfig — Controle de Visibilidade dos Módulos ERP ─────────────────
// Cada linha representa um módulo do ERP Municipal.
// O campo `estado` controla se o módulo aparece para todos (PUBLICO)
// ou apenas para administradores (ADMIN).
// Permite também desabilitar completamente um módulo (DESATIVADO).

model ModuloConfig {
  id          String       @id @default(cuid())
  municipioId String

  // Identificação
  slug        String       // ex: "tributacao", "frota", "patrimonio"
  nome        String       // ex: "Tributação & Arrecadação"
  descricao   String?      // breve descrição para o painel
  icone       String?      // emoji ou nome de ícone (ex: "🏛️", "🚗", "💰")
  rota        String       // caminho Next.js, ex: "/gestao/tributos"
  categoria   String?      // ex: "Financeiro", "Operacional", "Social"
  ordem       Int          @default(0)  // ordem de exibição no painel

  // Estado de visibilidade
  estado      EstadoModulo @default(ADMIN)
  // PUBLICO   → visível para qualquer usuário autenticado
  // ADMIN     → visível apenas para usuários com role ADMIN/SUPER_ADMIN
  // DESATIVADO → oculto para todos (incluindo admin, exceto SUPER_ADMIN)

  // Auditoria
  atualizadoPor String?    // userId de quem fez a última alteração
  criadoEm    DateTime     @default(now())
  atualizadoEm DateTime    @updatedAt

  @@unique([municipioId, slug])
  @@index([municipioId, estado])
  @@map("modulo_config")

enum EstadoModulo {
  PUBLICO
  ADMIN
  DESATIVADO

// ─── schema-almoxarifado.prisma ───
// ─── ALMOXARIFADO & PATRIMÔNIO ───────────────────────────────────────────────
// Lei 4.320/1964 Art.94-100 — inventário e controle de bens
// Decreto 99.658/1990 — reclassificação e destinação de material
// NBR 14.653 — avaliação de bens (referência p/ laudos)
// NBC TG 27 (CFC) — ativo imobilizado: reconhecimento, depreciação
// NBC TG 16 / NBCASP P.4 — estoques públicos: custo médio ponderado
// IN STN 4/2001 — plano de contas e registro patrimonial
// MCASP (Manual Contabilidade Aplicada ao Setor Público) — depreciação linear
// Instrução Normativa 205/1988 — almoxarifado federal (referência municipal)
// Resolução CFC 1.137/2008 — gestão de estoque no setor público
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum NaturezaMaterial {
  CONSUMO       // materiais de consumo — despesa no momento da saída
  PERMANENTE    // bens permanentes — ativo imobilizado
  SERVICO       // contratação de serviços (sem estoque)

enum SituacaoMaterial {
  ATIVO
  DESCONTINUADO
  SUSPENSO

enum TipoMovimentacao {
  ENTRADA_NF          // nota fiscal de compra / contrato
  ENTRADA_DOACAO      // doação recebida
  ENTRADA_DEVOLUCAO   // devolução de setor
  ENTRADA_PRODUCAO    // produção interna
  SAIDA_REQUISICAO    // requisição de setor
  SAIDA_DOACAO        // doação a terceiros
  SAIDA_DESCARTE      // descarte por inutilidade
  SAIDA_PERDA         // perda / sinistro
  AJUSTE_INVENTARIO   // ajuste de inventário (+ ou -)
  TRANSFERENCIA       // entre almoxarifados

enum SituacaoRequisicao {
  PENDENTE
  APROVADA
  ATENDIDA
  PARCIAL
  CANCELADA

enum SituacaoBem {
  ATIVO
  EM_MANUTENCAO
  ALIENADO         // vendido / doado
  DESCARTADO       // inutilizado / sucata
  FURTADO_ROUBADO
  EM_COMODATO      // cedido a terceiros
  PERDIDO

enum MetodoDepreciacao {
  LINEAR          // quotas constantes (MCASP padrão)
  ACELERADO       // aceito em legislação específica
  SEM_DEPRECIACAO // terrenos, obras de arte

enum SituacaoInventario {
  ABERTO
  EM_CONTAGEM
  CONCLUIDO
  CANCELADO

// ─── Modelos ──────────────────────────────────────────────────────────────────

model CatalogoMaterial {
  id              String   @id @default(cuid())
  municipioId     String
  codigo          String                        // CATMAT COMPRASNET ou código local
  descricao       String
  especificacao   String?  @db.Text
  unidadeMedida   String                        // UN, KG, L, CX, M2, etc.
  natureza        NaturezaMaterial @default(CONSUMO)
  grupoCatmat     String?                       // grupo CATMAT (3 dígitos)
  classeCatmat    String?                       // classe CATMAT (5 dígitos)
  estoqueMinimo   Decimal  @default(0) @db.Decimal(14,4)
  estoqueMaximo   Decimal? @db.Decimal(14,4)
  pontoPedido     Decimal? @db.Decimal(14,4)   // estoque que dispara nova compra
  custoUnitario   Decimal  @default(0) @db.Decimal(14,4)   // custo médio ponderado
  estoqueAtual    Decimal  @default(0) @db.Decimal(14,4)
  estoqueReservado Decimal @default(0) @db.Decimal(14,4)   // reservado por requisições pendentes
  situacao        SituacaoMaterial @default(ATIVO)
  fornecedorHabitual String?
  localizacao     String?                       // prateleira/posição no almoxarifado
  ativo           Boolean  @default(true)
  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  movimentacoes   MovimentacaoEstoque[]
  itensRequisicao ItemRequisicao[]
  itensEntrada    ItemEntrada[]
  bens            BemPatrimonial[]

  @@unique([municipioId, codigo])
  @@index([municipioId, natureza])
  @@index([municipioId, situacao])

model EntradaEstoque {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String                        // "ENT-2026-00001"
  tipoEntrada     TipoMovimentacao @default(ENTRADA_NF)
  fornecedorNome  String?
  fornecedorCnpj  String?
  notaFiscalNum   String?
  notaFiscalSerie String?
  notaFiscalData  DateTime?
  empenhoNumero   String?                       // vínculo com despesa
  contratoNumero  String?
  valorTotalNF    Decimal? @db.Decimal(14,2)
  dataRecebimento DateTime @default(now())
  almoxarifadoId  String?
  setorDestino    String?
  observacao      String?  @db.Text
  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  itens           ItemEntrada[]
  movimentacoes   MovimentacaoEstoque[]

  @@unique([municipioId, numero])
  @@index([municipioId, dataRecebimento])

model ItemEntrada {
  id              String   @id @default(cuid())
  municipioId     String
  entradaId       String
  entrada         EntradaEstoque @relation(fields: [entradaId], references: [id])
  materialId      String
  material        CatalogoMaterial @relation(fields: [materialId], references: [id])
  quantidade      Decimal  @db.Decimal(14,4)
  custoUnitario   Decimal  @db.Decimal(14,4)
  custoTotal      Decimal  @db.Decimal(14,2)
  custoMedioPre   Decimal? @db.Decimal(14,4)   // custo médio antes da entrada
  custoMedioPos   Decimal? @db.Decimal(14,4)   // custo médio após a entrada
  criadoEm        DateTime @default(now())

model Requisicao {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String                        // "REQ-2026-00001"
  setorSolicitante String
  responsavelNome String?
  dataSolicitacao DateTime @default(now())
  dataAtendimento DateTime?
  situacao        SituacaoRequisicao @default(PENDENTE)
  justificativa   String?  @db.Text
  observacao      String?  @db.Text
  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  itens           ItemRequisicao[]
  movimentacoes   MovimentacaoEstoque[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, setorSolicitante])

model ItemRequisicao {
  id              String   @id @default(cuid())
  municipioId     String
  requisicaoId    String
  requisicao      Requisicao @relation(fields: [requisicaoId], references: [id])
  materialId      String
  material        CatalogoMaterial @relation(fields: [materialId], references: [id])
  quantidadeSolicitada Decimal  @db.Decimal(14,4)
  quantidadeAtendida   Decimal  @default(0) @db.Decimal(14,4)
  custoUnitario   Decimal? @db.Decimal(14,4)
  custoTotal      Decimal? @db.Decimal(14,2)
  criadoEm        DateTime @default(now())

// Registro de cada movimentação no estoque
model MovimentacaoEstoque {
  id              String   @id @default(cuid())
  municipioId     String
  materialId      String
  material        CatalogoMaterial @relation(fields: [materialId], references: [id])
  tipo            TipoMovimentacao
  quantidade      Decimal  @db.Decimal(14,4)
  custoUnitario   Decimal  @db.Decimal(14,4)
  custoTotal      Decimal  @db.Decimal(14,2)
  estoqueAntes    Decimal  @db.Decimal(14,4)
  estoqueDepois   Decimal  @db.Decimal(14,4)
  entradaId       String?
  entrada         EntradaEstoque? @relation(fields: [entradaId], references: [id])
  requisicaoId    String?
  requisicao      Requisicao? @relation(fields: [requisicaoId], references: [id])
  setorDestino    String?
  observacao      String?
  usuarioId       String?
  criadoEm        DateTime @default(now())

  @@index([municipioId, materialId])
  @@index([municipioId, tipo])
  @@index([municipioId, criadoEm])

// ─── Patrimônio ───────────────────────────────────────────────────────────────

model BemPatrimonial {
  id              String   @id @default(cuid())
  municipioId     String
  plaqueta        String                        // número de tombamento "BEM-00001"
  descricao       String
  especificacao   String?  @db.Text
  materialId      String?                       // se veio do catálogo
  material        CatalogoMaterial? @relation(fields: [materialId], references: [id])
  marca           String?
  modelo          String?
  fabricante      String?
  serie           String?
  anoCriacao      Int?                          // ano de fabricação
  corDescricao    String?

  // Classificação contábil (MCASP)
  contaContabil   String?                       // ex: 1.2.3.1.1.01.01
  grupoPatrimonial String?                      // imóvel / móvel / veículo / TI
  subgrupo        String?

  // Localização e uso
  setorResponsavel String?
  responsavelNome  String?
  responsavelCpf   String?
  localizacao      String?

  // Valores
  valorAquisicao  Decimal  @db.Decimal(16,2)
  dataAquisicao   DateTime
  fornecedorNome  String?
  fornecedorCnpj  String?
  empenhoNumero   String?

  // Depreciação (MCASP — método linear)
  metodoDepreciacao MetodoDepreciacao @default(LINEAR)
  vidaUtilAnos    Int?                          // anos de vida útil
  taxaDepreciacao Decimal? @db.Decimal(8,4)    // % ao ano (ex: 10.00 = 10%)
  valorResidual   Decimal  @default(0) @db.Decimal(16,2)
  valorDeprecAcum Decimal  @default(0) @db.Decimal(16,2)
  valorLiquido    Decimal  @db.Decimal(16,2)   // aquisicao - deprec. acum.
  ultimaDeprecEm  DateTime?

  // Situação
  situacao        SituacaoBem @default(ATIVO)
  dataAlienacao   DateTime?
  motivoAlienacao String?
  valorAlienacao  Decimal? @db.Decimal(16,2)

  ativo           Boolean  @default(true)
  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  depreciacoes    DepreciacaoBem[]

  @@unique([municipioId, plaqueta])
  @@index([municipioId, situacao])
  @@index([municipioId, setorResponsavel])
  @@index([municipioId, grupoPatrimonial])

model DepreciacaoBem {
  id              String   @id @default(cuid())
  municipioId     String
  bemId           String
  bem             BemPatrimonial @relation(fields: [bemId], references: [id])
  exercicio       Int
  mes             Int?
  valorDepreciacao Decimal @db.Decimal(16,2)
  valorDeprecAcum  Decimal @db.Decimal(16,2)
  valorLiquidoFim  Decimal @db.Decimal(16,2)
  criadoEm        DateTime @default(now())

  @@index([bemId])
  @@index([municipioId, exercicio])

model Inventario {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String                        // "INV-2026-001"
  tipo            String   @default("GERAL")   // GERAL / SETOR / PONTUAL
  setorAlvo       String?
  dataInicio      DateTime
  dataFim         DateTime?
  responsavelNome String?
  situacao        SituacaoInventario @default(ABERTO)
  observacao      String?  @db.Text
  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  itens           ItemInventario[]

  @@unique([municipioId, numero])

model ItemInventario {
  id              String   @id @default(cuid())
  inventarioId    String
  inventario      Inventario @relation(fields: [inventarioId], references: [id])
  materialId      String?
  descricao       String
  unidade         String?
  estoqueContabil Decimal  @db.Decimal(14,4)   // saldo no sistema
  estoqueContado  Decimal? @db.Decimal(14,4)   // saldo físico contado
  diferenca       Decimal? @db.Decimal(14,4)   // contado - contábil
  justificativa   String?
  ajustado        Boolean  @default(false)
  criadoEm        DateTime @default(now())

// ─── schema-assistencia.prisma ───
// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO ASSISTÊNCIA SOCIAL — SUAS (Sistema Único de Assistência Social)
// ═══════════════════════════════════════════════════════════════════════════
//
// Referências legais:
//   Lei 8.742/1993  — LOAS (Lei Orgânica da Assistência Social)
//   Lei 10.836/2004 — Programa Bolsa Família
//   Lei 12.435/2011 — SUAS (Sistema Único de Assistência Social)
//   Lei 10.741/2003 — Estatuto do Idoso
//   Lei 8.069/1990  — ECA (Estatuto da Criança e do Adolescente)
//   Lei 13.146/2015 — Estatuto da Pessoa com Deficiência
//   Resolução CNAS 33/2012 — NOB-SUAS (Norma Operacional Básica)
//   LGPD Lei 13.709/2018 — Dados sensíveis das famílias
//
// Estrutura SUAS:
//   CRAS → PSB (Proteção Social Básica)  — PAIF, SCFV, serviços preventivos
//   CREAS → PSE (Proteção Social Especial) — PAEFI, MSE, abrigo/acolhimento
//   Família → Prontuário SUAS → Atendimentos → Encaminhamentos
// ═══════════════════════════════════════════════════════════════════════════

  url      = env("DATABASE_URL")
// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoUnidadeSuas {
  CRAS       // Centro de Referência de Assistência Social (PSB)
  CREAS      // Centro de Referência Especializado (PSE média complexidade)
  CENTRO_POP // Centro de Referência para Pop. em Situação de Rua
  CRAM       // Centro de Referência da Mulher
  ABRIGO     // Acolhimento institucional
  OUTRO

enum SituacaoFamilia {
  ATIVA
  INATIVA
  TRANSFERIDA
  DESLIGADA

enum NivelVulnerabilidade {
  BAIXO
  MEDIO
  ALTO
  MUITO_ALTO

enum SituacaoAtendimento {
  AGENDADO
  REALIZADO
  FALTOU
  CANCELADO
  TRANSFERIDO

enum TipoAtendimentoSuas {
  RECEPCAO_TRIAGEM
  ATENDIMENTO_INDIVIDUAL
  ATENDIMENTO_FAMILIAR
  VISITA_DOMICILIAR
  REUNIAO_GRUPO
  OFICINA
  ENCAMINHAMENTO
  ACOMPANHAMENTO
  CADASTRO_ATUALIZAÇÃO

enum TipoBeneficio {
  BPC_IDOSO             // LOAS Art. 20 — 65 anos
  BPC_PCD               // LOAS Art. 20 — PcD
  BOLSA_FAMILIA
  AUXILIO_BRASIL
  VALE_GAS
  BENEFICIO_EVENTUAL    // LOAS Art. 22 — calamidade/natalidade/morte
  BENEFICIO_MUNICIPAL
  OUTRO

enum SituacaoBeneficio {
  ATIVO
  SUSPENSO
  CANCELADO
  AGUARDANDO

// ─── Unidade SUAS ─────────────────────────────────────────────────────────────

model UnidadeSuas {
  id          String @id @default(cuid())
  municipioId String

  nome        String
  tipo        TipoUnidadeSuas
  codigo      String?    // código CRAS/CREAS no SUAS
  logradouro  String?
  bairro      String?
  cep         String?
  telefone    String?
  responsavel String?

  // Referenciamento de território (CRAS: referência territorial)
  territorioCoberto String? @db.Text

  ativo       Boolean @default(true)
  criadoEm   DateTime @default(now())

  familias    FamiliaReferenciada[]
  atendimentos AtendimentoSuas[]

  @@index([municipioId])

// ─── Família ──────────────────────────────────────────────────────────────────
// Prontuário da família no SUAS (NOB-SUAS 2012)

model FamiliaReferenciada {
  id          String @id @default(cuid())
  municipioId String

  // Número do prontuário SUAS: "2026-00001"
  numeroProntuario String

  // Responsável familiar
  responsavelNome  String
  responsavelCpf   String?
  responsavelNis   String?    // NIS (Número de Identificação Social)
  responsavelSexo  String?
  responsavelDatNasc DateTime?

  // Endereço
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cep          String?
  referencia   String?   // ponto de referência

  // Contato
  telefone     String?
  telefone2    String?

  // Classificação
  nivelVulnerabilidade NivelVulnerabilidade @default(MEDIO)
  situacao             SituacaoFamilia @default(ATIVA)

  // Composição familiar (armazenada como JSON para flexibilidade)
  // [{nome, cpf, nis, dataNasc, parentesco, pcd, bolsaFamilia, ...}]
  membrosJson  String? @db.Text

  // Renda
  rendaFamiliar  Decimal? @db.Decimal(10, 2)
  percapita      Decimal? @db.Decimal(8, 2)
  quantidadeMembros Int @default(1)

  // Programas
  bolsaFamilia  Boolean @default(false)
  bpc           Boolean @default(false)
  cadunico      Boolean @default(false)
  numeroCadunico String?

  // Situação habitacional
  tipoMoradia   String?  // PROPRIO/ALUGADO/CEDIDO/OCUPAÇÃO
  condicaoMoradia String? @db.Text

  // Vulnerabilidades (flags rápidas)
  criancas      Boolean @default(false)  // tem crianças (ECA)
  idosos        Boolean @default(false)  // tem idosos (Estatuto do Idoso)
  pcd           Boolean @default(false)  // tem PcD (Lei 13.146)
  gestante      Boolean @default(false)
  violencia     Boolean @default(false)  // em situação de violência
  substancias   Boolean @default(false)  // uso de substâncias
  situacaoRua   Boolean @default(false)  // situação de rua

  unidadeId   String?
  unidade     UnidadeSuas? @relation(fields: [unidadeId], references: [id])

  tecnicoRefId String?    // técnico de referência (usuário do sistema)
  observacoes  String? @db.Text

  dataIngresso  DateTime @default(now())
  dataDesligamento DateTime?
  motivoDesligamento String?

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  atendimentos  AtendimentoSuas[]
  beneficios    BeneficioFamilia[]

  @@unique([municipioId, numeroProntuario])
  @@unique([municipioId, responsavelCpf])
  @@index([municipioId, unidadeId])

// ─── Atendimento SUAS ─────────────────────────────────────────────────────────

model AtendimentoSuas {
  id          String @id @default(cuid())
  municipioId String

  familiaId   String
  familia     FamiliaReferenciada @relation(fields: [familiaId], references: [id])

  unidadeId   String
  unidade     UnidadeSuas @relation(fields: [unidadeId], references: [id])

  tipo        TipoAtendimentoSuas
  situacao    SituacaoAtendimento @default(AGENDADO)

  dataAtendimento DateTime
  duracaoMinutos  Int?

  tecnicoNome    String?   // técnico que realizou
  tecnicoId      String?   // usuário do sistema

  // Prontuário do atendimento
  objetivo       String? @db.Text
  descricao      String? @db.Text    // relato do atendimento
  encaminhamentos String? @db.Text   // para onde foi encaminhado

  // Vulnerabilidades identificadas neste atendimento
  vulnerabilidadesIdentificadas String? @db.Text

  planoAcao      String? @db.Text    // plano de ação estabelecido

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, familiaId])
  @@index([municipioId, dataAtendimento])

// ─── Benefício ────────────────────────────────────────────────────────────────

model BeneficioFamilia {
  id          String @id @default(cuid())
  municipioId String

  familiaId   String
  familia     FamiliaReferenciada @relation(fields: [familiaId], references: [id])

  tipo        TipoBeneficio
  situacao    SituacaoBeneficio @default(ATIVO)

  descricao   String?    // para BENEFICIO_MUNICIPAL / OUTRO
  valor       Decimal? @db.Decimal(10, 2)

  dataConcessao  DateTime @default(now())
  dataVencimento DateTime?
  dataRevogacao  DateTime?
  motivoRevogacao String?

  // Referência externa (NIS, número do benefício federal)
  referenciaExterna String?
  observacoes       String?

  usuarioId   String
  criadoEm   DateTime @default(now())

  @@index([municipioId, familiaId])
  @@index([municipioId, tipo, situacao])

// ─── schema-auditoria.prisma ───
// ─── ERP Municipal — Módulo CONTROLE INTERNO & AUDITORIA ─────────────────────
// CF/88 Art. 74 — controle interno, autoavaliação
// Lei 10.180/2001 — organiza o Sistema de Controle Interno
// IN CGU 01/2001 — metodologia de auditoria interna governamental
// IBGC / TCU — boas práticas de governança pública
// Lei 9.784/1999 — processo administrativo federal (referência)
// Estatuto de Biritinga — PAD e sindicância local
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoAuditoria {
  ORDINARIA          // planejada no PPA / LAP
  ESPECIAL           // demanda específica / denúncia
  ACOMPANHAMENTO     // obras, contratos em curso
  GOVERNANCA         // avaliação de controles internos
  CONFORMIDADE       // cumprimento de normas
  OPERACIONAL        // avaliação de eficiência
  CONTABIL           // revisão de registros contábeis

enum SituacaoAuditoria {
  PLANEJADA
  EM_EXECUCAO
  CONCLUIDA
  ARQUIVADA
  SUSPENSA

enum TipoAchado {
  NAO_CONFORMIDADE      // descumprimento de norma
  IRREGULARIDADE        // ato ilegal ou ilegítimo
  FRAQUEZA_CONTROLE     // falha nos controles internos
  INEFICIENCIA          // desperdício / má gestão
  RISCO                 // vulnerabilidade identificada
  BOA_PRATICA           // registro positivo

enum NivelRisco {
  CRITICO
  ALTO
  MEDIO
  BAIXO
  INFORMATIVO

enum SituacaoAchado {
  RASCUNHO
  CONFIRMADO
  COMUNICADO       // notificação enviada ao gestor
  EM_MONITORAMENTO
  SANEADO
  NAO_IMPLEMENTADO
  CANCELADO

enum SituacaoPAD {
  INSTAURADO
  INSTRUCAO
  RELATORIO
  JULGAMENTO
  RECURSO
  ENCERRADO_ARQUIVADO
  ENCERRADO_PENALIDADE
  SUSPENSO

enum TipoPenalidade {
  ADVERTENCIA
  SUSPENSAO
  DEMISSAO
  CASSACAO_APOSENTADORIA
  DESTITUICAO_CARGO
  MULTA
  REPOSICAO_ERARIO
  ARQUIVAMENTO

// ─── Programa de Auditoria ────────────────────────────────────────────────────

model ProgramaAuditoria {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int      // 2026
  nome        String   // "Plano Anual de Auditoria 2026"
  objetivo    String   @db.Text
  metodologia String?  @db.Text
  ativo       Boolean  @default(true)
  criadoEm   DateTime @default(now())

  auditorias  Auditoria[]

  @@unique([municipioId, exercicio])
  @@index([municipioId])

// ─── Auditoria ────────────────────────────────────────────────────────────────

model Auditoria {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "AUD-2026-001"

  programaId  String?
  tipo        TipoAuditoria
  situacao    SituacaoAuditoria @default(PLANEJADA)

  titulo      String
  objeto      String   @db.Text   // o que será auditado
  objetivo    String?  @db.Text
  escopo      String?  @db.Text   // período e abrangência
  criterios   String?  @db.Text   // normas de referência

  unidadeAuditada String    // nome da secretaria / órgão
  responsavelAuditado String? // nome do gestor

  auditorResponsavel String    // nome do auditor líder
  equipe          String?  @db.Text  // lista de membros

  dataInicio      DateTime?
  dataPrevFim     DateTime?
  dataFim         DateTime?

  // Resultados
  numeroBOAchados     Int @default(0)
  numeroBORecomend    Int @default(0)
  valorIrregularidade Decimal? @db.Decimal(14,2)

  relatorioUrl    String?
  observacoes     String? @db.Text

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  programa    ProgramaAuditoria? @relation(fields: [programaId], references: [id])
  achados     AchadoAuditoria[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])

// ─── Achado / Constatação ─────────────────────────────────────────────────────

model AchadoAuditoria {
  id          String   @id @default(cuid())
  municipioId String
  auditoriaId String
  numero      String   // "ACH-2026-001-01"

  tipo        TipoAchado
  nivelRisco  NivelRisco @default(MEDIO)
  situacao    SituacaoAchado @default(RASCUNHO)

  titulo      String
  condicao    String   @db.Text  // o que foi encontrado
  criterio    String?  @db.Text  // norma violada
  causa       String?  @db.Text  // por que ocorreu
  efeito      String?  @db.Text  // impacto / consequência
  evidencias  String?  @db.Text  // documentos / provas

  valorIrregularidade Decimal? @db.Decimal(14,2)

  recomendacoes Recomendacao[]

  dataComunicacao DateTime?
  prazoSanamento  DateTime?
  dataSanamento   DateTime?

  responstaGestor String? @db.Text
  parecerAuditor  String? @db.Text

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id])
  pad       PAD[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, nivelRisco])

// ─── Recomendação ─────────────────────────────────────────────────────────────

model Recomendacao {
  id          String   @id @default(cuid())
  municipioId String
  achadoId    String
  numero      String   // "REC-001"

  descricao   String   @db.Text
  responsavel String
  prazo       DateTime?
  prioridade  String   @default("MEDIA")  // ALTA / MEDIA / BAIXA

  situacao    String   @default("PENDENTE")  // PENDENTE / EM_ANDAMENTO / IMPLEMENTADA / CANCELADA
  resposta    String?  @db.Text
  dataImplementacao DateTime?

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  achado Achado @relation(fields: [achadoId], references: [id])

  @@index([municipioId, achadoId])

// Fix relation name
model Achado {
  id String @id @default(cuid())
  Recomendacao Recomendacao[]

// ─── PAD — Processo Administrativo Disciplinar ────────────────────────────────

model PAD {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "PAD-2026-001"

  tipo        String   @default("PAD")  // PAD / SINDICANCIA / INVESTIGACAO_PRELIMINAR
  situacao    SituacaoPAD @default(INSTAURADO)

  achadoId    String?

  // Acusado / investigado
  servidorNome  String
  servidorMatricula String?
  cargo         String?

  // Comissão processante
  presidenteComissao String
  membrosComissao    String? @db.Text

  // Fatos
  fatoApurado String   @db.Text
  fundamentoLegal String?  // dispositivos legais violados
  portariaInstauracao String?
  dataInstauracao DateTime

  // Prazos legais
  prazoInstrucao   DateTime?  // 60 dias (prorrogável + 60)
  dataRelatorio    DateTime?
  dataJulgamento   DateTime?

  // Resultado
  penalidade      TipoPenalidade?
  fundamentoPenalidade String? @db.Text
  valorMulta      Decimal? @db.Decimal(10,2)
  diasSuspensao   Int?

  recurso         String? @db.Text
  dataRecurso     DateTime?
  decisaoRecurso  String? @db.Text

  observacoes     String? @db.Text

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  achadoRef AchadoAuditoria? @relation(fields: [achadoId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])

// ─── Log de Conformidade ──────────────────────────────────────────────────────

model LogConformidade {
  id          String   @id @default(cuid())
  municipioId String

  modulo      String    // "LICITACOES" / "RH" / "FISCAL"
  evento      String    // descrição do evento registrado
  entidade    String?   // ex: "LicitacaoProcesso"
  entidadeId  String?
  usuarioNome String?
  ipOrigem    String?
  nivelAlerta String    @default("INFO")  // INFO / ALERTA / CRITICO

  criadoEm DateTime @default(now())

  @@index([municipioId, modulo])
  @@index([municipioId, nivelAlerta])
  @@index([municipioId, criadoEm])

// ─── schema-compras.prisma ───
// ─── COMPRAS — Gestão Municipal de Compras ────────────────────────────────────
// Lei 14.133/2021 — Nova Lei de Licitações (substitui Lei 8.666/1993)
// Lei 10.520/2002 — Pregão
// Decreto 7.892/2013 — Ata de Registro de Preços
// LC 123/2006 — Preferência ME/EPP (margem de 10% nas compras)

// ─── Fornecedor ───────────────────────────────────────────────────────────────
model Fornecedor {
  id            String   @id @default(cuid())
  municipioId   String
  cnpj          String
  razaoSocial   String
  nomeFantasia  String?
  email         String?
  telefone      String?
  endereco      String?
  cidade        String?
  uf            String?
  cep           String?
  contato       String?  // nome do representante

  tipoPorte     PorteFornecedor @default(OUTROS)  // ME, EPP, outros — LC 123/2006
  ativo         Boolean  @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  itensCotacao  ItemCotacao[]
  itensPedido   ItemPedido[]

  @@unique([municipioId, cnpj])
  @@index([municipioId, ativo])
  @@map("fornecedor")

enum PorteFornecedor {
  ME      // Microempresa
  EPP     // Empresa de Pequeno Porte
  OUTROS

// ─── Categoria de Produto/Serviço ─────────────────────────────────────────────
model CategoriaCompra {
  id          String   @id @default(cuid())
  municipioId String
  nome        String
  codigo      String?  // código CATMAT/CATSER
  ativo       Boolean  @default(true)

  itens       ItemRequisicao[]

  @@unique([municipioId, nome])
  @@map("categoria_compra")

// ─── Requisição de Compra ─────────────────────────────────────────────────────
model Requisicao {
  id            String         @id @default(cuid())
  municipioId   String
  numero        String         // ex: "REQ-2025-0042"
  titulo        String
  justificativa String         @db.Text
  secretaria    String
  solicitante   String
  prioridade    Prioridade     @default(NORMAL)
  status        StatusReq      @default(RASCUNHO)

  dataRequisicao  DateTime     @default(now())
  dataLimite      DateTime?    // prazo máximo para atendimento
  dataAprovacao   DateTime?
  aprovadoPor     String?
  motivoRejeicao  String?

  valorEstimado   Decimal?     @db.Decimal(12, 2)
  observacao      String?      @db.Text

  itens           ItemRequisicao[]
  cotacoes        Cotacao[]

  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status, prioridade])
  @@map("requisicao")

enum Prioridade { URGENTE, ALTA, NORMAL, BAIXA }

enum StatusReq {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  EM_COTACAO
  CONCLUIDA
  REJEITADA
  CANCELADA

model ItemRequisicao {
  id           String   @id @default(cuid())
  requisicaoId String
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id])
  categoriaId  String?
  categoria    CategoriaCompra? @relation(fields: [categoriaId], references: [id])

  descricao    String
  unidade      String   // UN, KG, L, m², etc.
  quantidade   Decimal  @db.Decimal(10, 3)
  valorUnitEstimado Decimal? @db.Decimal(10, 2)
  especificacao String? @db.Text  // detalhamento técnico

  @@index([requisicaoId])
  @@map("item_requisicao")

// ─── Cotação (Pesquisa de Preços) ─────────────────────────────────────────────
model Cotacao {
  id            String       @id @default(cuid())
  municipioId   String
  numero        String       // ex: "COT-2025-0012"
  requisicaoId  String?
  requisicao    Requisicao?  @relation(fields: [requisicaoId], references: [id])
  titulo        String
  status        StatusCot    @default(ABERTA)

  dataAbertura  DateTime     @default(now())
  dataFechamento DateTime?
  responsavel   String

  observacao    String?      @db.Text

  itens         ItemCotacao[]

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@map("cotacao")

enum StatusCot {
  ABERTA
  EM_ANALISE
  CONCLUIDA
  CANCELADA

model ItemCotacao {
  id           String    @id @default(cuid())
  cotacaoId    String
  cotacao      Cotacao   @relation(fields: [cotacaoId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  descricao    String
  unidade      String
  quantidade   Decimal   @db.Decimal(10, 3)
  valorUnitario Decimal  @db.Decimal(10, 2)
  valorTotal   Decimal   @db.Decimal(12, 2)
  marca        String?
  prazoEntrega Int?      // dias

  melhorPreco  Boolean   @default(false)  // vencedor da cotação para este item

  @@index([cotacaoId])
  @@index([fornecedorId])
  @@map("item_cotacao")

// ─── Pedido de Compra ─────────────────────────────────────────────────────────
model PedidoCompra {
  id            String       @id @default(cuid())
  municipioId   String
  numero        String       // ex: "PC-2025-0008"
  cotacaoId     String?
  status        StatusPedido @default(EMITIDO)

  dataEmissao   DateTime     @default(now())
  dataEntregaPrev DateTime?
  dataEntregaReal DateTime?

  secretaria    String
  responsavel   String
  observacao    String?      @db.Text

  valorTotal    Decimal      @db.Decimal(12, 2)

  // Rastreabilidade orçamentária
  empenhoNumero String?
  contaContabil String?

  itens         ItemPedido[]

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@map("pedido_compra")

enum StatusPedido {
  EMITIDO
  ENVIADO_FORNECEDOR
  CONFIRMADO_FORNECEDOR
  EM_TRANSITO
  RECEBIDO_PARCIAL
  RECEBIDO_TOTAL
  CANCELADO

model ItemPedido {
  id           String      @id @default(cuid())
  pedidoId     String
  pedido       PedidoCompra @relation(fields: [pedidoId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor  @relation(fields: [fornecedorId], references: [id])

  descricao    String
  unidade      String
  quantidade   Decimal     @db.Decimal(10, 3)
  qtdRecebida  Decimal     @db.Decimal(10, 3) @default(0)
  valorUnitario Decimal    @db.Decimal(10, 2)
  valorTotal   Decimal     @db.Decimal(12, 2)

  @@index([pedidoId])
  @@map("item_pedido")

// ─── schema-comunicacao.prisma ───
// ============================================================
// ERP MUNICIPAL — MÓDULO COMUNICAÇÃO (SECOM)
// ============================================================

enum TipoNoticia {
  NOTICIA
  NOTA_OFICIAL
  COMUNICADO
  DECRETO
  PORTARIA
  EDITAL
  RESULTADO

enum StatusNoticia {
  RASCUNHO
  REVISAO
  PUBLICADA
  ARQUIVADA

enum TipoEvento {
  AUDIENCIA_PUBLICA
  REUNIAO
  SHOW
  ESPORTE
  CULTURAL
  SAUDE
  EDUCACAO
  INAUGURACAO
  OUTRO

enum StatusEvento {
  PROGRAMADO
  EM_ANDAMENTO
  REALIZADO
  CANCELADO
  ADIADO

enum TipoMidia {
  FOTO
  VIDEO
  DOCUMENTO
  AUDIO

enum CategoriaMidia {
  INFRAESTRUTURA
  SAUDE
  EDUCACAO
  CULTURA
  ESPORTE
  EVENTO
  INSTITUCIONAL
  OUTRO

model Noticia {
  id           String        @id @default(cuid())
  municipioId  String
  titulo       String        @db.VarChar(500)
  slug         String        @db.VarChar(500)
  subtitulo    String?       @db.VarChar(500)
  corpo        String        @db.LongText
  resumo       String?       @db.Text
  tipo         TipoNoticia   @default(NOTICIA)
  status       StatusNoticia @default(RASCUNHO)
  destaque     Boolean       @default(false)
  imagemCapa   String?       @db.VarChar(500)
  tags         String?       @db.VarChar(500) // CSV
  secretaria   String?       @db.VarChar(255)
  autor        String        @db.VarChar(255)
  autorId      String?
  visualizacoes Int          @default(0)
  dataPublicacao DateTime?
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([slug, municipioId])
  @@index([municipioId])
  @@index([status])
  @@index([tipo])
  @@index([dataPublicacao])

model EventoAgenda {
  id           String       @id @default(cuid())
  municipioId  String
  titulo       String       @db.VarChar(500)
  descricao    String?      @db.Text
  tipo         TipoEvento   @default(OUTRO)
  status       StatusEvento @default(PROGRAMADO)
  local        String?      @db.VarChar(500)
  endereco     String?      @db.VarChar(500)
  dataInicio   DateTime
  dataFim      DateTime?
  horaInicio   String?      @db.VarChar(10) // HH:mm
  horaFim      String?      @db.VarChar(10)
  responsavel  String?      @db.VarChar(255)
  secretaria   String?      @db.VarChar(255)
  publicoEsperado Int?
  linkTransmissao String?   @db.VarChar(500)
  destaque     Boolean      @default(false)
  imagemCapa   String?      @db.VarChar(500)
  observacoes  String?      @db.Text
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([municipioId])
  @@index([status])
  @@index([dataInicio])

model Midia {
  id           String         @id @default(cuid())
  municipioId  String
  titulo       String         @db.VarChar(500)
  descricao    String?        @db.Text
  tipo         TipoMidia      @default(FOTO)
  categoria    CategoriaMidia @default(OUTRO)
  url          String         @db.VarChar(1000)
  urlThumb     String?        @db.VarChar(1000)
  nomeArquivo  String         @db.VarChar(500)
  tamanhoBytes Int?
  mimeType     String?        @db.VarChar(100)
  largura      Int?
  altura       Int?
  duracao      Int?           // segundos (video/audio)
  albumId      String?
  album        AlbumMidia?    @relation(fields: [albumId], references: [id])
  tags         String?        @db.VarChar(500) // CSV
  autor        String?        @db.VarChar(255)
  dataCaptura  DateTime?
  destaque     Boolean        @default(false)
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  @@index([municipioId])
  @@index([tipo])
  @@index([categoria])
  @@index([albumId])

model AlbumMidia {
  id           String         @id @default(cuid())
  municipioId  String
  nome         String         @db.VarChar(255)
  descricao    String?        @db.Text
  categoria    CategoriaMidia @default(OUTRO)
  capaid       String?        @db.VarChar(191)
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  midias       Midia[]

  @@index([municipioId])

// ─── schema-contabilidade.prisma ───
// ─────────────────────────────────────────────────────────────────────────────
// ERP MUNICIPAL — Módulo CONTABILIDADE
// Base legal:
//   Lei 4.320/1964 — Estatui normas gerais de direito financeiro para
//     elaboração e controle dos orçamentos e balanços da União, Estados,
//     Municípios e DF
//   LC 101/2000 (LRF) — Lei de Responsabilidade Fiscal
//   NBCASP — Normas Brasileiras de Contabilidade Aplicadas ao Setor Público
//     (NBC T 16.1 a 16.11 / Resolução CFC 1.128/2008)
//   PCASP — Plano de Contas Aplicado ao Setor Público (STN/SOF)
//   Portaria STN 437/2012 — MCASP (Manual de Contabilidade Aplicada ao SP)
//   Lei 8.666/1993 e Lei 14.133/2021 — fase de liquidação e pagamento
// ─────────────────────────────────────────────────────────────────────────────

// ── Natureza da Conta (PCASP) ─────────────────────────────────────────────────
enum NaturezaConta {
  ATIVO           // 1 — Ativo
  PASSIVO         // 2 — Passivo
  PATRIMONIO_LQUIDO // 3 — Patrimônio Líquido / Saldo Patrimonial
  VARIACAO_PATRIMONIAL_AUMENTATIVA  // 4 — VPA
  VARIACAO_PATRIMONIAL_DIMINUTIVA   // 5 — VPD
  CONTROLE_ATIVO  // 7 — Controles devedores
  CONTROLE_PASSIVO // 8 — Controles credores

// ── Tipos de Lançamento ────────────────────────────────────────────────────────
enum TipoLancamento {
  DEBITO
  CREDITO

// ── Estágios da Despesa (Lei 4.320 Arts. 58-64) ───────────────────────────────
enum SituacaoEmpenho {
  EMITIDO        // Art. 58 — empenho emitido
  ANULADO        // empenho anulado total ou parcialmente
  LIQUIDADO      // Art. 63 — liquidação da despesa
  PAGO           // Art. 64 — pagamento
  INSCRITO_RP    // inscrito em restos a pagar

// ── Modalidade de Empenho (Lei 4.320 Art. 60) ─────────────────────────────────
enum ModalidadeEmpenho {
  ORDINARIO      // valor preciso e definitivo
  ESTIMATIVO     // quando o montante não pode ser determinado
  GLOBAL         // contratos ou ajustes de execução parcelada

// ── Tipos de Orçamento ────────────────────────────────────────────────────────
enum TipoOrcamento {
  LOA            // Lei Orçamentária Anual
  ABERTURA_CREDITO
  SUPLEMENTACAO
  REDUCAO
  TRANSPOSICAO
  REMANEJAMENTO

// ── Situação da Dotação ───────────────────────────────────────────────────────
enum SituacaoDotacao {
  ATIVA
  BLOQUEADA
  ENCERRADA

// ── Modelos ───────────────────────────────────────────────────────────────────

model ContaContabil {
  id              String   @id @default(cuid())
  municipioId     String
  codigo          String   // ex: 1.1.1.1.1.00.00 (PCASP 7 níveis)
  codigoPai       String?  // referência ao pai (redundante para queries)
  nome            String
  descricao       String?  @db.Text
  natureza        NaturezaConta
  nivel           Int      // 1-6 profundidade da conta
  analitica       Boolean  @default(false) // true = conta de lançamento
  aceitaLancamento Boolean @default(false)
  codigoFuncional String?  // classificação funcional programática
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  debitoItens     LancamentoItem[] @relation("DebitoItens")
  creditoItens    LancamentoItem[] @relation("CreditoItens")

  @@unique([municipioId, codigo])
  @@index([municipioId, natureza])
  @@index([codigoPai])
  @@map("contas_contabeis")

model ExercicioOrcamentario {
  id              String   @id @default(cuid())
  municipioId     String
  exercicio       Int      // ano (ex: 2026)
  descricao       String?
  status          String   @default("ABERTO") // ABERTO, ENCERRADO
  dataInicio      DateTime
  dataFim         DateTime
  criadoEm        DateTime @default(now())
  usuarioId       String

  dotacoes        Dotacao[]
  empenhos        Empenho[]
  lancamentos     Lancamento[]

  @@unique([municipioId, exercicio])
  @@index([municipioId])
  @@map("exercicios_orcamentarios")

model Dotacao {
  id                   String   @id @default(cuid())
  municipioId          String
  exercicioId          String
  // Classificação orçamentária completa
  unidadeOrcamentaria  String   // ex: 02.001 (Secretaria de Educação)
  funcao               String   // ex: 12 (Educação)
  subfuncao            String   // ex: 361
  programa             String   // ex: 0001
  acao                 String   // ex: 2001
  elementoDespesa      String   // ex: 3.1.90.11.00 (Vencimentos)
  fonteRecurso         String   // ex: 00 (Recursos Ordinários)
  // Descrições
  descricaoUnidade     String?
  descricaoElemento    String?
  // Valores
  valorDotacaoInicial  Float    @default(0)
  valorSuplementacao   Float    @default(0)
  valorReducao         Float    @default(0)
  situacao             SituacaoDotacao @default(ATIVA)
  criadoEm             DateTime @default(now())
  usuarioId            String

  exercicio            ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  empenhos             Empenho[]

  // Saldo calculado = dotacaoInicial + suplementacao - reducao - empenhos emitidos
  @@unique([municipioId, exercicioId, unidadeOrcamentaria, funcao, subfuncao, programa, acao, elementoDespesa, fonteRecurso])
  @@index([municipioId, exercicioId])
  @@map("dotacoes")

model Empenho {
  id                String   @id @default(cuid())
  municipioId       String
  numero            String   // ex: "2026NE000001"
  exercicioId       String
  dotacaoId         String
  fornecedorNome    String
  fornecedorCpfCnpj String?
  descricao         String   @db.Text
  modalidade        ModalidadeEmpenho @default(ORDINARIO)
  situacao          SituacaoEmpenho   @default(EMITIDO)
  valorOriginal     Float
  valorAnulado      Float    @default(0)
  valorLiquidado    Float    @default(0)
  valorPago         Float    @default(0)
  dataEmissao       DateTime @default(now())
  dataLiquidacao    DateTime?
  dataPagamento     DateTime?
  processoLicitatorio String? // referência ao processo licitatório
  contaContaId      String?  // conta a pagar destino
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  usuarioId         String

  exercicio         ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  dotacao           Dotacao  @relation(fields: [dotacaoId], references: [id])
  lancamentos       Lancamento[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([dotacaoId])
  @@map("empenhos")

model Lancamento {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String   // ex: "L2026000001"
  exercicioId     String
  empenhoId       String?  // opcional — lançamentos livres possíveis
  data            DateTime @default(now())
  historico       String   @db.Text // descrição do lançamento
  valor           Float
  tipoLancamento  TipoLancamento  // DEBITO ou CREDITO (do 1º item)
  criadoEm        DateTime @default(now())
  usuarioId       String

  exercicio       ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  empenho         Empenho? @relation(fields: [empenhoId], references: [id])
  itens           LancamentoItem[]

  @@unique([municipioId, numero])
  @@index([municipioId, data])
  @@map("lancamentos")

model LancamentoItem {
  id              String   @id @default(cuid())
  municipioId     String
  lancamentoId    String
  contaId         String
  tipo            TipoLancamento
  valor           Float
  ordem           Int      @default(0)

  lancamento      Lancamento      @relation(fields: [lancamentoId], references: [id])
  contaDebito     ContaContabil   @relation("DebitoItens",  fields: [contaId], references: [id])
  contaCredito    ContaContabil   @relation("CreditoItens", fields: [contaId], references: [id])

  @@index([lancamentoId])
  @@index([contaId])
  @@map("lancamento_itens")

model RegraContabilizacao {
  id              String   @id @default(cuid())
  municipioId     String
  codigo          String
  descricao       String
  // Fórmula do lançamento padrão
  contaDebitoId   String?
  contaCreditoId  String?
  contaDebito     String?  // código da conta
  contaCredito    String?  // código da conta
  naturezaDespesa String?  // filtro por elemento
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  @@unique([municipioId, codigo])
  @@map("regras_contabilizacao")

// ─── schema-core.prisma ───
// ─── CORE — Schema compartilhado (auth, RBAC, audit) ─────────────────────────
// Este arquivo define os modelos de base que todos os módulos referenciam.
// Em produção, todos os schemas são concatenados em um único schema.prisma.
  url      = env("DATABASE_URL")

// ─── Município (tenant raiz) ──────────────────────────────────────────────────

model Municipio {
  id        String   @id @default(cuid())
  nome      String
  uf        String   @db.Char(2)
  ibge      String   @unique            // código IBGE 7 dígitos
  cnpj      String?  @unique
  slug      String   @unique            // "biritinga" → biritinga.ba.gov.br
  dominio   String?                     // domínio personalizado
  logoUrl   String?
  corPrimaria String? @db.Char(7)       // "#1a56db"
  ativo     Boolean  @default(true)
  plano     String   @default("basico") // "basico" | "pro" | "enterprise"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  perfis    Perfil[]
  auditLogs AuditLog[]
  sessoes   Sessao[]

// ─── Usuário ──────────────────────────────────────────────────────────────────

enum PerfilPadrao {
  SUPER_ADMIN       // Anthropic / suporte — acesso total
  ADMIN_MUNICIPIO   // Secretário ou TI do município
  GESTOR            // gerente de secretaria
  OPERADOR          // servidor comum
  VISUALIZADOR      // somente leitura
  PORTAL_CIDADAO    // usuário externo (cidadão)

model Usuario {
  id            String       @id @default(cuid())
  municipioId   String
  nome          String
  email         String
  senhaHash     String
  cpf           String?
  telefone      String?
  cargo         String?
  secretaria    String?
  perfil        PerfilPadrao @default(OPERADOR)
  perfilId      String?      // Perfil customizado (sobrescreve perfil padrão)
  ativo         Boolean      @default(true)
  mfaAtivado    Boolean      @default(false)
  mfaSegredo    String?
  ultimoLogin   DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte  DateTime?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  municipio     Municipio    @relation(fields: [municipioId], references: [id])
  perfilCustom  Perfil?      @relation(fields: [perfilId], references: [id])
  sessoes       Sessao[]
  auditLogs     AuditLog[]

  @@unique([municipioId, email])
  @@unique([municipioId, cpf])
  @@index([municipioId, perfil])
  @@index([municipioId, secretaria])

// ─── Perfil de acesso customizável ───────────────────────────────────────────

model Perfil {
  id          String   @id @default(cuid())
  municipioId String
  nome        String                // "Procurador Chefe", "Fiscal de Obras"
  descricao   String?
  permissoes  String   @db.Text     // JSON: ["pgm:processo:create","semob:obra:read",...]
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuarios    Usuario[]

  @@unique([municipioId, nome])
  @@index([municipioId])

// ─── Sessão / Refresh token ───────────────────────────────────────────────────

model Sessao {
  id            String    @id @default(cuid())
  municipioId   String
  usuarioId     String
  refreshToken  String    @db.Text  // hash do refresh token
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  municipio     Municipio @relation(fields: [municipioId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([municipioId, expiresAt])

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  municipioId String
  usuarioId   String?
  acao        String   // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "EXPORT"
  modulo      String   // "semad" | "sefin" | "pgm" | "auth" | ...
  recurso     String   // "usuario" | "obra" | "processo" | ...
  registroId  String?  // ID do registro afetado
  dadosAntigos String? @db.LongText  // JSON before
  dadosNovos   String? @db.LongText  // JSON after
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([municipioId, modulo, createdAt])
  @@index([municipioId, usuarioId])
  @@index([registroId])

// ─── Token de redefinição de senha ───────────────────────────────────────────

model TokenResetSenha {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiresAt DateTime
  usadoEm   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])

// ─── schema-educacao.prisma ───
// ─── ERP Municipal — Módulo EDUCAÇÃO MUNICIPAL ────────────────────────────────
// Lei 9.394/1996 — LDB (Lei de Diretrizes e Bases da Educação Nacional)
// EC 14/1996 — criação do FUNDEF (substituído pelo FUNDEB)
// EC 53/2006 — criação do FUNDEB (Fundo de Manutenção e Desenvolvimento
//   da Educação Básica e de Valorização dos Profissionais da Educação)
// EC 108/2020 — FUNDEB permanente; mínimo 70% para remuneração de professores
// Lei 11.494/2007 — regulamenta o FUNDEB
// Lei 11.947/2009 — alimentação escolar (PNAE): mín. 30% do FNDE para ag. local
// Lei 10.880/2004 — PNATE (transporte escolar)
// CF/88 Art. 212 — municípios: mín. 25% da receita em educação
// Lei 9.503/1997 — CTB Art. 136 — transporte escolar
// Resolução CD/FNDE 6/2020 — PNAE categorias de alimentos
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum EtapaEnsino {
  CRECHE             // 0-3 anos (EI)
  PRE_ESCOLA         // 4-5 anos (EI)
  FUNDAMENTAL_I      // 1º-5º ano (EF)
  FUNDAMENTAL_II     // 6º-9º ano (EF)
  EJA_FUNDAMENTAL    // EJA — Educação de Jovens e Adultos
  EJA_MEDIO          // parceria com Estado
  AEE                // Atendimento Educacional Especializado

enum TurnoTurma {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL

enum SituacaoMatricula {
  ATIVA
  TRANSFERIDA
  DESISTENTE
  CONCLUINTE
  CANCELADA
  AGUARDANDO    // lista de espera

enum SituacaoEscola {
  ATIVA
  DESATIVADA
  REFORMA

enum CategoriaMerenda {
  CAFE_DA_MANHA
  ALMOCO
  LANCHE_TARDE
  JANTAR

enum TipoTransporte {
  ONIBUS
  VAN
  MICRO_ONIBUS
  BARCO          // transporte fluvial (ribeirinho)

// ─── Escola ───────────────────────────────────────────────────────────────────

model Escola {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  inep        String?  // Código INEP (MEC)
  situacao    SituacaoEscola @default(ATIVA)

  cep         String?
  logradouro  String?
  bairro      String?
  zona        String?  // URBANA/RURAL
  telefone    String?
  email       String?

  diretor     String?
  secretario  String?

  // Capacidade
  salas       Int?
  capacidadeTotal Int?

  turmas      Turma[]
  servidores  ServidorEducacao[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, situacao])

// ─── Servidor de Educação ─────────────────────────────────────────────────────
// EC 108/2020 — mín. 70% do FUNDEB para remuneração de professores

model ServidorEducacao {
  id          String   @id @default(cuid())
  escolaId    String
  municipioId String

  nome        String
  cpf         String?
  cargo       String   // PROFESSOR/DIRETOR/COORDENADOR/MERENDEIRA/AUXILIAR
  disciplina  String?  // para professores
  formacao    String?  // licenciatura, especialização…
  habilitacao String?  // área de habilitação
  regime      String?  // CLT/ESTATUTARIO
  cargaHoraria Int?    // horas semanais
  ativo       Boolean  @default(true)

  escola      Escola @relation(fields: [escolaId], references: [id])
  turmas      TurmaServidor[]

  criadoEm    DateTime @default(now())

  @@index([escolaId])
  @@index([municipioId])

// ─── Turma ────────────────────────────────────────────────────────────────────

model Turma {
  id          String   @id @default(cuid())
  escolaId    String
  municipioId String

  codigo      String   // ex: "1A", "2B"
  etapa       EtapaEnsino
  ano         Int      // ano letivo
  serie       String?  // "1º Ano", "5º Ano"…
  turno       TurnoTurma
  capacidade  Int
  sala        String?

  professores TurmaServidor[]
  matriculas  Matricula[]
  frequencias RegistroFrequencia[]

  escola      Escola @relation(fields: [escolaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([escolaId, codigo, ano])
  @@index([escolaId])
  @@index([municipioId, ano])
  @@index([municipioId, etapa])

model TurmaServidor {
  id          String @id @default(cuid())
  turmaId     String
  servidorId  String
  disciplina  String?
  turma       Turma   @relation(fields: [turmaId], references: [id])
  servidor    ServidorEducacao @relation(fields: [servidorId], references: [id])
  @@unique([turmaId, servidorId])

// ─── Aluno ────────────────────────────────────────────────────────────────────

model Aluno {
  id          String   @id @default(cuid())
  municipioId String

  nome        String
  cpf         String?
  dataNascimento DateTime?
  sexo        String?
  nomeMae     String?
  nomePai     String?
  responsavel String?
  telefoneResponsavel String?
  logradouro  String?
  bairro      String?
  zona        String?  // URBANA/RURAL — para transporte
  nee         Boolean  @default(false)  // necessidades educacionais especiais
  laudoNEE    String?  // CID da deficiência
  ativo       Boolean  @default(true)

  matriculas  Matricula[]
  frequencias RegistroFrequencia[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([municipioId, bairro])

// ─── Matrícula ────────────────────────────────────────────────────────────────

model Matricula {
  id          String   @id @default(cuid())
  alunoId     String
  turmaId     String
  municipioId String

  anoLetivo   Int
  situacao    SituacaoMatricula @default(ATIVA)
  dataMatricula DateTime @default(now())
  dataTransferencia DateTime?
  motivoTransferencia String?
  escolaDestino String?
  numeroChamada Int?

  aluno       Aluno @relation(fields: [alunoId], references: [id])
  turma       Turma @relation(fields: [turmaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([alunoId, turmaId, anoLetivo])
  @@index([turmaId])
  @@index([municipioId, anoLetivo])
  @@index([municipioId, situacao])

// ─── Registro de Frequência ───────────────────────────────────────────────────
// LDB Art. 24 VI — frequência mínima de 75% para aprovação

model RegistroFrequencia {
  id          String   @id @default(cuid())
  turmaId     String
  alunoId     String
  municipioId String

  data        DateTime
  presente    Boolean
  justificada Boolean  @default(false)
  observacao  String?

  turma       Turma @relation(fields: [turmaId], references: [id])
  aluno       Aluno @relation(fields: [alunoId], references: [id])

  criadoEm    DateTime @default(now())

  @@unique([turmaId, alunoId, data])
  @@index([turmaId, data])
  @@index([alunoId])
  @@index([municipioId])

// ─── Merenda Escolar ──────────────────────────────────────────────────────────
// PNAE — Lei 11.947/2009
// Mín. 30% do FNDE para aquisição de produtos da agricultura familiar
// Resolução CD/FNDE 6/2020 — cardápio saudável

model CardapioMerenda {
  id          String   @id @default(cuid())
  escolaId    String?  // null = cardápio geral de todas as escolas
  municipioId String

  semana      String   // "2026-W43" (semana ISO)
  diaSemana   String   // "SEGUNDA"/"TERCA"/"QUARTA"/"QUINTA"/"SEXTA"
  categoria   CategoriaMerenda
  descricao   String   // ex: "Arroz, feijão, frango grelhado, salada"
  calorias    Int?
  agriculturaFamiliar Boolean @default(false)

  criadoEm    DateTime @default(now())

  @@unique([municipioId, semana, diaSemana, categoria])
  @@index([municipioId, semana])

// ─── Transporte Escolar ───────────────────────────────────────────────────────
// PNATE — Lei 10.880/2004
// CTB Art. 136 — requisitos para transporte escolar

model VeiculoTransporte {
  id          String   @id @default(cuid())
  municipioId String

  placa       String
  tipo        TipoTransporte
  marca       String?
  modelo      String?
  anoFabricacao Int?
  capacidade  Int
  motorista   String?
  monitorNome String?
  rota        String?
  kmRota      Decimal? @db.Decimal(8,2)
  ativo       Boolean  @default(true)

  // Documentação
  vencimentoCNH    DateTime?
  vencimentoCRLV   DateTime?
  vencimentoVistoria DateTime?
  aptoTransporte   Boolean @default(false) // Art. 136 CTB

  alunos      TransporteAluno[]

  criadoEm    DateTime @default(now())

  @@index([municipioId])

model TransporteAluno {
  id          String @id @default(cuid())
  veiculoId   String
  alunoId     String
  municipioId String
  rota        String?
  pontoEmbarque String?

  veiculo     VeiculoTransporte @relation(fields: [veiculoId], references: [id])

  @@unique([veiculoId, alunoId])
  @@index([municipioId])

// ─── FUNDEB ───────────────────────────────────────────────────────────────────
// EC 108/2020 — FUNDEB permanente
// Lei 14.113/2020 — regulamentação do FUNDEB permanente
// Mín. 70% para remuneração de professores (Art. 26)
// Complementação federal quando estado/município abaixo do valor mínimo por aluno

model RepaseFUNDEB {
  id          String   @id @default(cuid())
  municipioId String

  mes         String   // "2026-10"
  competencia Int      // ano
  valorRepasse Decimal @db.Decimal(15,2)
  valorFundeb  Decimal @db.Decimal(15,2)  // contribuição do município
  saldo        Decimal @db.Decimal(15,2)  // repasse - contribuição
  matriculasApuradas Int
  valorPorAluno Decimal? @db.Decimal(10,4)

  // Aplicação obrigatória — EC 108/2020
  aplicacaoProfessores Decimal? @db.Decimal(15,2)  // mín. 70%
  pctProfessores Decimal? @db.Decimal(5,2)
  alertaProfessores Boolean @default(false)  // < 70%

  criadoEm    DateTime @default(now())

  @@unique([municipioId, mes])
  @@index([municipioId, competencia])

// ─── schema-esic.prisma ───
// ─── ERP Municipal Biritinga — Módulo e-SIC ──────────────────────────────────
// Lei 12.527/2011 — Lei de Acesso à Informação (LAI)
// Decreto 7.724/2012 — Regulamentação federal
// Art. 11: prazo 20 dias úteis + prorrogação 10 dias (justificada)
// Art. 15: recurso 1ª instância em 10 dias; Art. 16: CGU 5 dias; Art. 20: comissão
// Decreto 10.408/2020: transparência proativa, dados abertos

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — PEDIDO DE ACESSO
// ═══════════════════════════════════════════════════════════════════════════════

enum SituacaoPedido {
  RECEBIDO          // Protocolo gerado; prazo inicia D+1 útil
  EM_TRAMITACAO     // Encaminhado ao setor responsável
  AGUARDANDO_SETOR  // Setor notificado, aguarda resposta interna
  RESPONDIDO        // Resposta emitida dentro do prazo
  RESPONDIDO_TARDIO // Resposta emitida após prazo legal
  PRORROGADO        // Prorrogação de 10 dias justificada (Art. 11 §2)
  INDEFERIDO        // Negado — motivo legal obrigatório
  PARCIALMENTE_ATENDIDO // Parte concedida, parte negada
  RECURSO_ABERTO    // Requerente abriu recurso
  ENCERRADO

enum TipoSolicitante {
  PESSOA_FISICA
  PESSOA_JURIDICA
  ANONIMO          // LAI permite pedido anônimo

enum FormaEntrega {
  EMAIL
  CORREIO
  PORTAL_ESIC
  PRESENCIAL

enum MotivoIndeferimento {
  // Art. 23 LAI — informações sigilosas
  INFORMACAO_SIGILOSA_GRAU_1    // reservada
  INFORMACAO_SIGILOSA_GRAU_2    // secreta
  INFORMACAO_SIGILOSA_GRAU_3    // ultrassecreta
  DADO_PESSOAL                  // Art. 31 — privacidade
  SEGREDO_INDUSTRIA             // segredo industrial/comercial
  // Art. 13 Decreto 7.724
  PEDIDO_GENERICO               // demasiado genérico, sem objeto claro
  TRABALHO_PRODUCAO             // exige análise/produção de dados inexistentes
  INFORMACAO_INEXISTENTE        // não há dados sobre o assunto
  INFORMACAO_PUBLICA            // já disponível ao público
  OUTRO

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — RECURSO
// ═══════════════════════════════════════════════════════════════════════════════

enum InstanciaRecurso {
  PRIMEIRA_INSTANCIA    // Órgão que indeferiu — 10 dias p/ decidir (Art. 15)
  SEGUNDA_INSTANCIA     // Autoridade hierárquica — 5 dias
  TERCEIRA_INSTANCIA    // CGU/equivalente estadual — 5 dias (Art. 16)
  CGM_TCM               // Tribunal de Contas / Controladoria (municipal)

enum SituacaoRecurso {
  RECEBIDO
  EM_ANALISE
  PROVIDO             // Acesso concedido via recurso
  PARCIALMENTE_PROVIDO
  IMPROVIDO           // Mantido o indeferimento
  DESISTIDO

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — TRANSPARÊNCIA ATIVA
// ═══════════════════════════════════════════════════════════════════════════════

enum TipoTransparencia {
  // Art. 8 LAI — obrigatórios
  ESTRUTURA_ORGANIZACIONAL      // organograma, competências
  ACOES_PROGRAMAS               // planos, projetos, programas
  LICITACOES_CONTRATOS          // editais, contratos, aditivos
  REPASSES_TRANSFERENCIAS       // convênios, subvenções, auxílios
  RECEITAS_DESPESAS             // execução orçamentária diária
  OBRAS_PUBLICAS                // andamento de obras
  SERVIDORES                    // quadro, remuneração
  RESPOSTAS_PERGUNTAS_FREQUENTES
  // Complementares
  DIARIO_OFICIAL
  RELATORIO_GESTAO
  CONTAS_PUBLICAS               // balanços, audiências públicas
  NOTA_IMPRENSA

enum SituacaoTransparencia {
  RASCUNHO
  PUBLICADO
  DESATUALIZADO     // venceu o prazo de atualização
  ARQUIVADO

// ═══════════════════════════════════════════════════════════════════════════════
// PEDIDO DE ACESSO À INFORMAÇÃO
// ═══════════════════════════════════════════════════════════════════════════════

model PedidoAcesso {
  id                  String              @id @default(cuid())
  municipioId         String
  protocolo           String              // "SIC-2026-0001"
  situacao            SituacaoPedido      @default(RECEBIDO)

  // Solicitante
  tipoSolicitante     TipoSolicitante     @default(PESSOA_FISICA)
  nomeRequerente      String?             // null = anônimo
  cpfCnpjRequerente   String?
  emailRequerente     String?
  telefoneRequerente  String?
  enderecoRequerente  String?

  // Pedido
  assunto             String              // resumo do pedido
  descricaoPedido     String              @db.Text
  palavrasChave       String?             // para indexação
  setorDestinatario   String?             // secretaria responsável
  formaEntrega        FormaEntrega        @default(EMAIL)

  // Prazos legais (Art. 11 LAI)
  dataProtocolo       DateTime            @default(now())
  dataLimiteResposta  DateTime            // D+20 úteis
  dataProrrogacaoFim  DateTime?           // D+30 úteis (se prorrogado)
  dataResposta        DateTime?

  // Prorrogação (Art. 11 §2)
  prorrogado          Boolean             @default(false)
  motivoProrrogacao   String?

  // Resposta
  textoResposta       String?             @db.Text
  formaResposta       FormaEntrega?
  urlDocumento        String?             // arquivo anexado
  tecnicoResponsavel  String?
  setorResposavel     String?

  // Indeferimento
  motivoIndeferimento MotivoIndeferimento?
  fundamentoLegal     String?             // "Art. 23, I, Lei 12.527/2011"

  // Métricas
  diasResposta        Int?                // dias úteis efetivos
  dentroDoPrazo       Boolean?

  // Classificação temática
  tematico            String?             // tema: orçamento, saúde, educação…

  observacoesInternas String?             @db.Text
  usuarioId           String?
  criadoEm            DateTime            @default(now())
  atualizadoEm        DateTime            @updatedAt

  tramitacoes         TramitacaoPedido[]
  recursos            RecursoPedido[]

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, dataLimiteResposta])
  @@index([municipioId, setorDestinatario])

// ─── Tramitação interna ───────────────────────────────────────────────────────

model TramitacaoPedido {
  id              String       @id @default(cuid())
  municipioId     String
  pedidoId        String
  pedido          PedidoAcesso @relation(fields: [pedidoId], references: [id])
  despacho        String       @db.Text
  setorOrigem     String?
  setorDestino    String?
  usuarioId       String?
  criadoEm        DateTime     @default(now())

  @@index([pedidoId])

// ═══════════════════════════════════════════════════════════════════════════════
// RECURSO
// ═══════════════════════════════════════════════════════════════════════════════

model RecursoPedido {
  id                String          @id @default(cuid())
  municipioId       String
  pedidoId          String
  pedido            PedidoAcesso    @relation(fields: [pedidoId], references: [id])
  instancia         InstanciaRecurso
  situacao          SituacaoRecurso @default(RECEBIDO)
  numero            String          // "REC-2026-001"

  // Requerente (pode ser diferente do pedido original)
  nomeRecorrente    String?
  motivoRecurso     String          @db.Text

  // Prazos (Art. 15 — 10 dias para a 1ª instância decidir)
  dataProtocolo     DateTime        @default(now())
  dataLimiteDecisao DateTime        // D+10 dias corridos (1ª inst.) ou D+5 (2ª/3ª)
  dataDecisao       DateTime?

  // Decisão
  textoDecisao      String?         @db.Text
  autoridade        String?         // quem decidiu
  dentroDoPrazo     Boolean?

  usuarioId         String?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  @@unique([municipioId, numero])
  @@index([pedidoId])
  @@index([municipioId, situacao])

// ═══════════════════════════════════════════════════════════════════════════════
// TRANSPARÊNCIA ATIVA (Art. 8 LAI)
// ═══════════════════════════════════════════════════════════════════════════════

model TransparenciaAtiva {
  id                String                @id @default(cuid())
  municipioId       String
  tipo              TipoTransparencia
  situacao          SituacaoTransparencia @default(RASCUNHO)

  titulo            String
  descricao         String                @db.Text
  conteudo          String?               @db.LongText // HTML ou Markdown
  urlExterna        String?               // link para portal externo
  urlArquivo        String?               // PDF, planilha…
  periodoCoberto    String?               // "Jan-Jun/2026", "2026"

  // Periodicidade (Art. 8 §3)
  periodicidade     String?               // "Diária", "Mensal", "Anual"
  dataProximaAtualizacao DateTime?
  dataUltimaAtualizacao  DateTime?

  // SEO / indexação
  palavrasChave     String?
  secretaria        String?

  publicadoEm       DateTime?
  visualizacoes     Int                   @default(0)
  downloads         Int                   @default(0)

  usuarioId         String?
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt

  @@index([municipioId, tipo])
  @@index([municipioId, situacao])

// ═══════════════════════════════════════════════════════════════════════════════
// ESTATÍSTICAS SIC (relatório anual — Art. 45 LAI)
// ═══════════════════════════════════════════════════════════════════════════════

model RelatorioSIC {
  id              String    @id @default(cuid())
  municipioId     String
  exercicio       Int       // ano de referência
  totalPedidos    Int
  totalRespondidos Int
  totalIndeferidos Int
  totalRecursos   Int
  mediaRespostaDias Decimal @db.Decimal(5,2)
  percentualNoPrazo Decimal @db.Decimal(5,2)
  porSetor        Json?     // { secretaria: count }
  porTema         Json?     // { tema: count }
  publicado       Boolean   @default(false)
  criadoEm        DateTime  @default(now())

  @@unique([municipioId, exercicio])

// ─── schema-folha.prisma ───
// ─── FOLHA DE PAGAMENTO MUNICIPAL ─────────────────────────────────────────────
// Lei 8.112/1990 — Regime Jurídico dos Servidores Públicos Federais (referência)
// LC 101/2000 Art. 19-23 — Limite de gasto com pessoal (60% RCL municípios)
// Lei 9.717/1998 — Regras previdência servidores públicos
// INSS: faixas Portaria MF 2024 · IRPF: faixas Lei 11.482/2007 atualizada
// FGTS: apenas CLT/contratados (não estatutários)

// ─── Competência (mês/ano de folha) ──────────────────────────────────────────
model FolhaCompetencia {
  id           String              @id @default(cuid())
  municipioId  String
  mes          Int                 // 1-12
  ano          Int
  status       StatusFolha         @default(ABERTA)
  totalBruto   Decimal             @default(0) @db.Decimal(14, 2)
  totalDescontos Decimal           @default(0) @db.Decimal(14, 2)
  totalLiquido Decimal             @default(0) @db.Decimal(14, 2)
  totalServidores Int              @default(0)
  observacao   String?             @db.Text
  fechadaEm    DateTime?
  fechadaPor   String?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  holerites    FolhaHolerite[]

  @@unique([municipioId, mes, ano])
  @@index([municipioId, status])
  @@map("folha_competencia")

enum StatusFolha {
  ABERTA
  EM_CALCULO
  CALCULADA
  FECHADA
  CANCELADA

// ─── Rubrica (tipo de verba) ───────────────────────────────────────────────────
model FolhaRubrica {
  id           String       @id @default(cuid())
  municipioId  String
  codigo       String       // ex: "0001", "1001"
  nome         String       // ex: "Vencimento Base", "INSS", "IRPF"
  tipo         TipoRubrica
  natureza     NaturezaRubrica @default(FIXO)
  formula      String?      @db.Text  // ex: "PERCENTUAL:11" ou "TABELA_INSS"
  percentual   Decimal?     @db.Decimal(6, 4)   // se percentual fixo
  valor        Decimal?     @db.Decimal(12, 2)  // se valor fixo
  incideInss   Boolean      @default(false)
  incideIrpf   Boolean      @default(false)
  incideFgts   Boolean      @default(false)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())

  itens        FolhaHoleriteItem[]

  @@unique([municipioId, codigo])
  @@map("folha_rubrica")

enum TipoRubrica {
  PROVENTO      // vencimentos, gratificações, adicionais
  DESCONTO      // INSS, IRPF, consignações, faltas
  INFORMATIVO   // FGTS, base cálculo (não entra no líquido)

enum NaturezaRubrica {
  FIXO          // valor/percentual constante
  VARIAVEL      // lançado manualmente a cada mês
  AUTOMATICO    // calculado por fórmula (INSS, IRPF, FGTS)

// ─── Holerite (folha individual do servidor por competência) ──────────────────
model FolhaHolerite {
  id             String           @id @default(cuid())
  municipioId    String
  competenciaId  String
  servidorId     String           // referência ao modelo Servidor do módulo RH
  matricula      String
  nomeServidor   String           // desnormalizado para histórico
  cargo          String?
  lotacao        String?          // secretaria/departamento
  regimeJuridico RegimeJuridico   @default(ESTATUTARIO)

  // Totais calculados
  totalProventos   Decimal        @default(0) @db.Decimal(12, 2)
  totalDescontos   Decimal        @default(0) @db.Decimal(12, 2)
  totalLiquido     Decimal        @default(0) @db.Decimal(12, 2)
  baseFgts         Decimal        @default(0) @db.Decimal(12, 2)
  baseInss         Decimal        @default(0) @db.Decimal(12, 2)
  baseIrpf         Decimal        @default(0) @db.Decimal(12, 2)

  // Dias trabalhados
  diasTrabalhados  Int            @default(30)
  diasFaltas       Int            @default(0)
  diasAfastamento  Int            @default(0)

  status           StatusHolerite @default(RASCUNHO)
  observacao       String?        @db.Text
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  competencia    FolhaCompetencia @relation(fields: [competenciaId], references: [id])
  itens          FolhaHoleriteItem[]

  @@unique([competenciaId, servidorId])
  @@index([municipioId, competenciaId])
  @@index([municipioId, servidorId])
  @@map("folha_holerite")

enum RegimeJuridico {
  ESTATUTARIO   // Lei 8.112/90 estilo — sem FGTS
  CLT           // com FGTS
  COMISSIONADO  // cargo em comissão
  ESTAGIARIO

enum StatusHolerite {
  RASCUNHO
  CALCULADO
  CONFIRMADO
  ESTORNADO

// ─── Item do Holerite (cada rubrica lançada) ──────────────────────────────────
model FolhaHoleriteItem {
  id           String         @id @default(cuid())
  holeriteId   String
  rubricaId    String
  referencia   String?        // ex: "30 dias", "11%", "3 faltas"
  valor        Decimal        @db.Decimal(12, 2)
  tipo         TipoRubrica    // duplicado para evitar JOIN em relatórios

  holerite   FolhaHolerite @relation(fields: [holeriteId], references: [id], onDelete: Cascade)
  rubrica    FolhaRubrica  @relation(fields: [rubricaId], references: [id])

  @@index([holeriteId])
  @@map("folha_holerite_item")

// ─── schema-frota.prisma ───
// ─── FROTA E VEÍCULOS ─────────────────────────────────────────────────────────
// CTB Lei 9.503/1997 — habilitação obrigatória por categoria
// CONTRAN Resolução 952/2022 — licenciamento anual
// DENATRAN — código RENAVAM único por veículo
// Soft-delete via campo `ativo`

enum TipoVeiculo {
  CARRO
  CAMINHONETE
  VAN
  MICRO_ONIBUS
  ONIBUS
  CAMINHAO
  CAMINHAO_PIPA
  TRATOR
  RETROESCAVADEIRA
  MOTONIVELADORA
  MOTOCICLETA
  BICICLETA_ELETRICA
  BARCO
  OUTRO

enum CombustivelTipo {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV
  FLEX
  ELETRICO
  HIBRIDO

enum SituacaoVeiculo {
  ATIVO
  EM_MANUTENCAO
  AGUARDANDO_MANUTENCAO
  INATIVO
  SINISTRADO
  ALIENADO

enum CategoriaHabilitacao {
  A   // motos
  B   // carros
  C   // caminhões leves
  D   // ônibus/vans
  E   // caminhões com reboque
  AB
  AC
  AD
  AE

enum SituacaoMotorista {
  ATIVO
  AFASTADO
  FERIAS
  INATIVO

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
  REVISAO
  PNEUS
  FUNILARIA
  ELETRICA
  VISTORIA
  OUTRO

enum SituacaoManutencao {
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA

enum SituacaoAgendamento {
  AGENDADO
  EM_USO
  CONCLUIDO
  CANCELADO

model Veiculo {
  id           String         @id @default(cuid())
  municipioId  String
  placa        String
  renavam      String?
  chassi       String?
  tipo         TipoVeiculo
  marca        String
  modelo       String
  anoFab       Int
  anoMod       Int
  cor          String?
  combustivel  CombustivelTipo
  capacidade   Int?           // passageiros ou toneladas
  hodometro    Int            @default(0)  // km atual
  situacao     SituacaoVeiculo @default(ATIVO)
  secretaria   String?        // lotação/secretaria responsável
  patrimonio   String?        // número patrimonial
  seguradora   String?
  apolice      String?
  vencSeguro   DateTime?
  vencLicenciamento DateTime?
  vencCRLV     DateTime?
  observacoes  String?        @db.Text
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  abastecimentos Abastecimento[]
  manutencoes    Manutencao[]
  agendamentos   Agendamento[]

  @@unique([municipioId, placa])
  @@index([municipioId, situacao])
  @@index([municipioId, ativo])

model Motorista {
  id              String              @id @default(cuid())
  municipioId     String
  nome            String
  cpf             String
  matricula       String?
  telefone        String?
  email           String?
  cnh             String              // número da CNH
  categoriaCnh    CategoriaHabilitacao
  vencimentoCnh   DateTime
  dataAdmissao    DateTime?
  secretaria      String?
  situacao        SituacaoMotorista   @default(ATIVO)
  observacoes     String?             @db.Text
  ativo           Boolean             @default(true)
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  agendamentos    Agendamento[]

  @@unique([municipioId, cpf])
  @@unique([municipioId, cnh])
  @@index([municipioId, situacao])

model Abastecimento {
  id              String          @id @default(cuid())
  municipioId     String
  veiculoId       String
  motoristaId     String?
  dataAbast       DateTime
  hodometro       Int             // km no momento do abastecimento
  kmRodados       Int?            // calculado: hodometro - último hodometro
  combustivel     CombustivelTipo
  litros          Decimal         @db.Decimal(8, 3)
  valorLitro      Decimal         @db.Decimal(6, 3)
  valorTotal      Decimal         @db.Decimal(10, 2)
  consumoKmL      Decimal?        @db.Decimal(6, 2)  // km/L calculado
  posto           String?
  nfNumero        String?
  observacoes     String?         @db.Text
  usuarioId       String?
  criadoEm        DateTime        @default(now())

  veiculo         Veiculo         @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, veiculoId])
  @@index([municipioId, dataAbast])

model Manutencao {
  id              String              @id @default(cuid())
  municipioId     String
  veiculoId       String
  tipo            TipoManutencao
  situacao        SituacaoManutencao  @default(AGUARDANDO)
  descricao       String              @db.Text
  oficina         String?
  responsavel     String?
  hodometroEntrada Int?
  hodometroSaida   Int?
  dataEntrada     DateTime
  dataSaida       DateTime?
  dataConclusao   DateTime?
  orcamento       Decimal?            @db.Decimal(10, 2)
  valorFinal      Decimal?            @db.Decimal(10, 2)
  nfNumero        String?
  pecasUtilizadas String?             @db.Text  // JSON livre
  observacoes     String?             @db.Text
  usuarioId       String?
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  veiculo         Veiculo             @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, veiculoId])
  @@index([municipioId, situacao])

model Agendamento {
  id              String              @id @default(cuid())
  municipioId     String
  veiculoId       String
  motoristaId     String?
  solicitante     String
  secretoriaSolic String?
  destino         String
  finalidade      String              @db.Text
  dataSaida       DateTime
  dataRetornoPrev DateTime
  dataRetornoReal DateTime?
  hodometroSaida  Int?
  hodometroRetorno Int?
  kmPercorrido    Int?                // calculado no retorno
  situacao        SituacaoAgendamento @default(AGENDADO)
  observacoes     String?             @db.Text
  usuarioId       String?
  criadoEm        DateTime            @default(now())
  atualizadoEm    DateTime            @updatedAt

  veiculo         Veiculo             @relation(fields: [veiculoId], references: [id])
  motorista       Motorista?          @relation(fields: [motoristaId], references: [id])

  @@index([municipioId, veiculoId])
  @@index([municipioId, dataSaida])
  @@index([municipioId, situacao])

// ─── schema-frota.prisma ───
// ─── FROTA MUNICIPAL ──────────────────────────────────────────────────────────
// Resolução CONTRAN 996/2023 — CNH categorias e habilitação
// CTB Lei 9.503/1997 — Código de Trânsito Brasileiro
// Resolução ANP 20/2015 — controle de combustível setor público
// Lei 8.666/1993 Art. 24 II — dispensa de licitação serviços manutenção
// Portaria MPOG 349/2014 — gestão de frota de veículos oficiais
  url      = env("DATABASE_URL")

enum TipoVeiculo {
  AUTOMOVEL       // Carros de passeio
  CAMINHONETE     // Pickup
  CAMINHAO        // Carga pesada
  ONIBUS          // Transporte coletivo
  MICROONIBUS     // Van / micro-ônibus
  MOTOCICLETA     // Motos
  TRATOR          // Maquinário agrícola
  RETROESCAVADEIRA
  PA_CARREGADEIRA
  AMBULANCIA
  OUTRO

enum CombustivelTipo {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV         // Gás Natural Veicular
  FLEX
  ELETRICO

enum SituacaoVeiculo {
  ATIVO
  EM_MANUTENCAO
  AGUARDANDO_MANUTENCAO
  CEDIDO
  SINISTRO
  BAIXADO

enum SituacaoMotorista {
  ATIVO
  AFASTADO
  FERIAS
  INATIVO

enum TipoManutencao {
  PREVENTIVA      // Manutenção programada
  CORRETIVA       // Conserto de falha
  REVISAO         // Revisão periódica
  PNEU
  FUNILARIA
  ELETRICA
  OUTRO

enum StatusManutencao {
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA

model Veiculo {
  id               String          @id @default(cuid())
  municipioId      String
  placa            String          // AAA-9999 ou Mercosul
  renavam          String?
  chassi           String?
  tipo             TipoVeiculo
  marca            String
  modelo           String
  anoFabricacao    Int
  anoModelo        Int
  cor              String
  combustivel      CombustivelTipo
  situacao         SituacaoVeiculo @default(ATIVO)

  // Gestão
  numeroBem        String?         // Número patrimonial
  setorResponsavel String?
  motoristaPadrao  String?         // Nome do motorista padrão

  // Quilometragem
  kmAtual          Int             @default(0)
  kmProximaRevisao Int?

  // Documentação (CTB)
  dataLicenciamento DateTime?
  vencimentoCRLV    DateTime?      // Certificado de Registro e Licenciamento
  vencimentoSeguro  DateTime?

  // Rastreamento / consumo médio
  consumoMedio     Decimal?        @db.Decimal(6,2)  // km/l
  capacidadeTanque Decimal?        @db.Decimal(6,2)  // litros

  ativo            Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  abastecimentos   Abastecimento[]
  manutencoes      Manutencao[]
  utilizacoes      UtilizacaoVeiculo[]

  @@unique([municipioId, placa])
  @@index([municipioId, situacao])
  @@map("veiculos")

model Motorista {
  id                String            @id @default(cuid())
  municipioId       String
  nome              String
  cpf               String
  matricula         String?
  cargo             String?
  setor             String?
  situacao          SituacaoMotorista @default(ATIVO)

  // CNH (Resolução CONTRAN 996/2023)
  numeroCNH         String
  categoriaCNH      String            // A, B, C, D, E, AB, AC...
  vencimentoCNH     DateTime
  primeiraCNH       DateTime?
  emissaoCNH        DateTime?
  cnh2Via           Boolean           @default(false)

  // Alertas
  cnh30Dias         Boolean           @default(false)
  cnh60Dias         Boolean           @default(false)

  telefone          String?
  email             String?

  ativo             Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  utilizacoes       UtilizacaoVeiculo[]

  @@unique([municipioId, cpf])
  @@index([municipioId, situacao])
  @@map("motoristas")

model Abastecimento {
  id              String          @id @default(cuid())
  municipioId     String
  veiculoId       String
  veiculo         Veiculo         @relation(fields: [veiculoId], references: [id])
  motoristaId     String?
  motoristaNome   String?
  data            DateTime        @default(now())

  combustivel     CombustivelTipo
  litros          Decimal         @db.Decimal(8,3)
  valorLitro      Decimal         @db.Decimal(8,4)
  valorTotal      Decimal         @db.Decimal(10,2)
  kmAbastecimento Int
  kmAnterior      Int?            // Calculado do último abastecimento
  kmRodados       Int?            // kmAbastecimento - kmAnterior
  consumoRealizado Decimal?       @db.Decimal(6,2)  // kmRodados / litros

  // Fornecedor
  fornecedor      String?
  nfNumero        String?
  empenho         String?

  observacao      String?

  createdAt       DateTime        @default(now())

  @@index([municipioId, veiculoId, data])
  @@index([municipioId, data])
  @@map("abastecimentos")

model Manutencao {
  id              String           @id @default(cuid())
  municipioId     String
  veiculoId       String
  veiculo         Veiculo          @relation(fields: [veiculoId], references: [id])
  tipo            TipoManutencao
  status          StatusManutencao @default(AGUARDANDO)
  descricao       String
  dataAbertura    DateTime         @default(now())
  dataInicio      DateTime?
  dataConclusao   DateTime?
  kmAbertura      Int

  // Oficina
  oficina         String?
  responsavel     String?

  // Orçamento / Pagamento
  valorOrcado     Decimal?         @db.Decimal(10,2)
  valorFinal      Decimal?         @db.Decimal(10,2)
  empenho         String?
  nfNumero        String?

  pecasUtilizadas String?          @db.Text
  diagnostico     String?          @db.Text
  observacao      String?          @db.Text

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([municipioId, veiculoId])
  @@index([municipioId, status])
  @@map("manutencoes_frota")

model UtilizacaoVeiculo {
  id              String    @id @default(cuid())
  municipioId     String
  veiculoId       String
  veiculo         Veiculo   @relation(fields: [veiculoId], references: [id])
  motoristaId     String?
  motorista       Motorista? @relation(fields: [motoristaId], references: [id])
  motoristaNome   String?
  dataHoraSaida   DateTime
  dataHoraRetorno DateTime?
  kmSaida         Int
  kmRetorno       Int?
  kmRodados       Int?
  destino         String
  finalidade      String
  setor           String?
  autorizado      Boolean   @default(false)
  autorizadoPor   String?
  observacao      String?
  createdAt       DateTime  @default(now())

  @@index([municipioId, veiculoId])
  @@index([municipioId, motoristaId])
  @@map("utilizacoes_veiculo")

// ─── schema-frotas.prisma ───
// ─────────────────────────────────────────────────────────────────────────────
// ERP MUNICIPAL — Módulo FROTAS
// Base legal:
//   CTB — Código de Trânsito Brasileiro (Lei 9.503/1997)
//     Art. 328 — infração, multa e pontuação
//   Lei 8.666/1993 — licitação para manutenção e abastecimento
//   Lei 10.520/2002 — pregão para combustíveis
//   IN TCU 85/2020 — controle de frota pública
//   Resolução CONTRAN 432/2013 — categorias de habilitação
//
// Funcionalidades:
//   - Cadastro de veículos com histórico de km
//   - Motoristas com CNH, validade e pontuação
//   - Abastecimentos com consumo (km/L) calculado automaticamente
//   - Manutenções preventivas e corretivas com OS
//   - Multas com recurso e controle de pagamento
//   - Relatório de custo total por veículo
// ─────────────────────────────────────────────────────────────────────────────

enum TipoVeiculo {
  AUTOMOVEL       // carro passeio
  PICKUP          // camionete
  CAMINHAO        // caminhão
  ONIBUS          // ônibus, micro-ônibus
  VAN             // van, furgão
  MOTOCICLETA     // moto
  TRATOR          // trator agrícola/industrial
  RETROESCAVADEIRA
  AMBULANCIA
  OUTRO

enum CombustivelTipo {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV
  FLEX          // gasolina ou etanol
  ELETRICO
  HIBRIDO

enum SituacaoVeiculo {
  ATIVO           // em operação
  MANUTENCAO      // em manutenção
  INATIVO         // fora de uso temporário
  ALIENADO        // vendido/doado/desativado
  SINISTRO        // acidente/perda total

enum CategoriaCNH {
  A   // motocicleta
  B   // automóvel
  C   // caminhão
  D   // ônibus
  E   // combinados
  AB
  AC
  AD
  AE

enum SituacaoMotorista {
  ATIVO
  AFASTADO
  DESLIGADO

enum TipoManutencao {
  PREVENTIVA      // revisão periódica, troca de óleo, filtros
  CORRETIVA       // reparo por defeito/pane
  ACIDENTE        // reparo por acidente
  REFORMA         // reforma geral

enum SituacaoManutencao {
  AGUARDANDO_OS   // ordem de serviço não aberta
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA

enum TipoMulta {
  LEVE            // 3 pontos
  MEDIA           // 4 pontos
  GRAVE           // 5 pontos
  GRAVISSIMA      // 7 pontos

enum SituacaoMulta {
  PENDENTE        // aguardando pagamento/recurso
  RECORRIDA       // recurso em andamento
  PAGA
  CANCELADA       // recurso aceito
  PRESCRITA

// ── Modelos ───────────────────────────────────────────────────────────────────

model Veiculo {
  id                String         @id @default(cuid())
  municipioId       String
  placa             String         // ex: "ABC-1234" ou "ABC1D23" (Mercosul)
  renavam           String?
  chassi            String?
  marca             String
  modelo            String
  anoFabricacao     Int
  anoModelo         Int
  cor               String?
  tipo              TipoVeiculo
  combustivel       CombustivelTipo
  capacidadeTanque  Float?         // litros
  kmAtual           Float          @default(0)
  kmAquisicao       Float          @default(0)
  // Responsabilidade
  unidadeNome       String?        // secretaria responsável
  motoristaId       String?        // motorista fixo (opcional)
  // Documentação
  dataAquisicao     DateTime?
  valorAquisicao    Float?
  empenhoNumero     String?
  dataLicenciamento DateTime?
  dataVencimentoLicenciamento DateTime?
  dataVencimentoIPVA DateTime?
  dataVencimentoSeguro DateTime?
  numeroSeguro      String?
  situacao          SituacaoVeiculo @default(ATIVO)
  observacoes       String?        @db.Text
  // Tombamento patrimonial
  tombamento        String?
  ativo             Boolean        @default(true)
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt
  usuarioId         String

  motorista         Motorista?     @relation(fields: [motoristaId], references: [id])
  abastecimentos    Abastecimento[]
  manutencoes       Manutencao[]
  multas            Multa[]
  viagens           Viagem[]

  @@unique([municipioId, placa])
  @@index([municipioId, situacao])
  @@map("veiculos")

model Motorista {
  id              String            @id @default(cuid())
  municipioId     String
  nome            String
  cpf             String
  dataNascimento  DateTime?
  telefone        String?
  email           String?
  // CNH
  numeroCnh       String
  categoriaCnh    CategoriaCNH
  dataEmissaoCnh  DateTime?
  dataValidadeCnh DateTime
  pontosCnh       Int               @default(0)   // pontos na CNH
  // Vínculo
  matricula       String?           // matrícula no RH
  unidadeNome     String?
  situacao        SituacaoMotorista @default(ATIVO)
  ativo           Boolean           @default(true)
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  usuarioId       String

  veiculosFixos   Veiculo[]
  abastecimentos  Abastecimento[]
  viagens         Viagem[]
  multas          Multa[]

  @@unique([municipioId, cpf])
  @@unique([municipioId, numeroCnh])
  @@index([municipioId, situacao])
  @@map("motoristas")

model Abastecimento {
  id              String          @id @default(cuid())
  municipioId     String
  veiculoId       String
  motoristaId     String?
  data            DateTime        @default(now())
  kmAnterior      Float           // hodômetro antes
  kmAtual         Float           // hodômetro atual
  kmRodados       Float           // calculado: kmAtual - kmAnterior
  litros          Float
  valorLitro      Float
  valorTotal      Float
  combustivel     CombustivelTipo
  consumo         Float?          // km/L calculado
  posto           String?
  empenhoNumero   String?
  notaFiscal      String?
  observacoes     String?
  usuarioId       String
  criadoEm        DateTime        @default(now())

  veiculo         Veiculo   @relation(fields: [veiculoId], references: [id])
  motorista       Motorista? @relation(fields: [motoristaId], references: [id])

  @@index([veiculoId])
  @@index([municipioId, data])
  @@map("abastecimentos")

model Manutencao {
  id              String              @id @default(cuid())
  municipioId     String
  veiculoId       String
  tipo            TipoManutencao
  numeroOS        String?             // número da ordem de serviço
  descricao       String
  fornecedor      String?             // oficina/mecânico
  dataEntrada     DateTime            @default(now())
  dataPrevisao    DateTime?
  dataConclusao   DateTime?
  kmEntrada       Float?
  kmSaida         Float?
  valorPecas      Float               @default(0)
  valorMaoDeObra  Float               @default(0)
  valorTotal      Float               @default(0)
  empenhoNumero   String?
  notaFiscal      String?
  situacao        SituacaoManutencao  @default(AGUARDANDO_OS)
  observacoes     String?             @db.Text
  usuarioId       String
  criadoEm        DateTime            @default(now())

  veiculo         Veiculo @relation(fields: [veiculoId], references: [id])

  @@index([veiculoId])
  @@index([municipioId, situacao])
  @@map("manutencoes")

model Multa {
  id              String         @id @default(cuid())
  municipioId     String
  veiculoId       String
  motoristaId     String?
  numeroAIT       String         // Auto de Infração de Trânsito
  dataInfracao    DateTime
  dataVencimento  DateTime?
  tipo            TipoMulta
  descricao       String         // ex: "Excesso de velocidade — 50km/h"
  pontos          Int            // pontos na CNH
  valorOriginal   Float
  valorComDesconto Float?        // com desconto por pagamento antecipado
  situacao        SituacaoMulta  @default(PENDENTE)
  dataPagamento   DateTime?
  dataRecurso     DateTime?
  resultadoRecurso String?
  observacoes     String?
  usuarioId       String
  criadoEm        DateTime       @default(now())

  veiculo         Veiculo    @relation(fields: [veiculoId], references: [id])
  motorista       Motorista? @relation(fields: [motoristaId], references: [id])

  @@unique([municipioId, numeroAIT])
  @@index([veiculoId])
  @@index([municipioId, situacao])
  @@map("multas")

model Viagem {
  id              String    @id @default(cuid())
  municipioId     String
  veiculoId       String
  motoristaId     String?
  destino         String
  finalidade      String
  solicitanteNome String?
  unidadeNome     String?
  dataSaida       DateTime
  dataRetorno     DateTime?
  kmSaida         Float
  kmRetorno       Float?
  kmRodados       Float?    // calculado ao registrar retorno
  observacoes     String?
  usuarioId       String
  criadoEm        DateTime  @default(now())

  veiculo         Veiculo    @relation(fields: [veiculoId], references: [id])
  motorista       Motorista? @relation(fields: [motoristaId], references: [id])

  @@index([veiculoId])
  @@index([municipioId, dataSaida])
  @@map("viagens")

// ─── schema-licitacao.prisma ───
// ─────────────────────────────────────────────────────────────────────────────
// ERP MUNICIPAL — Módulo LICITAÇÃO
// Base legal: Lei 14.133/2021 (Nova Lei de Licitações), Lei 10.520/2002 (Pregão),
//             Lei 8.666/1993 (parcialmente vigente), LC 123/2006 (ME/EPP)
// ─────────────────────────────────────────────────────────────────────────────

// ── Enumerações ───────────────────────────────────────────────────────────────

enum ModalidadeLicitacao {
  PREGAO_ELETRONICO       // Lei 10.520/2002 — mais usado para bens/serviços
  PREGAO_PRESENCIAL
  CONCORRENCIA            // Lei 14.133/2021 — obras/serviços de engenharia ≥ R$2.500.000
  CONCURSO                // trabalhos técnicos/artísticos
  LEILAO                  // alienação de bens
  DISPENSA                // Art. 75 — valor ou situação especial
  INEXIGIBILIDADE         // Art. 74 — exclusividade / notória especialização
  CHAMAMENTO_PUBLICO      // OSCs — Lei 13.019/2014

enum SituacaoProcesso {
  RASCUNHO
  PUBLICADO               // edital publicado no DOE/PNCP
  EM_ANDAMENTO
  SUSPENSO
  DESERTO                 // sem participantes
  FRACASSADO              // propostas inabilitadas/desclassificadas
  HOMOLOGADO
  REVOGADO
  ANULADO
  CONCLUIDO

enum SituacaoProposta {
  RECEBIDA
  EM_ANALISE
  HABILITADA
  INABILITADA
  CLASSIFICADA
  DESCLASSIFICADA
  VENCEDORA
  SEGUNDA_COLOCADA        // para caso de desistência da vencedora

enum SituacaoContrato {
  MINUTA
  ASSINADO
  VIGENTE
  SUSPENSO
  RESCINDIDO
  ENCERRADO
  PRORROGADO

enum TipoObjeto {
  OBRAS
  SERVICOS_ENGENHARIA
  COMPRAS_BENS
  SERVICOS_CONTINUADOS
  LOCACOES
  CONCESSOES

enum SituacaoItem {
  PENDENTE
  COTADO
  ADJUDICADO
  CANCELADO

// ── Modelos ───────────────────────────────────────────────────────────────────

model ProcessoLicitatorio {
  id              String    @id @default(cuid())
  municipioId     String
  numero          String    // Ex: PREGÃO 001/2026
  modalidade      ModalidadeLicitacao
  tipoObjeto      TipoObjeto
  objeto          String    @db.Text
  justificativa   String?   @db.Text
  valorEstimado   Float
  dotacaoOrca     String?   // dotação orçamentária
  exercicio       Int       // ano
  dataPublicacao  DateTime?
  dataAbertura    DateTime? // abertura das propostas
  dataJulgamento  DateTime?
  dataHomologacao DateTime?
  situacao        SituacaoProcesso @default(RASCUNHO)
  criterioJulgamento String  @default("MENOR_PRECO")
  exclusivoMePP   Boolean  @default(false) // LC 123/2006
  margemPreferencia Float?  // % preferência p/ nac.
  responsavelId   String
  comissao        String?  // nomes separados por vírgula
  editalUrl       String?
  observacoes     String?  @db.Text
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  usuarioId       String

  itens       ItemLicitacao[]
  propostas   Proposta[]
  contratos   Contrato[]
  ata         AtaRegistroPreco?

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, exercicio])
  @@map("processos_licitatorios")

model ItemLicitacao {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  numero      Int       // sequencial dentro do processo
  descricao   String    @db.Text
  unidade     String    // un, cx, m², kg, h…
  quantidade  Float
  valorUnitEstimado Float
  valorTotalEstimado Float
  situacao    SituacaoItem @default(PENDENTE)
  categoriaMaterial String? // código CATMAT/CATSER
  criadoEm    DateTime @default(now())

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  propostas   PropostaItem[]

  @@index([processoId])
  @@map("itens_licitacao")

model Fornecedor {
  id              String   @id @default(cuid())
  municipioId     String
  cnpj            String
  razaoSocial     String
  nomeFantasia    String?
  email           String?
  telefone        String?
  endereco        String?
  cidade          String?
  uf              String?
  representante   String?
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  propostas   Proposta[]
  contratos   Contrato[]

  @@unique([municipioId, cnpj])
  @@index([municipioId])
  @@map("fornecedores")

model Proposta {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  fornecedorId String
  numero      String    // PROP-2026-000001
  valorTotal  Float
  prazoEntrega Int?     // dias
  validade    Int       @default(60) // dias de validade
  situacao    SituacaoProposta @default(RECEBIDA)
  motivoInabilitacao String?
  observacoes String?  @db.Text
  dataRecebimento DateTime @default(now())
  criadoEm    DateTime @default(now())
  usuarioId   String

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  fornecedor  Fornecedor          @relation(fields: [fornecedorId], references: [id])
  itens       PropostaItem[]
  contrato    Contrato?

  @@unique([municipioId, numero])
  @@index([processoId, situacao])
  @@map("propostas")

model PropostaItem {
  id          String  @id @default(cuid())
  municipioId String
  propostaId  String
  itemId      String
  valorUnitario Float
  valorTotal    Float
  marca       String?

  proposta    Proposta      @relation(fields: [propostaId], references: [id])
  item        ItemLicitacao @relation(fields: [itemId], references: [id])

  @@index([propostaId])
  @@map("proposta_itens")

model Contrato {
  id              String    @id @default(cuid())
  municipioId     String
  numero          String    // CONTRATO 001/2026
  processoId      String
  fornecedorId    String
  propostaId      String?   @unique
  objeto          String    @db.Text
  valorInicial    Float
  valorAtual      Float     // pode variar por aditivos
  dataAssinatura  DateTime?
  dataInicio      DateTime?
  dataFim         DateTime?
  situacao        SituacaoContrato @default(MINUTA)
  dotacaoOrca     String?
  responsavelId   String
  gestorId        String?   // gestor do contrato
  fiscalId        String?   // fiscal do contrato
  contratoUrl     String?   // link para PDF assinado
  motivoRescisao  String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  usuarioId       String

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  fornecedor  Fornecedor          @relation(fields: [fornecedorId], references: [id])
  proposta    Proposta?           @relation(fields: [propostaId], references: [id])
  aditivos    AditivoContrato[]
  medicoes    MedicaoContrato[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@map("contratos")

model AditivoContrato {
  id          String   @id @default(cuid())
  municipioId String
  contratoId  String
  numero      Int      // sequencial do aditivo
  tipo        String   // PRAZO, VALOR, OBJETO
  descricao   String   @db.Text
  valorAcrescimo Float @default(0)  // pode ser negativo (supressão)
  prazoDias   Int?     // dias adicionados
  dataAssinatura DateTime?
  criadoEm    DateTime @default(now())
  usuarioId   String

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  @@index([contratoId])
  @@map("aditivos_contrato")

model MedicaoContrato {
  id          String   @id @default(cuid())
  municipioId String
  contratoId  String
  numero      Int      // sequencial da medição
  periodo     String   // "2026-01"
  valorMedido Float
  valorAprovado Float?
  dataEnvio   DateTime?
  dataAprovacao DateTime?
  situacao    String   @default("ENVIADA") // ENVIADA, APROVADA, REPROVADA
  observacoes String?  @db.Text
  criadoEm    DateTime @default(now())
  usuarioId   String

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  @@index([contratoId])
  @@map("medicoes_contrato")

model AtaRegistroPreco {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // ARP 001/2026
  processoId  String   @unique
  objeto      String   @db.Text
  dataAssinatura DateTime?
  dataValidade   DateTime  // máx. 12 meses — Art. 84 Lei 14.133/2021
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])

  @@unique([municipioId, numero])
  @@map("atas_registro_preco")

// ─── schema-licitacoes.prisma ───
// ─── LICITAÇÕES E CONTRATOS ───────────────────────────────────────────────────
// Lei 14.133/2021 — Nova Lei de Licitações e Contratos Administrativos (NLLCA)
// Lei 10.520/2002 — Pregão Eletrônico
// Decreto 10.922/2021 — PNCP (Portal Nacional de Contratações Públicas)
// LRF Art. 15-17 — vedação de despesas sem dotação orçamentária

enum ModalidadeLicitacao {
  PREGAO_ELETRONICO       // Lei 14.133 Art.17 II b — valor qualquer; bens/serviços comuns
  PREGAO_PRESENCIAL       // idem, presencialmente
  CONCORRENCIA            // Art.17 I — obras/serviços especiais; qualquer valor
  CONCURSO                // Art.17 IV — trabalho técnico/artístico/científico
  LEILAO                  // Art.17 V — bens inservíveis/penhorados; concessões
  DIALOGO_COMPETITIVO     // Art.17 VI — soluções inovadoras; mercado insuficiente
  TOMADA_PRECOS           // transitório/excecional (anterior a 14.133)
  CONVITE                 // transitório/excecional (anterior a 14.133)
  DISPENSA_VALOR          // Art.75 I-II — até R$50k obras / R$100k serviços (duplo 14.133)
  DISPENSA_EMERGENCIA     // Art.75 VIII — emergência/calamidade
  DISPENSA_EXCLUSIVIDADE  // Art.74 — inexigibilidade por fornecedor exclusivo
  INEXIGIBILIDADE         // Art.74 — inviabilidade de competição
  COTACAO_ELETRONICA      // Res. MPOG — compras até R$10k

enum SituacaoProcesso {
  RASCUNHO          // elaborando edital/TR
  PUBLICADO         // edital publicado (PNCP/DOU/DOE)
  EM_ANDAMENTO      // sessão pública aberta; recebendo propostas
  SUSPENSO          // suspenso por decisão administrativa ou judicial
  DESERTO           // nenhum licitante habilitado
  FRACASSADO        // propostas acima do valor de referência
  ADJUDICADO        // objeto adjudicado ao vencedor (comissão/pregoeiro)
  HOMOLOGADO        // homologado pela autoridade superior
  REVOGADO          // revogado por interesse público superveniente
  ANULADO           // anulado por ilegalidade
  ENCERRADO         // processo concluído; contrato firmado

enum TipoObjeto {
  OBRAS               // obras de engenharia
  SERVICOS            // serviços em geral
  SERVICOS_ENG        // serviços de engenharia
  COMPRAS             // aquisição de bens
  CONCESSOES          // concessão de serviço/uso
  ALIENACOES          // venda/alienação de bens
  LOCACOES            // locação de bens

enum SituacaoContrato {
  MINUTA            // minuta elaborada
  ASSINADO          // assinado pelas partes
  EM_EXECUCAO       // em execução/vigência
  SUSPENSO          // execução suspensa
  CONCLUIDO         // objeto integralmente executado
  RESCINDIDO        // rescindido (Art.137 NLLCA)
  CANCELADO         // cancelado antes de assinatura
  VENCIDO           // expirado sem renovação/prorrogação

enum TipoAditamento {
  PRAZO             // prorrogação de prazo
  VALOR             // acréscimo/decréscimo de valor
  PRAZO_VALOR       // prazo + valor
  OBJETO            // alteração qualitativa/quantitativa
  RESCISAO          // rescisão consensual

model ProcessoLicitatorio {
  id                String              @id @default(cuid())
  municipioId       String
  numero            String              // "LIC-2026-001" ou "PRE-2026-005"
  ano               Int
  modalidade        ModalidadeLicitacao
  tipoObjeto        TipoObjeto
  situacao          SituacaoProcesso    @default(RASCUNHO)

  // Objeto e valores
  objeto            String              @db.Text
  descricaoDetalhada String?            @db.Text
  valorEstimado     Decimal             @db.Decimal(14,2)
  valorHomologado   Decimal?            @db.Decimal(14,2)
  valorAdjudicado   Decimal?            @db.Decimal(14,2)

  // Dotação orçamentária (LRF Art.15)
  dotacaoOrcamentaria String?           // ex: "10.302.0001.2001.0000"
  fonteRecurso      String?
  exercicio         Int?

  // Datas do processo
  dataPublicacao    DateTime?           // publicação do edital
  dataAbertura      DateTime?           // sessão pública
  dataAdjudicacao   DateTime?
  dataHomologacao   DateTime?

  // Comissão/Pregoeiro
  responsavel       String?             // pregoeiro ou presidente da comissão
  membrosComissao   String?             @db.Text // JSON array de nomes

  // PNCP
  pncpNumero        String?             // número PNCP
  pncpLink          String?

  // Critério de julgamento
  criterioJulgamento String             @default("MENOR_PRECO") // MENOR_PRECO, MELHOR_TECNICA, TECNICA_PRECO
  modoDisputa       String?             // ABERTO, FECHADO, ABERTO_FECHADO

  // Secretaria demandante
  secretariaId      String?
  secretariaNome    String?

  // Metadados
  justificativa     String?             @db.Text // justificativa para dispensa/inexigibilidade
  parecerJuridico   Boolean             @default(false)
  parecerContabil   Boolean             @default(false)
  ativo             Boolean             @default(true)
  usuarioId         String?
  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt

  participantes     ParticipanteLicitacao[]
  contratos         Contrato[]
  movimentacoes     MovimentacaoLicitacao[]

  @@unique([municipioId, numero, ano])
  @@index([municipioId, situacao])
  @@index([municipioId, modalidade])
  @@index([municipioId, ano])

model ParticipanteLicitacao {
  id                String              @id @default(cuid())
  municipioId       String
  processoId        String
  cnpj              String
  razaoSocial       String
  nomeFantasia      String?
  email             String?
  telefone          String?
  representante     String?

  // Proposta
  valorProposta     Decimal?            @db.Decimal(14,2)
  dataPropostaEnv   DateTime?
  situacaoProposta  String              @default("AGUARDANDO") // AGUARDANDO, ENVIADA, CLASSIFICADA, DESCLASSIFICADA, VENCEDORA
  motivoDesclass    String?

  // Habilitação (documentação)
  habilitado        Boolean?
  motivoInabilitacao String?

  // Lance final (pregão)
  valorLance        Decimal?            @db.Decimal(14,2)
  dataLance         DateTime?

  // Ordem de classificação
  posicao           Int?

  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt

  processo          ProcessoLicitatorio @relation(fields: [processoId], references: [id])

  @@index([processoId])
  @@index([municipioId, cnpj])

model Contrato {
  id                String              @id @default(cuid())
  municipioId       String
  processoId        String?             // pode ser null para contrato emergencial
  numero            String              // "CTR-2026-001"
  ano               Int
  situacao          SituacaoContrato    @default(MINUTA)

  // Partes
  cnpjContratada    String
  razaoSocialContratada String
  nomeFantasiaContratada String?
  representanteContratada String?
  cpfRepresentante  String?

  // Objeto
  objeto            String              @db.Text
  tipoObjeto        TipoObjeto

  // Valores
  valorContrato     Decimal             @db.Decimal(14,2)
  valorAditivos     Decimal             @default(0) @db.Decimal(14,2)
  valorTotal        Decimal             @db.Decimal(14,2) // calculado
  valorExecutado    Decimal             @default(0) @db.Decimal(14,2)
  valorSaldo        Decimal             @db.Decimal(14,2) // calculado

  // Prazos
  dataAssinatura    DateTime?
  dataVigenciaInicio DateTime?
  dataVigenciaFim   DateTime?
  dataVigenciaOriginal DateTime?        // antes dos aditamentos

  // Dotação
  dotacaoOrcamentaria String?
  fonteRecurso      String?

  // Gestor/Fiscal
  gestorNome        String?
  gestorMatricula   String?
  fiscalNome        String?
  fiscalMatricula   String?

  // Publicação
  dataPublicacaoExtrto DateTime?
  pncpNumero        String?

  // Rescisão
  dataRescisao      DateTime?
  motivoRescisao    String?             @db.Text
  tipoRescisao      String?             // UNILATERAL_ADM, AMIGAVEL, JUDICIAL

  ativo             Boolean             @default(true)
  usuarioId         String?
  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt

  processo          ProcessoLicitatorio? @relation(fields: [processoId], references: [id])
  aditamentos       AditamentoContrato[]
  medicoes          MedicaoContrato[]

  @@unique([municipioId, numero, ano])
  @@index([municipioId, situacao])
  @@index([municipioId, cnpjContratada])
  @@index([municipioId, dataVigenciaFim])

model AditamentoContrato {
  id                String              @id @default(cuid())
  municipioId       String
  contratoId        String
  numero            Int                 // sequencial por contrato (1º, 2º, ...)
  tipo              TipoAditamento

  // Acréscimo/Decréscimo de prazo
  diasAcrescidos    Int?
  novaDataFim       DateTime?

  // Acréscimo/Decréscimo de valor
  valorAcrescimo    Decimal?            @db.Decimal(14,2) // positivo=acréscimo, negativo=decréscimo
  novoValorTotal    Decimal?            @db.Decimal(14,2)
  percentualAcrescimo Decimal?          @db.Decimal(6,2)  // % em relação ao original (25% lei 8.666 / 25% NLLCA obras, 10% outros)

  // Fundamento legal
  fundamento        String?             @db.Text // ex: "Art. 124 I da Lei 14.133/2021"
  justificativa     String              @db.Text

  dataAssinatura    DateTime?
  dataPublicacao    DateTime?

  usuarioId         String?
  criadoEm          DateTime            @default(now())

  contrato          Contrato            @relation(fields: [contratoId], references: [id])

  @@index([contratoId])

model MedicaoContrato {
  id                String              @id @default(cuid())
  municipioId       String
  contratoId        String
  numero            Int                 // número da medição (1ª, 2ª, ...)
  competencia       String              // "2026-01"

  valorMedido       Decimal             @db.Decimal(14,2)
  valorAcumulado    Decimal?            @db.Decimal(14,2)
  percentualExec    Decimal?            @db.Decimal(6,2)

  situacao          String              @default("PENDENTE") // PENDENTE, APROVADA, REJEITADA, PAGA
  dataVistoria      DateTime?
  dataAprovacao     DateTime?
  dataPagamento     DateTime?

  observacoes       String?             @db.Text
  usuarioId         String?
  criadoEm          DateTime            @default(now())

  contrato          Contrato            @relation(fields: [contratoId], references: [id])

  @@index([contratoId])

model MovimentacaoLicitacao {
  id                String              @id @default(cuid())
  municipioId       String
  processoId        String
  situacaoDe        SituacaoProcesso
  situacaoPara      SituacaoProcesso
  motivo            String?             @db.Text
  usuarioId         String?
  criadoEm          DateTime            @default(now())

  processo          ProcessoLicitatorio @relation(fields: [processoId], references: [id])

  @@index([processoId])

// ─── schema-licitacoes.prisma ───
// ─── ERP Municipal — Módulo LICITAÇÕES & CONTRATOS ────────────────────────────
// Lei 14.133/2021 — Nova Lei de Licitações (revoga Lei 8.666/1993)
// Lei 10.520/2002 — Pregão Presencial/Eletrônico
// Lei 12.462/2011 — Regime Diferenciado de Contratações (RDC)
// LC 123/2006 — tratamento diferenciado ME/EPP
// CF/88 Art. 37 XXI — licitação pública obrigatória
// Decreto 10.024/2019 — Pregão Eletrônico Federal
// Lei 11.079/2004 — Parcerias Público-Privadas (PPP)
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ModalidadeLicitacao {
  CONCORRENCIA          // Art. 29 Lei 14.133 — obras/serviços de maior vulto
  CONCURSO              // Art. 30 — trabalho técnico, científico ou artístico
  LEILAO                // Art. 31 — alienação de bens imóveis / bens móveis
  PREGAO                // Art. 29 V — bens e serviços comuns (preferencial)
  DIALOGO_COMPETITIVO   // Art. 32 — soluções inovadoras complexas
  DISPENSA              // Art. 75 — dispensável (limite: R$50k obras, R$25k serviços)
  INEXIGIBILIDADE       // Art. 74 — exclusividade / notória especialização
  RDC                   // Regime Diferenciado de Contratações
  CREDENCIAMENTO        // Art. 79 — serviços de saúde

enum FormaLicitacao {
  MENOR_PRECO
  MAIOR_DESCONTO
  MELHOR_TECNICA
  TECNICA_PRECO
  MAIOR_LANCE        // leilão
  MAIOR_RETORNO

enum SituacaoLicitacao {
  RASCUNHO
  PUBLICADA          // aviso publicado no PNCP/DOE
  EM_PRAZO           // dentro do prazo para propostas
  EM_JULGAMENTO
  HOMOLOGADA
  DESERTA            // nenhuma proposta recebida
  FRACASSADA         // propostas desclassificadas
  REVOGADA
  ANULADA
  ADJUDICADA         // objeto adjudicado ao vencedor

enum SituacaoContrato {
  MINUTA
  ASSINADO
  EM_EXECUCAO
  SUSPENSO
  RESCINDIDO_ADMIN   // rescisão administrativa unilateral (Art. 137 Lei 14.133)
  RESCINDIDO_AMIGAVEL
  RESCINDIDO_JUDICIAL
  CONCLUIDO
  EXPIRADO

enum TipoAditivo {
  PRAZO              // prorrogação de prazo
  VALOR              // acréscimo/supressão (limite 25% obras; 50% reformas)
  OBJETO             // alteração do objeto
  PRAZO_VALOR
  REEQUILIBRIO       // reequilíbrio econômico-financeiro

enum SituacaoItemLic {
  ABERTO
  ADJUDICADO
  CANCELADO
  DESERTO
  FRACASSADO

// ─── Licitação ────────────────────────────────────────────────────────────────

model Licitacao {
  id          String   @id @default(cuid())
  municipioId String

  numero      String            // "LIC-2026-001"
  modalidade  ModalidadeLicitacao
  forma       FormaLicitacao
  situacao    SituacaoLicitacao @default(RASCUNHO)

  objeto      String            // descrição do objeto
  justificativa String?  @db.Text
  fundamentacao String?         // Art. 75 / Art. 74 (dispensas e inexigibilidades)

  // Valores
  valorEstimado Decimal  @db.Decimal(15,2)
  valorHomologado Decimal? @db.Decimal(15,2)

  // Datas
  dataPublicacao   DateTime?
  dataAbertura     DateTime?   // abertura das propostas
  dataJulgamento   DateTime?
  dataHomologacao  DateTime?
  dataAdjudicacao  DateTime?

  // Localização e publicidade
  urlEdital        String?
  urlAta           String?
  urlResultado     String?
  pncpNumero       String?     // número PNCP (Portal Nacional de Contratações Públicas)
  doeNumero        String?     // Diário Oficial do Estado

  // Responsáveis
  comissao         String?     // membros da comissão de licitação
  pregoeiro        String?     // para pregões

  // Exercício
  exercicio        Int
  unidadeGestora   String?
  dotacaoOrcamentaria String?
  fonteCusteio     String?

  itens            ItemLicitacao[]
  propostas        PropostaLicitacao[]
  contrato         Contrato[]

  usuarioId        String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, exercicio])
  @@index([municipioId, modalidade])

model ItemLicitacao {
  id          String   @id @default(cuid())
  licitacaoId String
  municipioId String

  numero      Int
  descricao   String
  unidade     String            // ex: "un", "m²", "kg"
  quantidade  Decimal  @db.Decimal(15,4)
  valorUnitRef Decimal @db.Decimal(15,4)  // valor de referência (sigiloso até abertura)
  situacao    SituacaoItemLic @default(ABERTO)

  // Vencedor
  fornecedorNome  String?
  fornecedorCNPJ  String?
  valorUnitVencedor Decimal? @db.Decimal(15,4)
  valorTotalItem  Decimal? @db.Decimal(15,2)

  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id])

  @@index([licitacaoId])
  @@index([municipioId])

model PropostaLicitacao {
  id          String   @id @default(cuid())
  licitacaoId String
  municipioId String

  fornecedorNome String
  fornecedorCNPJ String
  porte          String?    // ME/EPP/Grande
  valorTotal     Decimal @db.Decimal(15,2)
  tecnica        String? @db.Text
  situacao       String @default('RECEBIDA')  // RECEBIDA/CLASSIFICADA/DESCLASSIFICADA/VENCEDORA
  motivoDesclass String? @db.Text
  colocacao      Int?

  criadoEm    DateTime @default(now())
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id])

  @@index([licitacaoId])

// ─── Contrato ─────────────────────────────────────────────────────────────────

model Contrato {
  id          String   @id @default(cuid())
  municipioId String

  numero      String            // "CONT-2026-001"
  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  situacao    SituacaoContrato @default(MINUTA)

  // Partes
  contratadaNome  String
  contratadaCNPJ  String
  contratadaEndereco String?

  // Objeto
  objeto          String
  descricaoDetalhada String? @db.Text

  // Valores
  valorOriginal   Decimal  @db.Decimal(15,2)
  valorAtual      Decimal  @db.Decimal(15,2)   // após aditivos
  valorExecutado  Decimal  @db.Decimal(15,2) @default(0)

  // Vigência
  dataAssinatura  DateTime?
  dataInicio      DateTime?
  dataFim         DateTime?
  dataFimOriginal DateTime?    // sem prorrogações

  // Indexadores
  indiceReajuste  String?      // ex: "IPCA", "INPC", "SINAPI"
  datBaseReajuste DateTime?

  // Garantias (Art. 96 Lei 14.133)
  garantiaTipo    String?      // CAUÇÃO, SEGURO, FIANÇA
  garantiaValor   Decimal? @db.Decimal(15,2)
  garantiaValidade DateTime?

  // Fiscal do contrato (Art. 117 Lei 14.133 — obrigatório)
  fiscalNome      String?
  fiscalMatricula String?
  gestorNome      String?

  // Dotação
  dotacaoOrcamentaria String?
  fonteCusteio        String?

  // Publicidade
  urlContrato     String?
  pncpNumero      String?

  aditivos        AditivoContrato[]
  medicoes        MedicaoContrato[]

  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, contratadaCNPJ])
  @@index([municipioId, dataFim])

// ─── Aditivo Contratual ───────────────────────────────────────────────────────

model AditivoContrato {
  id          String   @id @default(cuid())
  contratoId  String
  municipioId String

  numero      Int               // 1º, 2º aditivo…
  tipo        TipoAditivo
  objeto      String
  justificativa String? @db.Text

  // Acréscimo de valor (% máx. Art. 125 Lei 14.133)
  valorAcrescimo Decimal? @db.Decimal(15,2)
  pctAcrescimo   Decimal? @db.Decimal(5,2)

  // Prorrogação de prazo
  diasPrazo   Int?
  novaDataFim DateTime?

  dataAssinatura DateTime?
  urlAditivo  String?

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  criadoEm    DateTime @default(now())
  @@index([contratoId])

// ─── Medição / Fiscalização ───────────────────────────────────────────────────

model MedicaoContrato {
  id          String   @id @default(cuid())
  contratoId  String
  municipioId String

  numero      Int
  periodo     String            // "2026-10"
  dataInicio  DateTime
  dataFim     DateTime

  valorMedido Decimal  @db.Decimal(15,2)
  situacao    String   @default('PENDENTE')  // PENDENTE/APROVADA/REJEITADA/PAGA

  observacao  String?  @db.Text
  dataAprovacao DateTime?
  dataPagamento DateTime?
  notaFiscal  String?

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  criadoEm    DateTime @default(now())
  @@index([contratoId])

// ─── schema-obras.prisma ───
// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO OBRAS E URBANISMO — Gestão de obras públicas e controle urbanístico
// ═══════════════════════════════════════════════════════════════════════════
//
// Referências legais:
//   Lei 8.666/1993  — Lei de Licitações (revogada parcialmente)
//   Lei 14.133/2021 — Nova Lei de Licitações e Contratos Administrativos
//   Lei 4.591/1964  — Incorporação imobiliária
//   Lei 10.257/2001 — Estatuto da Cidade
//   Decreto-Lei 25/1937 — Tombamento patrimônio histórico
//   NBR 12721       — Avaliação de custos unitários de construção
//   SINAPI          — Sistema Nacional de Pesquisa de Custos e Índices
//   Lei 13.465/2017 — Regularização fundiária urbana (REURB)
//   CF Art. 182     — Política urbana e plano diretor
//
// Fluxo principal:
//   Licitação/Contrato → Obra → Medições → Pagamentos
//   Alvará de construção → Fiscalização → Habite-se
// ═══════════════════════════════════════════════════════════════════════════

  url      = env("DATABASE_URL")
// ─── Enums ────────────────────────────────────────────────────────────────────

enum TipoObra {
  PAVIMENTACAO
  DRENAGEM
  CONSTRUCAO
  REFORMA
  AMPLIACAO
  DEMOLIÇÃO
  REVITALIZACAO
  SANEAMENTO
  ILUMINACAO
  PONTES_VIADUTOS
  OUTRO

enum SituacaoObra {
  PLANEJADA
  LICITANDO
  CONTRATADA
  EM_EXECUCAO
  PARALISADA
  CONCLUIDA
  CANCELADA

enum TipoAlvara {
  CONSTRUCAO
  REFORMA
  DEMOLIÇÃO
  AMPLIACAO
  REGULARIZACAO
  HABITE_SE
  LOCALIZACAO      // alvará de funcionamento/localização
  EVENTOS

enum SituacaoAlvara {
  SOLICITADO
  EM_ANALISE
  APROVADO
  INDEFERIDO
  VENCIDO
  CANCELADO

enum SituacaoFiscalizacao {
  AGENDADA
  REALIZADA
  IRREGULAR
  NOTIFICADA
  REGULARIZADA
  EMBARGADA

// ─── Obra ─────────────────────────────────────────────────────────────────────

model Obra {
  id          String @id @default(cuid())
  municipioId String

  // Número da obra: "OB-2026-001"
  numero      String

  titulo      String
  tipo        TipoObra
  situacao    SituacaoObra @default(PLANEJADA)
  descricao   String? @db.Text

  // Localização
  logradouro  String?
  bairro      String?
  cep         String?
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)

  // Financeiro
  valorOrcado    Decimal  @db.Decimal(14, 2)
  fontRecurso    String?  // federal, estadual, municipal, convênio
  programaFederal String? // PAC, FNHIS, etc.

  // Datas
  dataInicioPrevista DateTime?
  dataConclusaoPrevista DateTime?
  dataInicioReal    DateTime?
  dataConclusaoReal DateTime?

  // Fiscalização
  responsavelTecnico String?  // nome do RT
  crea               String?  // número CREA/CAU

  // Medição acumulada
  percentualFisicoAcumulado  Decimal @db.Decimal(5, 2) @default(0)
  valorMedidoAcumulado       Decimal @db.Decimal(14, 2) @default(0)

  // Vínculo com contrato (opcional — pode ser obra por administração direta)
  contratoId  String?
  contrato    ContratoObra? @relation(fields: [contratoId], references: [id])

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  medicoes    MedicaoObra[]
  fiscalizacoes FiscalizacaoObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])

// ─── Contrato de Obra ─────────────────────────────────────────────────────────

model ContratoObra {
  id          String @id @default(cuid())
  municipioId String

  // Número: "CT-2026-001"
  numero      String

  // Empresa contratada
  contratadaNome  String
  contratadaCnpj  String
  contratadaEmail String?
  contratadaTelefone String?

  // Referência licitatória
  modalidade    String   // PE, CC, CP, TL (Lei 14.133/2021)
  numeroLicitacao String?
  processo      String?

  // Valores
  valorContrato   Decimal @db.Decimal(14, 2)
  valorReajustado Decimal? @db.Decimal(14, 2)
  valorAditivos   Decimal @db.Decimal(14, 2) @default(0)
  valorMedido     Decimal @db.Decimal(14, 2) @default(0)
  valorPago       Decimal @db.Decimal(14, 2) @default(0)

  // Vigência
  dataAssinatura  DateTime
  dataVigenciaFim DateTime
  prazoDias       Int?

  // Garantia contratual (Art. 96 Lei 14.133)
  tipoGarantia    String?
  valorGarantia   Decimal? @db.Decimal(14, 2)

  ativo       Boolean @default(true)
  observacoes String? @db.Text

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obras       Obra[]
  medicoes    MedicaoObra[]
  aditivos    AditivoContrato[]

  @@unique([municipioId, numero])
  @@index([municipioId])

// ─── Aditivo de Contrato ──────────────────────────────────────────────────────

model AditivoContrato {
  id          String @id @default(cuid())
  municipioId String

  contratoId  String
  contrato    ContratoObra @relation(fields: [contratoId], references: [id])

  numero      Int   // 1º, 2º, 3º aditivo
  tipo        String  // PRAZO / VALOR / PRAZO_E_VALOR / SUPRESSAO
  motivo      String @db.Text

  // Para aditivo de valor
  valorAcrescimo  Decimal? @db.Decimal(14, 2)
  valorSupressao  Decimal? @db.Decimal(14, 2)

  // Para aditivo de prazo
  diasAcrescimo   Int?
  novaVigencia    DateTime?

  dataAssinatura  DateTime
  usuarioId       String
  criadoEm       DateTime @default(now())

  @@index([contratoId])

// ─── Medição ──────────────────────────────────────────────────────────────────

model MedicaoObra {
  id          String @id @default(cuid())
  municipioId String

  obraId      String
  obra        Obra @relation(fields: [obraId], references: [id])

  contratoId  String?
  contrato    ContratoObra? @relation(fields: [contratoId], references: [id])

  numero      Int   // 1ª, 2ª, 3ª medição
  periodo     String  // "01/10 a 31/10/2026"
  dataMedicao DateTime

  // Físico
  percentualPeriodo    Decimal @db.Decimal(5, 2)
  percentualAcumulado  Decimal @db.Decimal(5, 2)

  // Financeiro
  valorBruto    Decimal @db.Decimal(14, 2)
  descontosRetencoes Decimal @db.Decimal(14, 2) @default(0)
  valorLiquido  Decimal @db.Decimal(14, 2)

  // Status de pagamento
  situacao      String @default("PENDENTE")  // PENDENTE / APROVADA / PAGA / REJEITADA
  dataPagamento DateTime?
  notaFiscal    String?

  observacoes   String? @db.Text
  usuarioId     String
  criadoEm     DateTime @default(now())

  @@index([obraId])

// ─── Alvará ───────────────────────────────────────────────────────────────────

model Alvara {
  id          String @id @default(cuid())
  municipioId String

  // Número: "AV-2026-001"
  numero      String?

  tipo        TipoAlvara
  situacao    SituacaoAlvara @default(SOLICITADO)

  // Requerente
  requerentNome  String
  requerentCpfCnpj String?
  requerentTelefone String?
  requerentEmail  String?

  // Localização do imóvel
  logradouro  String?
  numero_imovel String?
  bairro      String?
  cep         String?
  inscricaoImobiliaria String?  // vínculo com cadastro imobiliário (TRIBUTOS)

  // Dados técnicos
  responsavelTecnico String?
  crea               String?
  areaTotal          Decimal? @db.Decimal(10, 2)
  areaConstruida     Decimal? @db.Decimal(10, 2)
  numeroPavimentos   Int?
  usoImovel          String?  // residencial, comercial, industrial, misto

  // Taxas
  taxaAlvara  Decimal? @db.Decimal(10, 2)
  taxaPaga    Boolean @default(false)
  dataPagamento DateTime?

  // Datas
  dataSolicitacao DateTime @default(now())
  dataAnalise     DateTime?
  dataEmissao     DateTime?
  dataVencimento  DateTime?
  dataHabitese    DateTime?

  motivoIndeferimento String? @db.Text
  observacoes         String? @db.Text

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  fiscalizacoes FiscalizacaoObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])

// ─── Fiscalização / Auto de Infração ─────────────────────────────────────────

model FiscalizacaoObra {
  id          String @id @default(cuid())
  municipioId String

  // Pode ser vinculada a obra ou alvará
  obraId      String?
  obra        Obra?    @relation(fields: [obraId], references: [id])
  alvaraId    String?
  alvara      Alvara?  @relation(fields: [alvaraId], references: [id])

  situacao    SituacaoFiscalizacao @default(AGENDADA)
  dataVisita  DateTime
  fiscal      String   // nome do fiscal

  // Resultado da visita
  conformidade String?  // CONFORME / NÃO_CONFORME / PARCIALMENTE_CONFORME
  relatorio   String? @db.Text

  // Auto de infração (se irregular)
  numeroAuto  String?
  descricaoInfracao String? @db.Text
  valorMulta  Decimal? @db.Decimal(10, 2)
  prazoRegularizacao DateTime?

  // Embargo
  dataEmbargo    DateTime?
  motivoEmbargo  String?

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, obraId])
  @@index([municipioId, alvaraId])

// ─── schema-obras.prisma ───
// ─── ERP Municipal — Módulo OBRAS & URBANISMO ──────────────────────────────
// Lei 6.496/1977 — Anotação de Responsabilidade Técnica (ART)
// Lei 8.666/1993 / 14.133/2021 — Contratações públicas para obras
// NBR 12721 — Avaliação de custos de construção (CUB)
// SINAPI — referência de custos para obras públicas (Caixa/IBGE)
// Lei 10.257/2001 — Estatuto da Cidade (regularização fundiária, parcelamento)
// Resolução CONFEA 1.025/2009 — ART (substitui antiga)
// Lei 9.605/1998 — Crimes ambientais (embargo e demolição)
  url      = env("DATABASE_URL")

enum TipoObra {
  CONSTRUCAO_NOVA
  REFORMA
  AMPLIACAO
  DEMOLICAO
  RESTAURACAO
  INFRAESTRUTURA_VIARIA
  DRENAGEM
  PAVIMENTACAO
  CALÇAMENTO
  PRAÇA_PARQUE
  ESCOLA
  UBS
  OUTROS

enum SituacaoObra {
  PLANEJAMENTO
  LICITACAO
  CONTRATADA
  EM_EXECUCAO
  PARALISADA
  CONCLUIDA
  CANCELADA
  EMBARGADA

enum TipoLicenca {
  LICENCA_CONSTRUCAO
  LICENCA_DEMOLICAO
  LICENCA_REFORMA
  HABITE_SE
  LICENCA_LOCALIZACAO
  ALVARA_FUNCIONAMENTO
  PARCELAMENTO_SOLO
  REGULARIZACAO

enum SituacaoLicencaObra {
  REQUERIDA
  EM_ANALISE
  APROVADA
  INDEFERIDA
  VENCIDA
  CANCELADA
  AGUARDANDO_CORRECAO

enum TipoVistoriaObras {
  INICIAL
  ANDAMENTO
  CONCLUSAO
  EMBARGO
  ESPECIAL

enum ResultadoVistoriaObras {
  APROVADO
  APROVADO_COM_RESSALVAS
  REPROVADO
  EMBARGADO

enum SituacaoEmbargo {
  ATIVO
  CUMPRIDO
  SUSPENSO_LIMINAR
  CANCELADO

enum OrigemEmbargo {
  VISTORIA_FISCAL
  DENUNCIA
  DETERMINACAO_JUDICIAL
  MINISTERIO_PUBLICO

model Obra {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "OBR-2026-00001"

  // Identificação
  titulo      String
  descricao   String?  @db.Text
  tipo        TipoObra
  situacao    SituacaoObra @default(PLANEJAMENTO)

  // Localização
  logradouro  String?
  bairro      String?
  cep         String?
  lat         Float?
  lng         Float?

  // Responsáveis
  secretariaResponsavel String?
  nomeResponsavel       String?
  empresaExecutora      String?
  cnpjEmpresa           String?
  responsavelTecnico    String?
  creaResponsavel       String?
  artNumero             String?    // Nº ART (Anotação de Responsabilidade Técnica)

  // Financeiro
  valorOrcado     Decimal @db.Decimal(15,2) @default(0)
  valorContratado Decimal @db.Decimal(15,2) @default(0)
  valorExecutado  Decimal @db.Decimal(15,2) @default(0)
  fonteCusteio    String?            // Ex: "PAC", "Convênio 123", "Tesouro Municipal"
  numeroConvenio  String?

  // Datas
  dataInicioPrevisto  DateTime?
  dataFimPrevisto     DateTime?
  dataInicioReal      DateTime?
  dataFimReal         DateTime?

  // Progresso
  percentualFisico    Int @default(0)   // 0–100%
  percentualFinanceiro Int @default(0)  // 0–100%

  // Medições
  areaConstruida  Float?    // m²
  extensaoMetros  Float?    // metros lineares (para vias/calçadas)
  unidadesAtendidas Int?

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  medicoes   MedicaoObra[]
  vistorias  VistoriaObra[]
  embargos   EmbargoObra[]
  licencas   LicencaObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])

model MedicaoObra {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "MED-2026-001"
  obraId      String

  periodo          String    // "2026-01", "2026-02" etc.
  dataReferencia   DateTime
  dataMedicao      DateTime  @default(now())

  // Valores medidos
  valorMedido         Decimal @db.Decimal(15,2)
  percentualMedido    Int
  percentualAcumulado Int

  // Materiais + BDI + Deduções
  bdi        Decimal @db.Decimal(5,2) @default(0)   // Bonificação e Despesas Indiretas (%)
  retencoes  Decimal @db.Decimal(15,2) @default(0)  // Retenções
  valorLiquido Decimal @db.Decimal(15,2)

  observacoes String? @db.Text
  medicidoPor String?
  aprovado    Boolean @default(false)
  aprovadoPor String?
  aprovadoEm  DateTime?

  usuarioId String?
  criadoEm  DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, obraId])

model LicencaObra {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "LIC-2026-00001"

  tipo      TipoLicenca
  situacao  SituacaoLicencaObra @default(REQUERIDA)

  // Requerente
  nomeRequerente  String
  cpfCnpjRequerente String?
  telefoneRequerente String?
  emailRequerente    String?

  // Imóvel / endereço
  logradouro  String?
  numero      String?  @map("numeroEndereco")
  bairro      String?
  cep         String?
  inscricaoCadastral String?

  // Técnico responsável
  responsavelTecnico String?
  creaRt             String?
  artNumeroLic       String?

  // Dados do projeto
  areaTotal      Float?
  areaConstruida Float?
  numeroPavimentos Int?
  finalidade     String?   // "Residencial unifamiliar", "Comercial", etc.

  // Datas / prazo
  dataRequerimento DateTime @default(now())
  dataAnalise      DateTime?
  dataExpedicao    DateTime?
  dataVencimento   DateTime?
  motivoIndeferimento String? @db.Text

  // Vínculo com obra pública (opcional)
  obraId String?
  obra   Obra? @relation(fields: [obraId], references: [id])

  observacoes  String? @db.Text
  usuarioId    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  vistorias VistoriaObra[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])

model VistoriaObra {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "VSO-2026-00001"

  obraId      String?
  licencaId   String?

  tipo        TipoVistoriaObras
  dataVistoria DateTime
  resultado   ResultadoVistoriaObras

  fiscalNome  String?
  creaFiscal  String?
  observacoes String? @db.Text
  laudoTecnico String? @db.Text
  prazoCorrecao DateTime?

  // Fotos / documentos (referências de caminho)
  fotosUrls   String? @db.Text  // JSON array

  usuarioId String?
  criadoEm  DateTime @default(now())

  obra    Obra?        @relation(fields: [obraId], references: [id])
  licenca LicencaObra? @relation(fields: [licencaId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, obraId])

model EmbargoObra {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "EMB-2026-00001"

  obraId    String
  situacao  SituacaoEmbargo @default(ATIVO)
  origem    OrigemEmbargo

  motivoEmbargo String  @db.Text
  dispositivoLegal String?    // "Lei 9.605/1998, Art. 50"

  dataEmbargo   DateTime  @default(now())
  dataLevantamento DateTime?
  motivoLevantamento String? @db.Text

  // Auto de embargo
  fiscalNome String?
  testemunha1 String?
  testemunha2 String?

  usuarioId String?
  criadoEm  DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, obraId, situacao])

// ─── schema-orcamento.prisma ───
// ─── ERP Municipal — Módulo ORÇAMENTO MUNICIPAL ───────────────────────────────
// Lei 4.320/1964 — Estatuto das Finanças Públicas (normas de elaboração e controle)
// LC 101/2000 — Lei de Responsabilidade Fiscal (LRF)
// CF/88 Arts. 165-169 — PPA, LDO, LOA obrigatórios
// Portaria SOF/MF 71/2021 — Classificação Funcional-Programática
// Portaria Interministerial STN/SOF 163/2001 — plano de contas
// Decreto 93.872/1986 — execução financeira
// IN STN 1/2017 — SICONF
  url      = env("DATABASE_URL")

// ─── Enums ────────────────────────────────────────────────────────────────────

// Classificação por natureza de despesa (Portaria STN/SOF 163/2001)
enum NaturezaDespesa {
  PESSOAL_ENCARGOS        // 3.1 — maior fatia das despesas municipais
  JUROS_ENCARGOS_DIVIDA   // 3.2 — serviço da dívida pública
  OUTRAS_CORRENTES        // 3.3 — material consumo, serviços, diárias
  INVESTIMENTOS           // 4.4 — obras, equipamentos
  INVERSOES_FINANCEIRAS   // 4.5 — aquisição imóveis, participações
  AMORTIZACAO_DIVIDA      // 4.6 — principal da dívida
  RESERVA_CONTINGENCIA    // 9.9

// Categorias econômicas
enum CategoriaEconomica {
  CORRENTE    // custeio das atividades
  CAPITAL     // expansão patrimonial

// Modalidade de aplicação
enum ModalidadeAplicacao {
  APLICACOES_DIRETAS         // 90
  TRANSFERENCIAS_MUNICIPIOS  // 40
  TRANSFERENCIAS_ENTIDADES   // 50
  TRANSFERENCIAS_EXTERIOR    // 71
  APLICACOES_INTRA_ORCAMENTARIAS // 91

enum SituacaoLOA {
  ELABORACAO
  ENVIADA_CAMARA     // enviada à Câmara Municipal
  APROVADA_CAMARA
  PROMULGADA          // Lei aprovada
  VIGENTE
  ENCERRADA

enum SituacaoLDO {
  ELABORACAO
  ENVIADA_CAMARA
  APROVADA
  VIGENTE
  ENCERRADA

enum TipoSuplemento {
  SUPLEMENTAR      // reforça dotação existente (Art. 41 I Lei 4.320)
  ESPECIAL         // cria dotação nova (Art. 41 II)
  EXTRAORDINARIO   // calamidade/guerra (Art. 41 III — MP)
  REMANEJAMENTO    // cancela para suplementar

enum FonteSuplemento {
  EXCESSO_ARRECADACAO
  SUPERAVIT_FINANCEIRO
  ANULACAO_DOTACAO
  OPERACAO_CREDITO
  RESERVA_CONTINGENCIA

enum SituacaoEmpenho {
  EMITIDO
  LIQUIDADO
  PAGO
  ANULADO
  CANCELADO

enum TipoEmpenho {
  ORDINARIO   // valor certo (Art. 60 Lei 4.320)
  ESTIMATIVO  // valor aproximado (contratos de duração continuada)
  GLOBAL      // contratos parcelados

// ─── PPA — Plano Plurianual ───────────────────────────────────────────────────
// CF/88 Art. 165 §1 — vigência 4 anos; metas e prioridades
// Enviado ao Legislativo até 31/08 do primeiro ano de mandato

model PPA {
  id          String   @id @default(cuid())
  municipioId String

  exercicioInicio Int   // ex: 2026
  exercicioFim    Int   // ex: 2029
  titulo          String
  descricao       String? @db.Text
  situacao        String  @default('ELABORACAO') // ELABORACAO/APROVADO/VIGENTE/ENCERRADO
  urlLei          String?
  numeroLei       String?

  programas       ProgramaPPA[]

  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([municipioId])

model ProgramaPPA {
  id          String   @id @default(cuid())
  ppaId       String
  municipioId String

  codigo      String     // ex: "0001"
  nome        String
  objetivo    String? @db.Text
  publicoAlvo String?
  indicador   String?    // indicador de resultado
  unidadeMedida String?

  acoes       AcaoPPA[]

  ppa         PPA @relation(fields: [ppaId], references: [id])

  @@index([ppaId])
  @@index([municipioId])

model AcaoPPA {
  id          String   @id @default(cuid())
  programaId  String
  municipioId String

  codigo      String   // ex: "2001"
  nome        String
  tipo        String   // PROJETO/ATIVIDADE/OPERACAO_ESPECIAL
  unidadeResponsavel String?

  // Metas físicas e financeiras por exercício
  meta2026    Decimal? @db.Decimal(15,2)
  meta2027    Decimal? @db.Decimal(15,2)
  meta2028    Decimal? @db.Decimal(15,2)
  meta2029    Decimal? @db.Decimal(15,2)

  valor2026   Decimal? @db.Decimal(15,2)
  valor2027   Decimal? @db.Decimal(15,2)
  valor2028   Decimal? @db.Decimal(15,2)
  valor2029   Decimal? @db.Decimal(15,2)

  programa    ProgramaPPA @relation(fields: [programaId], references: [id])

  @@index([programaId])

// ─── LDO — Lei de Diretrizes Orçamentárias ────────────────────────────────────
// CF/88 Art. 165 §2 — metas e prioridades para o exercício seguinte
// LRF Art. 4 — Anexo de Metas Fiscais e Anexo de Riscos Fiscais
// Enviada ao Legislativo até 15/04

model LDO {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int   // exercício de vigência
  titulo      String
  situacao    SituacaoLDO @default(ELABORACAO)
  urlLei      String?
  numeroLei   String?

  // LRF — Metas Fiscais (Art. 4 §1)
  metaReceitaCorrente    Decimal? @db.Decimal(15,2)
  metaDespesaCorrente    Decimal? @db.Decimal(15,2)
  metaResultadoPrimario  Decimal? @db.Decimal(15,2)
  metaResultadoNominal   Decimal? @db.Decimal(15,2)
  metaDividaConsolidada  Decimal? @db.Decimal(15,2)
  limitePessoalPct       Decimal? @db.Decimal(5,2)  // % RCL (LRF Art. 19: 54%)

  // Metas de investimento
  metaInvestimento       Decimal? @db.Decimal(15,2)

  observacoes String? @db.Text

  metas       MetaLDO[]

  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, exercicio])

model MetaLDO {
  id      String @id @default(cuid())
  ldoId   String
  tipo    String // FISCAL/FISICA/INVESTIMENTO
  descricao String
  valor   Decimal? @db.Decimal(15,2)
  unidade String?

  ldo     LDO @relation(fields: [ldoId], references: [id])

// ─── LOA — Lei Orçamentária Anual ─────────────────────────────────────────────
// Lei 4.320/1964 Art. 2-7 — conteúdo obrigatório
// CF/88 Art. 165 §5 — conteúdo consolidado
// Enviada ao Legislativo até 30/09 (federais); municípios seguem LOM

model LOA {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  titulo      String
  situacao    SituacaoLOA @default(ELABORACAO)
  urlLei      String?
  numeroLei   String?

  // Totais aprovados
  totalReceita Decimal? @db.Decimal(15,2)
  totalDespesa Decimal? @db.Decimal(15,2)

  observacoes  String? @db.Text

  unidades     UnidadeOrcamentaria[]
  suplementos  Suplemento[]

  usuarioId    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, exercicio])
  @@index([municipioId])

// ─── Unidade Orçamentária ────────────────────────────────────────────────────
// órgão/unidade (ex: 02.01 — Secretaria de Educação — Gestão)

model UnidadeOrcamentaria {
  id          String   @id @default(cuid())
  loaId       String
  municipioId String

  codigo      String   // ex: "02.01"
  orgao       String   // ex: "02"
  unidade     String   // ex: "01"
  nome        String

  dotacoes    Dotacao[]

  loa         LOA @relation(fields: [loaId], references: [id])

  @@index([loaId])
  @@index([municipioId])

// ─── Dotação Orçamentária ──────────────────────────────────────────────────
// Elemento mínimo do orçamento: orgao.unidade.funcao.subfuncao.programa.acao.natureza.fonte

model Dotacao {
  id          String   @id @default(cuid())
  unidadeId   String
  loaId       String
  municipioId String
  exercicio   Int

  // Classificação funcional-programática
  funcao      String   // ex: "12" (Educação)
  subfuncao   String   // ex: "361" (Ensino Fundamental)
  programa    String   // código do programa
  acao        String   // código da ação/projeto/atividade
  natureza    NaturezaDespesa
  categoria   CategoriaEconomica
  modalidade  ModalidadeAplicacao @default(APLICACOES_DIRETAS)
  fonte       String   // fonte de recurso ex: "01" Tesouro, "12" FUNDEB

  // Descrição
  descricao   String
  codigoFull  String   // "02.01.12.361.0001.2001.3390.01"

  // Valores
  valorDotacao    Decimal @db.Decimal(15,2)   // dotação inicial aprovada
  valorSuplementado Decimal @db.Decimal(15,2) @default(0)
  valorCancelado  Decimal @db.Decimal(15,2) @default(0)
  // valorAtual = dotacao + suplementado - cancelado (computed na query)

  // Execução (denormalizado para performance)
  valorEmpenhado  Decimal @db.Decimal(15,2) @default(0)
  valorLiquidado  Decimal @db.Decimal(15,2) @default(0)
  valorPago       Decimal @db.Decimal(15,2) @default(0)

  empenhos    Empenho[]
  unidade     UnidadeOrcamentaria @relation(fields: [unidadeId], references: [id])
  loa         LOA @relation(fields: [loaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([loaId])
  @@index([municipioId, exercicio])
  @@index([municipioId, funcao])
  @@index([municipioId, natureza])

// ─── Suplemento de Crédito Adicional ─────────────────────────────────────────
// Art. 41-43 Lei 4.320/1964
// Suplementares: autorização na LOA; Especiais/Extraordinários: Lei específica

model Suplemento {
  id          String   @id @default(cuid())
  loaId       String
  municipioId String

  numero      String   // "SUP-2026-001"
  tipo        TipoSuplemento
  fonte       FonteSuplemento
  justificativa String @db.Text
  valor       Decimal  @db.Decimal(15,2)
  urlDecreto  String?
  numeroDecreto String?
  dataDecreto DateTime?

  // Dotações afetadas (origem e destino em JSON)
  dotacoesOrigem  String? @db.Text  // JSON: [{dotacaoId, valor}]
  dotacoesDestino String? @db.Text  // JSON: [{dotacaoId, valor}]

  situacao    String @default('PENDENTE') // PENDENTE/APROVADO/CANCELADO

  loa         LOA @relation(fields: [loaId], references: [id])

  usuarioId   String?
  criadoEm    DateTime @default(now())

  @@index([loaId])
  @@index([municipioId])

// ─── Empenho ──────────────────────────────────────────────────────────────────
// Art. 58-60 Lei 4.320/1964 — 1º estágio da despesa
// Empenho → Liquidação → Pagamento

model Empenho {
  id          String   @id @default(cuid())
  dotacaoId   String
  municipioId String
  exercicio   Int

  numero      String   // "EMP-2026-001"
  tipo        TipoEmpenho @default(ORDINARIO)
  situacao    SituacaoEmpenho @default(EMITIDO)

  // Credor
  credorNome  String
  credorCNPJ  String?
  credorCPF   String?

  // Referência
  processoId  String?   // licitação, nota de empenho
  contratoId  String?
  descricao   String    @db.Text

  // Valores
  valorEmpenho   Decimal @db.Decimal(15,2)
  valorLiquidado Decimal @db.Decimal(15,2) @default(0)
  valorPago      Decimal @db.Decimal(15,2) @default(0)
  valorAnulado   Decimal @db.Decimal(15,2) @default(0)

  // Datas
  dataEmpenho   DateTime
  dataLiquidacao DateTime?
  dataPagamento  DateTime?
  dataVencimento DateTime?

  // Referência fiscal
  notaFiscal  String?
  urlDocumento String?

  liquidacoes LiquidacaoEmpenho[]
  pagamentos  PagamentoEmpenho[]
  dotacao     Dotacao @relation(fields: [dotacaoId], references: [id])

  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, numero])
  @@index([dotacaoId])
  @@index([municipioId, exercicio])
  @@index([municipioId, credorCNPJ])
  @@index([municipioId, situacao])

// ─── Liquidação ───────────────────────────────────────────────────────────────
// Art. 63-65 Lei 4.320/1964 — 2º estágio: verificação do direito do credor

model LiquidacaoEmpenho {
  id          String   @id @default(cuid())
  empenhoId   String
  municipioId String

  valor       Decimal  @db.Decimal(15,2)
  dataLiquidacao DateTime
  notaFiscal  String?
  descricao   String?

  empenho     Empenho @relation(fields: [empenhoId], references: [id])
  criadoEm    DateTime @default(now())

  @@index([empenhoId])

// ─── Pagamento ────────────────────────────────────────────────────────────────
// Art. 64-65 Lei 4.320/1964 — 3º estágio: extinção da obrigação

model PagamentoEmpenho {
  id          String   @id @default(cuid())
  empenhoId   String
  municipioId String

  valor       Decimal  @db.Decimal(15,2)
  dataPagamento DateTime
  formaPagamento String? // TRANSFERENCIA/CHEQUE/ORDEM_BANCARIA
  contaBancaria  String?
  numeroPagamento String?
  observacao  String?

  empenho     Empenho @relation(fields: [empenhoId], references: [id])
  criadoEm    DateTime @default(now())

  @@index([empenhoId])

// ─── schema-ouvidoria.prisma ───
// ─── OUVIDORIA MUNICIPAL ──────────────────────────────────────────────────────
// Lei 13.460/2017 — Código de Defesa do Usuário do Serviço Público
// Lei 12.527/2011 (LAI) — Acesso à Informação — prazo 20d + 10d prorrogação
// Decreto 9.492/2018 — regulamenta Ouvidoria Federal
// CGU — Sistema de Ouvidoria do Poder Executivo Federal (boas práticas)

enum TipoManifestacao {
  RECLAMACAO          // insatisfação com serviço/servidor
  SUGESTAO            // ideia para melhorar serviço
  ELOGIO              // reconhecimento/agradecimento
  DENUNCIA            // irregularidade (pode ser anônima)
  SOLICITACAO_INFO    // Lei de Acesso à Informação 12.527/2011
  SOLICITACAO_SERVICO // pedido de prestação de serviço

enum SituacaoManifestacao {
  RECEBIDA            // nova, aguarda triagem
  EM_ANALISE          // em análise pela unidade responsável
  AGUARDANDO_RESP     // aguardando resposta do setor
  RESPONDIDA          // resposta emitida, aguarda avaliação do cidadão
  ENCERRADA           // processo concluído
  ARQUIVADA           // arquivada sem resolução (prazo expirado, inválida)
  DEVOLVIDA           // devolvida ao manifestante (complementação necessária)

enum NivelSatisfacao {
  MUITO_SATISFEITO
  SATISFEITO
  NEUTRO
  INSATISFEITO
  MUITO_INSATISFEITO

model Manifestacao {
  id              String                  @id @default(cuid())
  municipioId     String
  protocolo       String                  // "OUV-2026-00001"

  tipo            TipoManifestacao
  situacao        SituacaoManifestacao    @default(RECEBIDA)
  assunto         String
  descricao       String                  @db.Text
  secretariaDestino String?               // órgão responsável
  prioridade      String                  @default("NORMAL")  // BAIXA, NORMAL, ALTA, URGENTE

  // Prazos (LAI: 20 dias úteis + 10 de prorrogação)
  prazoResposta   DateTime                // calculado ao criar
  prorrogado      Boolean                 @default(false)
  prazoApos       DateTime?               // prazo após prorrogação

  // Manifestante — pode ser anônimo
  anonima         Boolean                 @default(false)
  nomeManifestante  String?
  cpfManifestante   String?
  emailManifestante String?
  telefoneManifestante String?
  enderecoManifestante String?

  // LAI específico
  lai             Boolean                 @default(false)      // Solicitação de Acesso à Informação
  recurso         Boolean                 @default(false)      // é recurso de outra manifestação?
  manifestacaoOrigem String?              // protocolo de origem (recurso)

  // Avaliação pelo cidadão
  avaliado        Boolean                 @default(false)
  satisfacao      NivelSatisfacao?
  comentarioAval  String?                 @db.Text
  avaliadoEm      DateTime?

  // Rastreamento
  usuarioResponsavel String?
  atribuidoA      String?               // técnico responsável
  usuarioId       String?
  criadoEm        DateTime              @default(now())
  atualizadoEm    DateTime              @updatedAt

  movimentacoes   MovimentacaoManifestacao[]
  respostas       RespostaManifestacao[]

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, prazoResposta])
  @@index([municipioId, secretariaDestino])

model MovimentacaoManifestacao {
  id              String                  @id @default(cuid())
  municipioId     String
  manifestacaoId  String
  situacaoDe      SituacaoManifestacao
  situacaoPara    SituacaoManifestacao
  motivo          String?                 @db.Text
  usuarioId       String?
  criadoEm        DateTime                @default(now())

  manifestacao    Manifestacao            @relation(fields: [manifestacaoId], references: [id])

  @@index([manifestacaoId])

model RespostaManifestacao {
  id              String      @id @default(cuid())
  municipioId     String
  manifestacaoId  String
  texto           String      @db.Text
  tipo            String      @default("OFICIAL")  // OFICIAL, COMPLEMENTO, INTERNO (nota interna)
  remetente       String?
  publica         Boolean     @default(true)       // visível ao manifestante
  usuarioId       String?
  criadoEm        DateTime    @default(now())

  manifestacao    Manifestacao @relation(fields: [manifestacaoId], references: [id])

  @@index([manifestacaoId])

