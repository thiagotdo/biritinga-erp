  @@index([municipioId, situacao])
}

model ResultadoEsportivo {
  id            String    @id @default(cuid())
  municipioId   String
  atletaId      String
  competicao    String
  modalidade    ModalidadeEsportiva
  categoria     CategoriaAtleta
  data          DateTime
  local         String?
  colocacao     Int?       // 1º, 2º, 3º ...
  medalha       String?    // OURO / PRATA / BRONZE
  marca         String?    // tempo, distância, pontos
  observacoes   String?
  createdAt     DateTime   @default(now())

  atleta        Atleta    @relation(fields: [atletaId], references: [id])

  @@index([atletaId])
  @@index([municipioId, data])
}

model PontoTuristico {
  id              String             @id @default(cuid())
  municipioId     String
  nome            String
  tipo            TipoPontoTuristico
  descricao       String?
  historia        String?
  endereco        String?
  bairro          String?
  coordLat        Float?
  coordLng        Float?
  horarioVisita   String?
  valorEntrada    Decimal?           @db.Decimal(10,2)
  capacidadeDiaria Int?
  contato         String?
  site            String?
  fotos           String?            // JSON array URLs
  destaque        Boolean            @default(false)
  ativo           Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([municipioId, tipo])
  @@index([municipioId, destaque])
}

enum TipoServico {
  COLETA_LIXO
  COLETA_SELETIVA
  CAPINA
  ROCAGEM
  PODA_ARVORE
  TAPA_BURACO
  MANUTENCAO_CALCADA
  LIMPEZA_VALA
  LIMPEZA_LOGRADOURO
  DEDETIZACAO
  MANUTENCAO_PRACA
  ILUMINACAO_PUBLICA
  SINALIZACAO_VIARIA
  MANUTENCAO_ESTRADA_RURAL
  OUTROS
}

enum PrioridadeOS {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum SituacaoOS {
  ABERTA
  EM_ATENDIMENTO
  AGUARDANDO_MATERIAL
  CONCLUIDA
  CANCELADA
  REABERTA
}

enum OrigemOS {
  PROGRAMADA
  DEMANDA_CIDADAO
  OUVIDORIA
  DETERMINACAO_SUPERIOR
  VISTORIA
  EMERGENCIA
}

enum SituacaoRoteiro {
  PROGRAMADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
  INTERROMPIDO
}

model OrdemServico {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "OS-2026-00001"

  tipo        TipoServico
  prioridade  PrioridadeOS @default(NORMAL)
  situacao    SituacaoOS @default(ABERTA)
  origem      OrigemOS @default(PROGRAMADA)

  // Localização
  logradouro  String?
  bairro      String?
  referencia  String?
  lat         Float?
  lng         Float?

  // Descrição
  descricao   String   @db.Text
  observacoes String?  @db.Text
  solicitante String?
  telefone    String?

  // Atribuição
  equipeResponsavel String?
  veiculoId         String?

  // Datas
  dataAbertura  DateTime @default(now())
  dataLimite    DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?

  // Material utilizado (JSON)
  materiaisUsados String? @db.Text

  // Avaliação
  avaliacao   Int?
  feedbackCidadao String? @db.Text

  // Vínculo ouvidoria
  protocoloOuvidoria String?

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, bairro])
}

model ManutencaoVeiculo {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "MNT-2026-00001"
  veiculoId   String

  tipo        String
  descricao   String   @db.Text
  oficina     String?
  kmMedicao   Int?
  valor       Decimal  @db.Decimal(10,2) @default(0)
  dataEntrada DateTime @default(now())
  dataSaida   DateTime?
  observacoes String?  @db.Text
  concluida   Boolean  @default(false)

  usuarioId String?
  criadoEm  DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId, veiculoId])
}

model AbastecimentoVeiculo {
  id          String   @id @default(cuid())
  municipioId String
  veiculoId   String

  dataAbastecimento DateTime @default(now())
  combustivel  String
  litros       Float
  valorLitro   Decimal @db.Decimal(6,3)
  valorTotal   Decimal @db.Decimal(10,2)
  kmAtual      Int?
  posto        String?
  condutorNome String?

  usuarioId String?
  criadoEm  DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, veiculoId])
}

model RoteiroColeta {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "ROT-2026-001"

  nome         String
  tipo         String
  situacao     SituacaoRoteiro @default(PROGRAMADO)
  diaSemana    String?
  periocidade  String?

  dataHoraInicio  DateTime?
  dataHoraFim     DateTime?
  responsavelNome String?

  toneladas    Float?
  kmPercorrido Float?
  observacoes  String? @db.Text

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())

  itens ItemRoteiro[]

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
}

model ItemRoteiro {
  id          String   @id @default(cuid())
  municipioId String
  roteiroId   String
  veiculoId   String?

  logradouro  String
  bairro      String?
  sequencia   Int
  estimativaKg Float?

  concluido    Boolean  @default(false)
  kgColetado   Float?
  horaConclusao DateTime?

  roteiro RoteiroColeta @relation(fields: [roteiroId], references: [id])
  veiculo Veiculo? @relation(fields: [veiculoId], references: [id])

  @@index([municipioId, roteiroId])
}

enum TipoPublicacao {
  RECEITA_PREVISTA
  RECEITA_REALIZADA
  DESPESA_ORCADA
  DESPESA_EMPENHADA
  DESPESA_LIQUIDADA
  DESPESA_PAGA
  LICITACAO
  CONTRATO
  CONVENIO
  FOLHA_PAGAMENTO
  BALANCETE
  BALANCO_ANUAL
  RELATORIO_LRF       // RREO / RGF
  DIARIO_OFICIAL
  ATA_CAMARA
  DECRETO
  PORTARIA
  RESOLUCAO
}

enum SituacaoPublicacao {
  RASCUNHO
  PUBLICADA
  RETIFICADA
  REVOGADA
}

enum PeriodoLRF {
  BIMESTRAL_1   // jan-fev
  BIMESTRAL_2   // mar-abr
  BIMESTRAL_3   // mai-jun
  BIMESTRAL_4   // jul-ago
  BIMESTRAL_5   // set-out
  BIMESTRAL_6   // nov-dez
  QUADRIMESTRAL_1 // jan-abr
  QUADRIMESTRAL_2 // mai-ago
  QUADRIMESTRAL_3 // set-dez
  ANUAL
}

model PublicacaoTransparencia {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoPublicacao
  situacao    SituacaoPublicacao @default(PUBLICADA)

  titulo      String
  descricao   String?  @db.Text
  periodo     String?           // "2026-01", "2026", "1º Bimestre 2026"
  exercicio   Int?              // ano de referência

  // Valor consolidado (quando aplicável)
  valorTotal  Decimal? @db.Decimal(15,2)

  // Arquivo
  urlArquivo  String?
  nomeArquivo String?
  tamanho     Int?

  tags        String?           // busca full-text

  publicadoEm DateTime @default(now())
  usuarioId   String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, tipo])
  @@index([municipioId, exercicio])
  @@index([municipioId, situacao])
}

model ReceitaOrcamentaria {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  mes         Int               // 1–12
  competencia String            // "2026-01"

  // Classificação
  codigoReceita String          // ex: "1.1.1.0.00" — IRRF
  natureza      NaturezaReceita
  descricao     String
  fonte         String?         // ex: "Recursos Próprios"
  unidadeGestora String?

  // Valores
  previsto      Decimal  @db.Decimal(15,2) @default(0)
  arrecadado    Decimal  @db.Decimal(15,2) @default(0)

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, competencia, codigoReceita])
  @@index([municipioId, exercicio])
  @@index([municipioId, competencia])
  @@index([municipioId, natureza])
}

model DespesaOrcamentaria {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  mes         Int
  competencia String

  // Classificação funcional-programática
  orgao        String            // ex: "02 — Secretaria de Educação"
  unidade      String?
  funcao       String?           // ex: "12 — Educação"
  subfuncao    String?
  programa     String?
  acao         String?
  natureza     NaturezaDespesa

  // Classificação econômica
  elementoDespesa String?       // ex: "3390.39 — Outros Serv. Terceiros PJ"

  descricao    String
  fonte        String?

  // Estágios
  orcado       Decimal  @db.Decimal(15,2) @default(0)
  empenhado    Decimal  @db.Decimal(15,2) @default(0)
  liquidado    Decimal  @db.Decimal(15,2) @default(0)
  pago         Decimal  @db.Decimal(15,2) @default(0)

  // Credor (quando aplicável)
  credorNome   String?
  credorCPFCNPJ String?

  // Documento
  numeroEmpenho String?
  documentoFiscal String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, exercicio])
  @@index([municipioId, competencia])
  @@index([municipioId, natureza])
  @@index([municipioId, credorCPFCNPJ])
}

model RelatorioLRF {
  id          String   @id @default(cuid())
  municipioId String

  tipo        String            // RREO ou RGF
  periodo     PeriodoLRF
  exercicio   Int
  situacao    SituacaoPublicacao @default(RASCUNHO)

  // Dados consolidados
  receitaRealizada  Decimal? @db.Decimal(15,2)
  despesaRealizada  Decimal? @db.Decimal(15,2)
  resultadoPrimario Decimal? @db.Decimal(15,2)
  dividaConsolidada Decimal? @db.Decimal(15,2)
  despesaPessoal    Decimal? @db.Decimal(15,2)
  limitePessoal     Decimal? @db.Decimal(15,2)   // % da RCL

  // LRF Art. 55 — dívida consolidada líquida
  dividaConsolidadaLiquida Decimal? @db.Decimal(15,2)
  receitaCorrenteLiquida   Decimal? @db.Decimal(15,2)

  urlArquivo  String?
  observacoes String? @db.Text

  publicadoEm DateTime?
  dataEnvioSIAPE DateTime?
  dataEnvioSIAFIC DateTime?

  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, tipo, periodo, exercicio])
  @@index([municipioId, exercicio])
}
