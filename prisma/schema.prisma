// ─── Evento Cultural / Esportivo ──────────────────────────────────────────────

model EventoCultural {
  id              String        @id @default(cuid())
  municipioId     String
  codigo          String        // "EV-2026-001"
  titulo          String
  tipo            TipoEvento
