  usuarioId   String?
  createdAt   DateTime  @default(now())

  processo    ProcessoJuridico @relation(fields: [processoId], references: [id])

  @@index([processoId, data])
}

model DocumentoProcesso {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  nome        String
  tipo        String    // "Petição inicial", "Contestação", "Recurso", etc.
  url         String?
  usuarioId   String?
  createdAt   DateTime  @default(now())

  processo    ProcessoJuridico @relation(fields: [processoId], references: [id])

