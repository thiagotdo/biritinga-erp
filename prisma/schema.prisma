model LicencaAmbiental {
  id            String          @id @default(cuid())
  municipioId   String
  numero        String          // ex: "LA-2025-001"
  tipo          TipoLicenca
  status        StatusLicenca   @default(EM_ANALISE)

  // Requerente
  requerenteNome   String
  requerenteCpfCnpj String
  requerenteTelefone String?
  requerenteEmail  String?

  // Empreendimento
  empreendimentoNome String
  atividadePrincipal String    // CNAE / descrição
  localizacao        String
  coordLat           Decimal?  @db.Decimal(10, 7)
  coordLng           Decimal?  @db.Decimal(10, 7)
  areaHectares       Decimal?  @db.Decimal(10, 4)

  // Prazos e valores
  dataRequerimento   DateTime  @default(now())
  dataEmissao        DateTime?
  dataVencimento     DateTime?
  valorTaxa          Decimal?  @db.Decimal(10, 2)
  dataPagamento      DateTime?

  // Condicionantes
  condicionantes     String?   @db.Text
  observacao         String?   @db.Text
  parecerTecnico     String?   @db.Text
  tecnicoResponsavel String?

  ativo          Boolean       @default(true)
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  autuacoes      AutoInfracaoAmbiental[]


  produtores  ProdutorRural[]
  @@unique([municipioId, numero])
  @@index([municipioId, tipo, status])
  @@map("licenca_ambiental")
}

