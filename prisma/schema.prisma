  dataEmissao     DateTime?
  ementa          String?               // resumo do parecer
  fundamentacao   String?               // fundamentação jurídica
  conclusao       String?
  ressalvas       String?
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@index([municipioId, prazoResposta])
