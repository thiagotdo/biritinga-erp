generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Municipio {
  id        String   @id @default(cuid())
  nome      String
  uf        String   @db.Char(2)
  ibge      String   @unique            // código IBGE 7 dígitos
  cnpj      String?  @unique
  slug      String   @unique            // "biritinga" → biritinga.ba.gov.br
  dominio   String?                     // domínio personalizado
  logoUrl   String?
  corPrimaria String? @db.Char(7)       // "#1a56db"
  ativo     Boolean  @default(true)
  plano     String   @default("basico") // "basico" | "pro" | "enterprise"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  perfis    Perfil[]
  auditLogs AuditLog[]
  sessoes   Sessao[]

  cargos  Cargo[]
  documentos  Documento[]
  patrimonioItens  PatrimonioItem[]
  protocolos  Protocolo[]
  secretarias  Secretaria[]
  veiculos  Veiculo[]
}

enum PerfilPadrao {
  SUPER_ADMIN       // Anthropic / suporte — acesso total
  ADMIN_MUNICIPIO   // Secretário ou TI do município
  GESTOR            // gerente de secretaria
  OPERADOR          // servidor comum
  VISUALIZADOR      // somente leitura
  PORTAL_CIDADAO    // usuário externo (cidadão)
}

model Usuario {
  id            String       @id @default(cuid())
  municipioId   String
  nome          String
  email         String
  senhaHash     String
  cpf           String?
  telefone      String?
  cargo         String?
  secretaria    String?
  perfil        PerfilPadrao @default(OPERADOR)
  perfilId      String?      // Perfil customizado (sobrescreve perfil padrão)
  ativo         Boolean      @default(true)
  mfaAtivado    Boolean      @default(false)
  mfaSegredo    String?
  ultimoLogin   DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte  DateTime?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  municipio     Municipio    @relation(fields: [municipioId], references: [id])
  perfilCustom  Perfil?      @relation(fields: [perfilId], references: [id])
  sessoes       Sessao[]
  auditLogs     AuditLog[]


  permissoes  UsuarioPermissao[]
  documentos  Documento[]
  protocolosSolicitante  Protocolo[] @relation("ProtocoloSolicitante")
  protocolosResponsavel  Protocolo[] @relation("ProtocoloResponsavel")
  cargos  Cargo[]
  coordenacoes  Coordenacao[]
  departamentos  Departamento[]
  secretariasUsers  Secretaria[]
  setoresUsers  Setor[]
  unidades  Unidade[]
  @@unique([municipioId, email])
  @@unique([municipioId, cpf])
  @@index([municipioId, perfil])
  @@index([municipioId, secretaria])
}

model Perfil {
  id          String   @id @default(cuid())
  municipioId String
  nome        String                // "Procurador Chefe", "Fiscal de Obras"
  descricao   String?
  permissoes  String   @db.Text     // JSON: ["pgm:processo:create","semob:obra:read",...]
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuarios    Usuario[]

  @@unique([municipioId, nome])
  @@index([municipioId])
}

model Sessao {
  id            String    @id @default(cuid())
  municipioId   String
  usuarioId     String
  refreshToken  String    @db.Text  // hash do refresh token
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  municipio     Municipio @relation(fields: [municipioId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([municipioId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  municipioId String
  usuarioId   String?
  acao        String   // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "EXPORT"
  modulo      String   // "semad" | "sefin" | "pgm" | "auth" | ...
  recurso     String   // "usuario" | "obra" | "processo" | ...
  registroId  String?  // ID do registro afetado
  dadosAntigos String? @db.LongText  // JSON before
  dadosNovos   String? @db.LongText  // JSON after
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  municipio   Municipio @relation(fields: [municipioId], references: [id])
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([municipioId, modulo, createdAt])
  @@index([municipioId, usuarioId])
  @@index([registroId])
}

model TokenResetSenha {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiresAt DateTime
  usadoEm   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model ModuloConfig {
  id          String       @id @default(cuid())
  municipioId String

  // Identificação
  slug        String       // ex: "tributacao", "frota", "patrimonio"
  nome        String       // ex: "Tributação & Arrecadação"
  descricao   String?      // breve descrição para o painel
  icone       String?      // emoji ou nome de ícone (ex: "🏛️", "🚗", "💰")
  rota        String       // caminho Next.js, ex: "/gestao/tributos"
  categoria   String?      // ex: "Financeiro", "Operacional", "Social"
  ordem       Int          @default(0)  // ordem de exibição no painel

  // Estado de visibilidade
  estado      EstadoModulo @default(ADMIN)
  // PUBLICO   → visível para qualquer usuário autenticado
  // ADMIN     → visível apenas para usuários com role ADMIN/SUPER_ADMIN
  // DESATIVADO → oculto para todos (incluindo admin, exceto SUPER_ADMIN)

  // Auditoria
  atualizadoPor String?    // userId de quem fez a última alteração
  criadoEm    DateTime     @default(now())
  atualizadoEm DateTime    @updatedAt

  @@unique([municipioId, slug])
  @@index([municipioId, estado])
  @@map("modulo_config")
}

enum EstadoModulo {
  PUBLICO
  ADMIN
  DESATIVADO
}

enum Plano {
  BASICO
  INTERMEDIARIO
  COMPLETO
  ENTERPRISE
}

model Secretaria {
  id           String   @id @default(cuid())
  municipioId  String
  nome         String
  sigla        String   @db.VarChar(10)
  descricao    String?  @db.Text
  cor          String?
  icone        String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  municipio    Municipio      @relation(fields: [municipioId], references: [id])
  departamentos Departamento[]
  usuarios     Usuario[]
  documentos   Documento[]
  protocolos   Protocolo[]

  @@unique([municipioId, sigla])
  @@index([municipioId])
  @@map("secretarias")
}

model Departamento {
  id           String   @id @default(cuid())
  secretariaId String
  nome         String
  sigla        String?  @db.VarChar(10)
  descricao    String?  @db.Text
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  secretaria   Secretaria    @relation(fields: [secretariaId], references: [id])
  coordenacoes Coordenacao[]
  usuarios     Usuario[]


  servidores  Servidor[]
  @@index([secretariaId])
  @@map("departamentos")
}

model Coordenacao {
  id             String   @id @default(cuid())
  departamentoId String
  nome           String
  descricao      String?  @db.Text
  ativo          Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  departamento Departamento @relation(fields: [departamentoId], references: [id])
  setores      Setor[]
  usuarios     Usuario[]

  @@index([departamentoId])
  @@map("coordenacoes")
}

model Setor {
  id            String   @id @default(cuid())
  coordenacaoId String
  nome          String
  descricao     String?  @db.Text
  ativo         Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  coordenacao Coordenacao @relation(fields: [coordenacaoId], references: [id])
  unidades    Unidade[]
  usuarios    Usuario[]

  @@index([coordenacaoId])
  @@map("setores")
}

model Unidade {
  id        String   @id @default(cuid())
  setorId   String
  nome      String
  tipo      TipoUnidade @default(ADMINISTRATIVA)
  endereco  String?
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  setor    Setor    @relation(fields: [setorId], references: [id])
  usuarios Usuario[]

  @@index([setorId])
  @@map("unidades")
}

enum TipoUnidade {
  ADMINISTRATIVA
  ESCOLA
  UBS
  CRAS
  CREAS
  ALMOXARIFADO
  DEPOSITO
  OUTRO
}

model Cargo {
  id          String   @id @default(cuid())
  municipioId String
  nome        String
  cbo         String?  @db.VarChar(10)
  nivel       NivelCargo @default(OPERACIONAL)
  descricao   String?  @db.Text
  ativo       Boolean  @default(true)
  criadoEm   DateTime @default(now())

  municipio Municipio @relation(fields: [municipioId], references: [id])
  usuarios  Usuario[]


  servidores  Servidor[]
  @@unique([municipioId, nome])
  @@map("cargos")
}

enum NivelCargo {
  ESTRATEGICO   // Prefeito, Secretário
  TATICO        // Diretor, Coordenador
  OPERACIONAL   // Servidor
}

model UsuarioPermissao {
  id         String   @id @default(cuid())
  usuarioId  String
  permissao  String   // módulo:recurso:ação
  concedidoPor String
  criadoEm  DateTime @default(now())
  expiradoEm DateTime?

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permissao])
  @@index([usuarioId])
  @@map("usuario_permissoes")
}

model Documento {
  id           String   @id @default(cuid())
  municipioId  String
  secretariaId String?
  usuarioId    String

  titulo       String
  descricao    String?  @db.Text
  tipo         TipoDocumento
  categoria    String?
  tags         String?  @db.Text // JSON array

  // Armazenamento (Cloudflare R2)
  urlStorage   String
  nomeArquivo  String
  mimeType     String
  tamanhoBytes Int

  // Controle
  versao       Int      @default(1)
  hash         String?  // SHA256 para integridade
  ocr          String?  @db.LongText
  assinado     Boolean  @default(false)
  assinadoEm   DateTime?
  assinadoPor  String?

  restrito     Boolean  @default(false)
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  municipio  Municipio   @relation(fields: [municipioId], references: [id])
  secretaria Secretaria? @relation(fields: [secretariaId], references: [id])
  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  versoes    DocumentoVersao[]

  @@index([municipioId])
  @@index([secretariaId])
  @@fulltext([titulo, descricao])
  @@map("documentos")
}

model DocumentoVersao {
  id          String   @id @default(cuid())
  documentoId String
  versao      Int
  urlStorage  String
  hash        String?
  criadoPor   String
  criadoEm   DateTime @default(now())

  documento   Documento @relation(fields: [documentoId], references: [id])

  @@map("documento_versoes")
}

enum TipoDocumento {
  OFICIO
  MEMORANDO
  DESPACHO
  PORTARIA
  DECRETO
  LEI
  CONTRATO
  CONVENIO
  ATA
  RELATORIO
  LAUDO
  CERTIDAO
  REQUERIMENTO
  PARECER
  NOTA_FISCAL
  OUTRO
}

model Protocolo {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String   // Gerado: MUN-ANO-NNNNNN
  solicitanteId   String
  secretariaId    String?
  responsavelId   String?

  assunto         String
  descricao       String?  @db.Text
  categoria       String
  prioridade      Prioridade @default(NORMAL)
  status          StatusProtocolo @default(ABERTO)

  prazo           DateTime?
  resolvidoEm     DateTime?

  origem          OrigemProtocolo @default(INTERNO)
  cpfSolicitante  String?  // para cidadão externo
  nomeSolicitante String?  // para cidadão externo

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  municipio       Municipio  @relation(fields: [municipioId], references: [id])
  solicitante     Usuario    @relation("ProtocoloSolicitante", fields: [solicitanteId], references: [id])
  secretaria      Secretaria? @relation(fields: [secretariaId], references: [id])
  responsavel     Usuario?   @relation("ProtocoloResponsavel", fields: [responsavelId], references: [id])
  tramitacoes     Tramitacao[]

  @@unique([municipioId, numero])
  @@index([municipioId])
  @@index([status])
  @@map("protocolos")
}

model Tramitacao {
  id           String   @id @default(cuid())
  protocoloId  String
  usuarioId    String
  acao         String
  descricao    String   @db.Text
  despacho     String?  @db.Text
  status       StatusProtocolo
  criadoEm    DateTime @default(now())

  protocolo    Protocolo @relation(fields: [protocoloId], references: [id])

  @@index([protocoloId])
  @@map("tramitacoes")
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum StatusProtocolo {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
  ARQUIVADO
  CANCELADO
}

enum OrigemProtocolo {
  INTERNO
  CIDADAO
  EMAIL
  BALCAO
  ESIC
  OUVIDORIA
}

model PatrimonioItem {
  id           String   @id @default(cuid())
  municipioId  String
  numero       String   // Número patrimonial único por município
  descricao    String
  categoria    CategoriaPatrimonio
  marca        String?
  modelo       String?
  serie        String?
  qrCode       String?  @unique

  valor        Decimal  @db.Decimal(15, 2)
  dataAquisicao DateTime
  fornecedor   String?
  notaFiscal   String?

  estado       EstadoPatrimonio @default(BOM)
  secretariaId String?
  unidadeId    String?
  responsavel  String?
  localizacao  String?

  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  municipio    Municipio @relation(fields: [municipioId], references: [id])

  @@unique([municipioId, numero])
  @@index([municipioId])
  @@map("patrimonio_itens")
}

enum CategoriaPatrimonio {
  MOVEL
  IMOVEL
  VEICULO
  EQUIPAMENTO_TI
  EQUIPAMENTO_MEDICO
  MAQUINARIO
  OUTRO
}

enum EstadoPatrimonio {
  OTIMO
  BOM
  REGULAR
  RUIM
  INSERVIVEL
}

model Veiculo {
  id           String   @id @default(cuid())
  municipioId  String
  placa        String
  renavam      String?
  chassi       String?
  marca        String
  modelo       String
  ano          Int
  cor          String?
  tipo         TipoVeiculo
  combustivel  String?
  km           Int      @default(0)

  secretariaId String?
  status       StatusVeiculo @default(DISPONIVEL)

  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  municipio    Municipio @relation(fields: [municipioId], references: [id])


  abastecimentos  Abastecimento[]
  abastecimentosVeiculo  AbastecimentoVeiculo[]
  itensRoteiro  ItemRoteiro[]
  manutencoesVeiculo  ManutencaoVeiculo[]
  manutencoesSimples  Manutencao[]
  multasVeiculo  Multa[]
  ordensServico  OrdemServico[]
  utilizacoes  UtilizacaoVeiculo[]
  viagens  Viagem[]
  @@unique([municipioId, placa])
  @@index([municipioId])
  @@map("veiculos")
}

enum TipoVeiculo {
  CARRO
  CAMINHONETE
  VAN
  ONIBUS
  CAMINHAO
  MOTO
  TRATOR
  MAQUINA_AGRICOLA
  OUTRO
}

enum StatusVeiculo {
  DISPONIVEL
  EM_USO
  MANUTENCAO
  INATIVO
}

model Notificacao {
  id          String   @id @default(cuid())
  destinoId   String   // usuarioId
  titulo      String
  mensagem    String   @db.Text
  tipo        TipoNotificacao
  canal       CanalNotificacao @default(SISTEMA)
  referencia  String?  // "protocolo:ID", "documento:ID"
  lida        Boolean  @default(false)
  lidaEm      DateTime?
  criadoEm   DateTime @default(now())

  @@index([destinoId, lida])
  @@map("notificacoes")
}

enum TipoNotificacao {
  INFO
  ALERTA
  URGENTE
  VENCIMENTO
  APROVACAO
  REJEICAO
  TRAMITACAO
}

enum CanalNotificacao {
  SISTEMA
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

enum TipoManifestacao {
  RECLAMACAO          // descontentamento com serviço
  DENUNCIA            // irregularidade / ilegalidade
  SUGESTAO            // proposta de melhoria
  ELOGIO              // reconhecimento positivo
  SOLICITACAO_INFO    // pedido de informação (LAI)
  RECURSO_LAI         // recurso de resposta LAI
}

enum SituacaoManifestacao {
  RECEBIDA
  EM_ANALISE
  ENCAMINHADA         // para órgão competente
  EM_RESPOSTA
  RESPONDIDA
  ARQUIVADA
  CANCELADA
}

enum PrioridadeManifestacao {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

enum TipoServicoCidadao {
  DOCUMENTO           // certidão, declaração, etc.
  LICENCA             // alvará, habite-se
  FISCAL              // 2ª via boleto, parcelamento
  INFRAESTRUTURA      // solicitação de serviço urbano
  SAUDE
  EDUCACAO
  ASSISTENCIA_SOCIAL
  OUTROS
}

enum SituacaoSolicitacao {
  RECEBIDA
  EM_ANALISE
  EM_ATENDIMENTO
  AGUARDANDO_CIDADAO  // documentos pendentes
  CONCLUIDA
  INDEFERIDA
  CANCELADA
}

model Manifestacao {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "OUV-2026-000001"

  tipo        TipoManifestacao
  situacao    SituacaoManifestacao @default(RECEBIDA)
  prioridade  PrioridadeManifestacao @default(MEDIA)

  // Identificação do cidadão (pode ser anônima)
  anonimo     Boolean  @default(false)
  cidadaoNome String?
  cidadaoCPF  String?
  cidadaoEmail String?
  cidadaoTelefone String?
  cidadaoEndereco String?

  // Conteúdo
  assunto     String
  descricao   String   @db.Text
  orgaoRelacionado String?  // secretaria relacionada
  localOcorrencia  String?
  dataOcorrencia   DateTime?

  // Gestão interna
  analista    String?  // servidor responsável
  priorizado  Boolean  @default(false)
  sigiloso    Boolean  @default(false)  // LGPD / LAI

  // Resposta
  resposta    String?  @db.Text
  dataResposta DateTime?
  satisfacao  Int?     // 1-5 avaliação do cidadão

  // Prazos legais
  // LAI: 20 dias úteis (prorrogável +10)
  // Lei 13.460: prazo definido pelo órgão
  prazoResposta DateTime?
  dataLimite    DateTime?

  anexos      AnexoManifestacao[]
  tramitacoes TramitacaoManifestacao[]

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt


  movimentacoes  MovimentacaoManifestacao[]
  respostas  RespostaManifestacao[]
  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, tipo])
  @@index([municipioId, cidadaoCPF])
}

model AnexoManifestacao {
  id            String @id @default(cuid())
  manifestacaoId String
  nomeArquivo   String
  url           String
  tamanho       Int?
  criadoEm      DateTime @default(now())

  manifestacao Manifestacao @relation(fields: [manifestacaoId], references: [id])
}

model TramitacaoManifestacao {
  id            String   @id @default(cuid())
  manifestacaoId String
  situacaoAnterior String?
  situacaoNova     String
  descricao        String  @db.Text
  responsavel      String?
  dataTramitacao   DateTime @default(now())

  manifestacao Manifestacao @relation(fields: [manifestacaoId], references: [id])

  @@index([manifestacaoId])
}

model ServicoCidadao {
  id          String   @id @default(cuid())
  municipioId String

  tipo        TipoServicoCidadao
  nome        String
  descricao   String   @db.Text
  requisitos  String?  @db.Text     // documentos necessários
  etapas      String?  @db.Text     // passo a passo
  prazoAtendimento String?          // ex: "5 dias úteis"
  taxas       Decimal? @db.Decimal(10,2)
  canais      String?               // presencial, online, telefone
  unidadeResponsavel String?
  horarioAtendimento String?
  legislacao  String?               // base legal

  ativo     Boolean  @default(true)
  destaque  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  solicitacoes SolicitacaoServico[]

  @@index([municipioId, tipo])
  @@index([municipioId, ativo])
}

model SolicitacaoServico {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "SOL-2026-000001"
  servicoId   String

  situacao    SituacaoSolicitacao @default(RECEBIDA)

  // Cidadão
  cidadaoNome String
  cidadaoCPF  String
  cidadaoEmail String?
  cidadaoTelefone String?

  // Detalhes
  descricaoSolicitacao String? @db.Text
  documentosAnexados   String? @db.Text  // lista de docs enviados

  // Atendimento
  analista    String?
  resposta    String?  @db.Text
  motivoIndeferimento String? @db.Text
  dataPrevAtendimento DateTime?
  dataAtendimento     DateTime?

  satisfacao  Int?

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servico ServicoCidadao @relation(fields: [servicoId], references: [id])

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
  @@index([municipioId, cidadaoCPF])
}

model PedidoLAI {
  id          String   @id @default(cuid())
  municipioId String
  protocolo   String   // "LAI-2026-000001"

  // Requerente
  requerenteNome String
  requerenteCPF  String?
  requerenteEmail String
  requerenteTelefone String?
  requerenteEndereco String?

  // Pedido
  assunto     String
  descricao   String   @db.Text
  formatoResposta String @default("DIGITAL")  // DIGITAL / IMPRESSO / CONSULTA_LOCAL
  finalidade  String?

  situacao    String   @default("RECEBIDO")  // RECEBIDO / EM_ANALISE / RESPONDIDO / RECURSO_1 / RECURSO_2 / CONCLUIDO / NEGADO

  // Resposta
  resposta    String?  @db.Text
  dataResposta DateTime?
  motivoNegativa String? @db.Text  // hipóteses do Art. 23 da LAI
  formatoRespostaFinal String?

  // Prazos LAI
  dataLimiteResposta DateTime?   // 20 dias úteis (Art. 11)
  dataLimiteProrrogado DateTime? // +10 dias (Art. 11 §2)

  // Recurso
  recurso1    String?  @db.Text
  dataRecurso1 DateTime?
  respostaRecurso1 String? @db.Text
  recurso2    String?  @db.Text
  dataRecurso2 DateTime?
  respostaRecurso2 String? @db.Text

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, protocolo])
  @@index([municipioId, situacao])
}

enum RegimeJuridico {
  ESTATUTARIO       // concurso público, estabilidade
  CLT               // emprego público, celetista
  COMISSIONADO      // cargo em comissão, sem estabilidade
  ESTAGIARIO
  TEMPORARIO        // Lei 8.745/93 equivalente municipal
}

enum SituacaoServidor {
  ATIVO
  AFASTADO
  FERIAS
  CEDIDO
  LICENCA
  APOSENTADO
  EXONERADO
  DEMITIDO
  FALECIDO
}

enum VinculoFuncional {
  EFETIVO
  COMISSAO
  DESIGNACAO_FUNCAO
  CONTRATO_TEMPORARIO
}

enum TipoAfastamento {
  LICENCA_MEDICA
  LICENCA_MATERNIDADE     // 120-180 dias
  LICENCA_PATERNIDADE     // 5-20 dias
  LICENCA_GALA            // 8 dias
  LICENCA_LUTO            // 8 dias
  LICENCA_INTERESSE_PARTICULAR
  CEDENCIA
  MANDATO_ELETIVO
  MANDATO_CLASSISTA
  SUSPENSAO_DISCIPLINAR
  OUTROS
}

enum SituacaoFolha {
  RASCUNHO
  PROCESSADA
  FECHADA
  PAGA
  RETIFICADA
}

enum TipoFolha {
  MENSAL
  DECIMO_TERCEIRO_PRIMEIRO  // 1ª parcela (nov)
  DECIMO_TERCEIRO_SEGUNDO   // 2ª parcela (dez)
  FERIAS
  RESCISAO
  COMPLEMENTAR
}

enum TipoRubrica {
  PROVENTO      // acréscimo
  DESCONTO      // subtração
  INFORMATIVO   // não impacta líquido
}

enum SituacaoFerias {
  PROGRAMADA
  EM_GOZO
  CONCLUIDA
  CANCELADA
  CONVERTIDA_PECUNIA   // Art. 143 Lei 8.112 — conversão em abono pecuniário
}

model Servidor {
  id          String   @id @default(cuid())
  municipioId String
  matricula   String   // "SRV-000001"

  // Dados pessoais
  nome         String
  cpf          String
  rg           String?
  dataNascimento DateTime?
  sexo         String?   // M/F/O
  estadoCivil  String?
  nomeMae      String?
  naturalidade String?
  nacionalidade String @default("Brasileira")

  // Contato
  email        String?
  telefone     String?
  celular      String?
  enderecoRua  String?
  enderecoNumero String?
  enderecoBairro String?
  enderecoMunicipio String?
  enderecoUF   String?
  enderecoCEP  String?

  // Dados funcionais
  cargoId      String
  departamentoId String?
  regimeJuridico RegimeJuridico @default(ESTATUTARIO)
  vinculoFuncional VinculoFuncional @default(EFETIVO)
  situacao     SituacaoServidor @default(ATIVO)

  dataAdmissao  DateTime
  dataExoneracao DateTime?
  numeroPIS     String?   // NIT/PIS/PASEP
  numeroCtps    String?
  serieCtps     String?

  // Remuneração
  salarioBruto  Decimal  @db.Decimal(10,2)
  salarioBase   Decimal? @db.Decimal(10,2)

  // Conta bancária
  bancoNome    String?
  bancoCodigo  String?
  agencia      String?
  contaCorrente String?
  tipoConta    String?

  // Previdência
  regimePrevidencia String @default("RPPS")  // RPPS | RGPS
  aliquotaPrevidencia Float @default(14.0)   // % contribuição servidor

  // Jornada
  cargaHorariaSemanal Float @default(40)

  foto         String?   // URL
  observacoes  String?   @db.Text

  ativo     Boolean  @default(true)
  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cargo       Cargo        @relation(fields: [cargoId], references: [id])
  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  afastamentos AfastamentoServidor[]
  ferias       FeriasServidor[]
  contracheques Contracheque[]

  @@unique([municipioId, matricula])
  @@unique([municipioId, cpf])
  @@index([municipioId, situacao])
  @@index([municipioId, departamentoId])
}

model AfastamentoServidor {
  id          String   @id @default(cuid())
  municipioId String
  servidorId  String

  tipo        TipoAfastamento
  dataInicio  DateTime
  dataFim     DateTime?
  diasAfastamento Int?

  cid         String?    // CID-10 (licença médica)
  motivoDetalhado String? @db.Text
  peritoNome  String?
  documentoNumero String?

  prorrogavel Boolean @default(false)
  remunerado  Boolean @default(true)

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servidor Servidor @relation(fields: [servidorId], references: [id])

  @@index([municipioId, servidorId])
  @@index([municipioId, tipo])
}

model FeriasServidor {
  id          String   @id @default(cuid())
  municipioId String
  servidorId  String

  periodoAquisitivo String    // "2025/2026"
  dataInicioGozo   DateTime?
  dataFimGozo      DateTime?
  diasDireito      Int       @default(30)
  diasGozo         Int       @default(30)
  diasAbono        Int       @default(0)   // até 10 dias convertíveis

  situacao    SituacaoFerias @default(PROGRAMADA)
  valorAbono  Decimal? @db.Decimal(10,2)   // 1/3 constitucional

  dataVencimento DateTime?   // prazo máximo para gozar

  usuarioId String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servidor Servidor @relation(fields: [servidorId], references: [id])

  @@unique([municipioId, servidorId, periodoAquisitivo])
  @@index([municipioId, situacao])
}

model Rubrica {
  id          String   @id @default(cuid())
  municipioId String

  codigo      String
  descricao   String
  tipo        TipoRubrica @default(PROVENTO)

  // Configuração de cálculo
  calculoAutomatico Boolean @default(false)
  baseCalculo  String?   // ex: "SALARIO_BASE", "BRUTO"
  percentual   Float?
  valorFixo    Decimal? @db.Decimal(10,2)

  incideINSS   Boolean @default(true)
  incideIRRF   Boolean @default(true)
  incideFGTS   Boolean @default(true)

  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  itens ItemFolha[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
}

model FolhaPagamento {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // "FOLHA-2026-11"

  competencia  String   // "2026-11"
  tipo         TipoFolha @default(MENSAL)
  situacao     SituacaoFolha @default(RASCUNHO)

  // Totais agregados
  totalProventos   Decimal @db.Decimal(14,2) @default(0)
  totalDescontos   Decimal @db.Decimal(14,2) @default(0)
  totalLiquido     Decimal @db.Decimal(14,2) @default(0)
  totalINSS        Decimal @db.Decimal(14,2) @default(0)
  totalIRRF        Decimal @db.Decimal(14,2) @default(0)
  totalFGTS        Decimal @db.Decimal(14,2) @default(0)
  quantidadeServid Int @default(0)

  dataProcessamento DateTime?
  dataFechamento    DateTime?
  dataPagamento     DateTime?

  observacoes String? @db.Text
  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contracheques Contracheque[]

  @@unique([municipioId, numero])
  @@unique([municipioId, competencia, tipo])
  @@index([municipioId, situacao])
}

model Contracheque {
  id          String   @id @default(cuid())
  municipioId String
  folhaId     String
  servidorId  String

  competencia  String

  salarioBruto Decimal @db.Decimal(10,2)
  totalProventos Decimal @db.Decimal(10,2) @default(0)
  totalDescontos Decimal @db.Decimal(10,2) @default(0)
  totalLiquido   Decimal @db.Decimal(10,2) @default(0)

  // Encargos patronais
  inssServidor   Decimal @db.Decimal(10,2) @default(0)
  inssPatronal   Decimal @db.Decimal(10,2) @default(0)
  irrfRetido     Decimal @db.Decimal(10,2) @default(0)
  fgtsDeposito   Decimal @db.Decimal(10,2) @default(0)

  // Base de cálculo
  baseINSS       Decimal @db.Decimal(10,2) @default(0)
  baseIRRF       Decimal @db.Decimal(10,2) @default(0)

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  folha    FolhaPagamento @relation(fields: [folhaId], references: [id])
  servidor Servidor       @relation(fields: [servidorId], references: [id])
  itens    ItemFolha[]

  @@unique([municipioId, folhaId, servidorId])
  @@index([municipioId, servidorId])
  @@index([municipioId, folhaId])
}

model ItemFolha {
  id             String   @id @default(cuid())
  municipioId    String
  contrachequeId String
  rubricaId      String

  valor     Decimal @db.Decimal(10,2)
  referencia String?   // ex: "30 dias", "40h", "15%"

  contracheque Contracheque @relation(fields: [contrachequeId], references: [id])
  rubrica      Rubrica      @relation(fields: [rubricaId], references: [id])

  @@index([municipioId, contrachequeId])
}

model FolhaCompetencia {
  id           String              @id @default(cuid())
  municipioId  String
  mes          Int                 // 1-12
  ano          Int
  status       StatusFolha         @default(ABERTA)
  totalBruto   Decimal             @default(0) @db.Decimal(14, 2)
  totalDescontos Decimal           @default(0) @db.Decimal(14, 2)
  totalLiquido Decimal             @default(0) @db.Decimal(14, 2)
  totalServidores Int              @default(0)
  observacao   String?             @db.Text
  fechadaEm    DateTime?
  fechadaPor   String?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  holerites    FolhaHolerite[]

  @@unique([municipioId, mes, ano])
  @@index([municipioId, status])
  @@map("folha_competencia")
}

enum StatusFolha {
  ABERTA
  EM_CALCULO
  CALCULADA
  FECHADA
  CANCELADA
}

model FolhaRubrica {
  id           String       @id @default(cuid())
  municipioId  String
  codigo       String       // ex: "0001", "1001"
  nome         String       // ex: "Vencimento Base", "INSS", "IRPF"
  tipo         TipoRubrica
  natureza     NaturezaRubrica @default(FIXO)
  formula      String?      @db.Text  // ex: "PERCENTUAL:11" ou "TABELA_INSS"
  percentual   Decimal?     @db.Decimal(6, 4)   // se percentual fixo
  valor        Decimal?     @db.Decimal(12, 2)  // se valor fixo
  incideInss   Boolean      @default(false)
  incideIrpf   Boolean      @default(false)
  incideFgts   Boolean      @default(false)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())

  itens        FolhaHoleriteItem[]

  @@unique([municipioId, codigo])
  @@map("folha_rubrica")
}

enum NaturezaRubrica {
  FIXO          // valor/percentual constante
  VARIAVEL      // lançado manualmente a cada mês
  AUTOMATICO    // calculado por fórmula (INSS, IRPF, FGTS)
}

model FolhaHolerite {
  id             String           @id @default(cuid())
  municipioId    String
  competenciaId  String
  servidorId     String           // referência ao modelo Servidor do módulo RH
  matricula      String
  nomeServidor   String           // desnormalizado para histórico
  cargo          String?
  lotacao        String?          // secretaria/departamento
  regimeJuridico RegimeJuridico   @default(ESTATUTARIO)

  // Totais calculados
  totalProventos   Decimal        @default(0) @db.Decimal(12, 2)
  totalDescontos   Decimal        @default(0) @db.Decimal(12, 2)
  totalLiquido     Decimal        @default(0) @db.Decimal(12, 2)
  baseFgts         Decimal        @default(0) @db.Decimal(12, 2)
  baseInss         Decimal        @default(0) @db.Decimal(12, 2)
  baseIrpf         Decimal        @default(0) @db.Decimal(12, 2)

  // Dias trabalhados
  diasTrabalhados  Int            @default(30)
  diasFaltas       Int            @default(0)
  diasAfastamento  Int            @default(0)

  status           StatusHolerite @default(RASCUNHO)
  observacao       String?        @db.Text
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  competencia    FolhaCompetencia @relation(fields: [competenciaId], references: [id])
  itens          FolhaHoleriteItem[]

  @@unique([competenciaId, servidorId])
  @@index([municipioId, competenciaId])
  @@index([municipioId, servidorId])
  @@map("folha_holerite")
}

enum StatusHolerite {
  RASCUNHO
  CALCULADO
  CONFIRMADO
  ESTORNADO
}

model FolhaHoleriteItem {
  id           String         @id @default(cuid())
  holeriteId   String
  rubricaId    String
  referencia   String?        // ex: "30 dias", "11%", "3 faltas"
  valor        Decimal        @db.Decimal(12, 2)
  tipo         TipoRubrica    // duplicado para evitar JOIN em relatórios

  holerite   FolhaHolerite @relation(fields: [holeriteId], references: [id], onDelete: Cascade)
  rubrica    FolhaRubrica  @relation(fields: [rubricaId], references: [id])

  @@index([holeriteId])
  @@map("folha_holerite_item")
}

model Fornecedor {
  id            String   @id @default(cuid())
  municipioId   String
  cnpj          String
  razaoSocial   String
  nomeFantasia  String?
  email         String?
  telefone      String?
  endereco      String?
  cidade        String?
  uf            String?
  cep           String?
  contato       String?  // nome do representante

  tipoPorte     PorteFornecedor @default(OUTROS)  // ME, EPP, outros — LC 123/2006
  ativo         Boolean  @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  itensCotacao  ItemCotacao[]
  itensPedido   ItemPedido[]


  contratos  Contrato[]
  propostas  Proposta[]
  @@unique([municipioId, cnpj])
  @@index([municipioId, ativo])
  @@map("fornecedor")
}

enum PorteFornecedor {
  ME      // Microempresa
  EPP     // Empresa de Pequeno Porte
  OUTROS
}

model CategoriaCompra {
  id          String   @id @default(cuid())
  municipioId String
  nome        String
  codigo      String?  // código CATMAT/CATSER
  ativo       Boolean  @default(true)

  itens       ItemRequisicao[]

  @@unique([municipioId, nome])
  @@map("categoria_compra")
}

model Requisicao {
  id            String         @id @default(cuid())
  municipioId   String
  numero        String         // ex: "REQ-2025-0042"
  titulo        String
  justificativa String         @db.Text
  secretaria    String
  solicitante   String
  prioridade    Prioridade     @default(NORMAL)
  status        StatusReq      @default(RASCUNHO)

  dataRequisicao  DateTime     @default(now())
  dataLimite      DateTime?    // prazo máximo para atendimento
  dataAprovacao   DateTime?
  aprovadoPor     String?
  motivoRejeicao  String?

  valorEstimado   Decimal?     @db.Decimal(12, 2)
  observacao      String?      @db.Text

  itens           ItemRequisicao[]
  cotacoes        Cotacao[]

  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt


  movimentacoes  MovimentacaoEstoque[]
  @@unique([municipioId, numero])
  @@index([municipioId, status, prioridade])
  @@map("requisicao")
}

enum StatusReq {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  EM_COTACAO
  CONCLUIDA
  REJEITADA
  CANCELADA
}

model ItemRequisicao {
  id           String   @id @default(cuid())
  requisicaoId String
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id])
  categoriaId  String?
  categoria    CategoriaCompra? @relation(fields: [categoriaId], references: [id])

  descricao    String
  unidade      String   // UN, KG, L, m², etc.
  quantidade   Decimal  @db.Decimal(10, 3)
  valorUnitEstimado Decimal? @db.Decimal(10, 2)
  especificacao String? @db.Text  // detalhamento técnico


  catalogoId   String?
  catalogo     CatalogoMaterial? @relation(fields: [catalogoId], references: [id])
  @@index([requisicaoId])
  @@map("item_requisicao")
}

model Cotacao {
  id            String       @id @default(cuid())
  municipioId   String
  numero        String       // ex: "COT-2025-0012"
  requisicaoId  String?
  requisicao    Requisicao?  @relation(fields: [requisicaoId], references: [id])
  titulo        String
  status        StatusCot    @default(ABERTA)

  dataAbertura  DateTime     @default(now())
  dataFechamento DateTime?
  responsavel   String

  observacao    String?      @db.Text

  itens         ItemCotacao[]

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@map("cotacao")
}

enum StatusCot {
  ABERTA
  EM_ANALISE
  CONCLUIDA
  CANCELADA
}

model ItemCotacao {
  id           String    @id @default(cuid())
  cotacaoId    String
  cotacao      Cotacao   @relation(fields: [cotacaoId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  descricao    String
  unidade      String
  quantidade   Decimal   @db.Decimal(10, 3)
  valorUnitario Decimal  @db.Decimal(10, 2)
  valorTotal   Decimal   @db.Decimal(12, 2)
  marca        String?
  prazoEntrega Int?      // dias

  melhorPreco  Boolean   @default(false)  // vencedor da cotação para este item

  @@index([cotacaoId])
  @@index([fornecedorId])
  @@map("item_cotacao")
}

model PedidoCompra {
  id            String       @id @default(cuid())
  municipioId   String
  numero        String       // ex: "PC-2025-0008"
  cotacaoId     String?
  status        StatusPedido @default(EMITIDO)

  dataEmissao   DateTime     @default(now())
  dataEntregaPrev DateTime?
  dataEntregaReal DateTime?

  secretaria    String
  responsavel   String
  observacao    String?      @db.Text

  valorTotal    Decimal      @db.Decimal(12, 2)

  // Rastreabilidade orçamentária
  empenhoNumero String?
  contaContabil String?

  itens         ItemPedido[]

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@unique([municipioId, numero])
  @@index([municipioId, status])
  @@map("pedido_compra")
}

enum StatusPedido {
  EMITIDO
  ENVIADO_FORNECEDOR
  CONFIRMADO_FORNECEDOR
  EM_TRANSITO
  RECEBIDO_PARCIAL
  RECEBIDO_TOTAL
  CANCELADO
}

model ItemPedido {
  id           String      @id @default(cuid())
  pedidoId     String
  pedido       PedidoCompra @relation(fields: [pedidoId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor  @relation(fields: [fornecedorId], references: [id])

  descricao    String
  unidade      String
  quantidade   Decimal     @db.Decimal(10, 3)
  qtdRecebida  Decimal     @db.Decimal(10, 3) @default(0)
  valorUnitario Decimal    @db.Decimal(10, 2)
  valorTotal   Decimal     @db.Decimal(12, 2)

  @@index([pedidoId])
  @@map("item_pedido")
}

enum ModalidadeLicitacao {
  PREGAO_ELETRONICO       // Lei 10.520/2002 — mais usado para bens/serviços
  PREGAO_PRESENCIAL
  CONCORRENCIA            // Lei 14.133/2021 — obras/serviços de engenharia ≥ R$2.500.000
  CONCURSO                // trabalhos técnicos/artísticos
  LEILAO                  // alienação de bens
  DISPENSA                // Art. 75 — valor ou situação especial
  INEXIGIBILIDADE         // Art. 74 — exclusividade / notória especialização
  CHAMAMENTO_PUBLICO      // OSCs — Lei 13.019/2014
}

enum SituacaoProcesso {
  RASCUNHO
  PUBLICADO               // edital publicado no DOE/PNCP
  EM_ANDAMENTO
  SUSPENSO
  DESERTO                 // sem participantes
  FRACASSADO              // propostas inabilitadas/desclassificadas
  HOMOLOGADO
  REVOGADO
  ANULADO
  CONCLUIDO
}

enum SituacaoProposta {
  RECEBIDA
  EM_ANALISE
  HABILITADA
  INABILITADA
  CLASSIFICADA
  DESCLASSIFICADA
  VENCEDORA
  SEGUNDA_COLOCADA        // para caso de desistência da vencedora
}

enum SituacaoContrato {
  MINUTA
  ASSINADO
  VIGENTE
  SUSPENSO
  RESCINDIDO
  ENCERRADO
  PRORROGADO
}

enum TipoObjeto {
  OBRAS
  SERVICOS_ENGENHARIA
  COMPRAS_BENS
  SERVICOS_CONTINUADOS
  LOCACOES
  CONCESSOES
}

enum SituacaoItem {
  PENDENTE
  COTADO
  ADJUDICADO
  CANCELADO
}

model ProcessoLicitatorio {
  id              String    @id @default(cuid())
  municipioId     String
  numero          String    // Ex: PREGÃO 001/2026
  modalidade      ModalidadeLicitacao
  tipoObjeto      TipoObjeto
  objeto          String    @db.Text
  justificativa   String?   @db.Text
  valorEstimado   Float
  dotacaoOrca     String?   // dotação orçamentária
  exercicio       Int       // ano
  dataPublicacao  DateTime?
  dataAbertura    DateTime? // abertura das propostas
  dataJulgamento  DateTime?
  dataHomologacao DateTime?
  situacao        SituacaoProcesso @default(RASCUNHO)
  criterioJulgamento String  @default("MENOR_PRECO")
  exclusivoMePP   Boolean  @default(false) // LC 123/2006
  margemPreferencia Float?  // % preferência p/ nac.
  responsavelId   String
  comissao        String?  // nomes separados por vírgula
  editalUrl       String?
  observacoes     String?  @db.Text
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  usuarioId       String

  itens       ItemLicitacao[]
  propostas   Proposta[]
  contratos   Contrato[]
  ata         AtaRegistroPreco?

  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, exercicio])
  @@map("processos_licitatorios")
}

model ItemLicitacao {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  numero      Int       // sequencial dentro do processo
  descricao   String    @db.Text
  unidade     String    // un, cx, m², kg, h…
  quantidade  Float
  valorUnitEstimado Float
  valorTotalEstimado Float
  situacao    SituacaoItem @default(PENDENTE)
  categoriaMaterial String? // código CATMAT/CATSER
  criadoEm    DateTime @default(now())

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  propostas   PropostaItem[]


  licitacoes  Licitacao[]
  @@index([processoId])
  @@map("itens_licitacao")
}

model Proposta {
  id          String    @id @default(cuid())
  municipioId String
  processoId  String
  fornecedorId String
  numero      String    // PROP-2026-000001
  valorTotal  Float
  prazoEntrega Int?     // dias
  validade    Int       @default(60) // dias de validade
  situacao    SituacaoProposta @default(RECEBIDA)
  motivoInabilitacao String?
  observacoes String?  @db.Text
  dataRecebimento DateTime @default(now())
  criadoEm    DateTime @default(now())
  usuarioId   String

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  fornecedor  Fornecedor          @relation(fields: [fornecedorId], references: [id])
  itens       PropostaItem[]
  contrato    Contrato?

  @@unique([municipioId, numero])
  @@index([processoId, situacao])
  @@map("propostas")
}

model PropostaItem {
  id          String  @id @default(cuid())
  municipioId String
  propostaId  String
  itemId      String
  valorUnitario Float
  valorTotal    Float
  marca       String?

  proposta    Proposta      @relation(fields: [propostaId], references: [id])
  item        ItemLicitacao @relation(fields: [itemId], references: [id])

  @@index([propostaId])
  @@map("proposta_itens")
}

model Contrato {
  id              String    @id @default(cuid())
  municipioId     String
  numero          String    // CONTRATO 001/2026
  processoId      String
  fornecedorId    String
  propostaId      String?   @unique
  objeto          String    @db.Text
  valorInicial    Float
  valorAtual      Float     // pode variar por aditivos
  dataAssinatura  DateTime?
  dataInicio      DateTime?
  dataFim         DateTime?
  situacao        SituacaoContrato @default(MINUTA)
  dotacaoOrca     String?
  responsavelId   String
  gestorId        String?   // gestor do contrato
  fiscalId        String?   // fiscal do contrato
  contratoUrl     String?   // link para PDF assinado
  motivoRescisao  String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  usuarioId       String

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])
  fornecedor  Fornecedor          @relation(fields: [fornecedorId], references: [id])
  proposta    Proposta?           @relation(fields: [propostaId], references: [id])
  aditivos    AditivoContrato[]
  medicoes    MedicaoContrato[]


  licitacoes  Licitacao[]
  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@map("contratos")
}

model AditivoContrato {
  id          String   @id @default(cuid())
  municipioId String
  contratoId  String
  numero      Int      // sequencial do aditivo
  tipo        String   // PRAZO, VALOR, OBJETO
  descricao   String   @db.Text
  valorAcrescimo Float @default(0)  // pode ser negativo (supressão)
  prazoDias   Int?     // dias adicionados
  dataAssinatura DateTime?
  criadoEm    DateTime @default(now())
  usuarioId   String

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  @@index([contratoId])
  @@map("aditivos_contrato")
}

model MedicaoContrato {
  id          String   @id @default(cuid())
  municipioId String
  contratoId  String
  numero      Int      // sequencial da medição
  periodo     String   // "2026-01"
  valorMedido Float
  valorAprovado Float?
  dataEnvio   DateTime?
  dataAprovacao DateTime?
  situacao    String   @default("ENVIADA") // ENVIADA, APROVADA, REPROVADA
  observacoes String?  @db.Text
  criadoEm    DateTime @default(now())
  usuarioId   String

  contrato    Contrato @relation(fields: [contratoId], references: [id])

  @@index([contratoId])
  @@map("medicoes_contrato")
}

model AtaRegistroPreco {
  id          String   @id @default(cuid())
  municipioId String
  numero      String   // ARP 001/2026
  processoId  String   @unique
  objeto      String   @db.Text
  dataAssinatura DateTime?
  dataValidade   DateTime  // máx. 12 meses — Art. 84 Lei 14.133/2021
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  processo    ProcessoLicitatorio @relation(fields: [processoId], references: [id])

  @@unique([municipioId, numero])
  @@map("atas_registro_preco")
}

enum FormaLicitacao {
  MENOR_PRECO
  MAIOR_DESCONTO
  MELHOR_TECNICA
  TECNICA_PRECO
  MAIOR_LANCE        // leilão
  MAIOR_RETORNO
}

enum SituacaoLicitacao {
  RASCUNHO
  PUBLICADA          // aviso publicado no PNCP/DOE
  EM_PRAZO           // dentro do prazo para propostas
  EM_JULGAMENTO
  HOMOLOGADA
  DESERTA            // nenhuma proposta recebida
  FRACASSADA         // propostas desclassificadas
  REVOGADA
  ANULADA
  ADJUDICADA         // objeto adjudicado ao vencedor
}

enum TipoAditivo {
  PRAZO              // prorrogação de prazo
  VALOR              // acréscimo/supressão (limite 25% obras; 50% reformas)
  OBJETO             // alteração do objeto
  PRAZO_VALOR
  REEQUILIBRIO       // reequilíbrio econômico-financeiro
}

enum SituacaoItemLic {
  ABERTO
  ADJUDICADO
  CANCELADO
  DESERTO
  FRACASSADO
}

model Licitacao {
  id          String   @id @default(cuid())
  municipioId String

  numero      String            // "LIC-2026-001"
  modalidade  ModalidadeLicitacao
  forma       FormaLicitacao
  situacao    SituacaoLicitacao @default(RASCUNHO)

  objeto      String            // descrição do objeto
  justificativa String?  @db.Text
  fundamentacao String?         // Art. 75 / Art. 74 (dispensas e inexigibilidades)

  // Valores
  valorEstimado Decimal  @db.Decimal(15,2)
  valorHomologado Decimal? @db.Decimal(15,2)

  // Datas
  dataPublicacao   DateTime?
  dataAbertura     DateTime?   // abertura das propostas
  dataJulgamento   DateTime?
  dataHomologacao  DateTime?
  dataAdjudicacao  DateTime?

  // Localização e publicidade
  urlEdital        String?
  urlAta           String?
  urlResultado     String?
  pncpNumero       String?     // número PNCP (Portal Nacional de Contratações Públicas)
  doeNumero        String?     // Diário Oficial do Estado

  // Responsáveis
  comissao         String?     // membros da comissão de licitação
  pregoeiro        String?     // para pregões

  // Exercício
  exercicio        Int
  unidadeGestora   String?
  dotacaoOrcamentaria String?
  fonteCusteio     String?

  itens            ItemLicitacao[]
  propostas        PropostaLicitacao[]
  contrato         Contrato[]

  usuarioId        String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt


  lotes  LoteLicitacao[]
  participantes  ParticipanteLicitacao[]
  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([municipioId, exercicio])
  @@index([municipioId, modalidade])
}

model PropostaLicitacao {
  id          String   @id @default(cuid())
  licitacaoId String
  municipioId String

  fornecedorNome String
  fornecedorCNPJ String
  porte          String?    // ME/EPP/Grande
  valorTotal     Decimal @db.Decimal(15,2)
  tecnica        String? @db.Text
  situacao       String @default("RECEBIDA")  // RECEBIDA/CLASSIFICADA/DESCLASSIFICADA/VENCEDORA
  motivoDesclass String? @db.Text
  colocacao      Int?

  criadoEm    DateTime @default(now())
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id])

  @@index([licitacaoId])
}

enum NaturezaConta {
  ATIVO           // 1 — Ativo
  PASSIVO         // 2 — Passivo
  PATRIMONIO_LQUIDO // 3 — Patrimônio Líquido / Saldo Patrimonial
  VARIACAO_PATRIMONIAL_AUMENTATIVA  // 4 — VPA
  VARIACAO_PATRIMONIAL_DIMINUTIVA   // 5 — VPD
  CONTROLE_ATIVO  // 7 — Controles devedores
  CONTROLE_PASSIVO // 8 — Controles credores
}

enum TipoLancamento {
  DEBITO
  CREDITO
}

enum SituacaoEmpenho {
  EMITIDO        // Art. 58 — empenho emitido
  ANULADO        // empenho anulado total ou parcialmente
  LIQUIDADO      // Art. 63 — liquidação da despesa
  PAGO           // Art. 64 — pagamento
  INSCRITO_RP    // inscrito em restos a pagar
}

enum ModalidadeEmpenho {
  ORDINARIO      // valor preciso e definitivo
  ESTIMATIVO     // quando o montante não pode ser determinado
  GLOBAL         // contratos ou ajustes de execução parcelada
}

enum TipoOrcamento {
  LOA            // Lei Orçamentária Anual
  ABERTURA_CREDITO
  SUPLEMENTACAO
  REDUCAO
  TRANSPOSICAO
  REMANEJAMENTO
}

enum SituacaoDotacao {
  ATIVA
  BLOQUEADA
  ENCERRADA
}

model ContaContabil {
  id              String   @id @default(cuid())
  municipioId     String
  codigo          String   // ex: 1.1.1.1.1.00.00 (PCASP 7 níveis)
  codigoPai       String?  // referência ao pai (redundante para queries)
  nome            String
  descricao       String?  @db.Text
  natureza        NaturezaConta
  nivel           Int      // 1-6 profundidade da conta
  analitica       Boolean  @default(false) // true = conta de lançamento
  aceitaLancamento Boolean @default(false)
  codigoFuncional String?  // classificação funcional programática
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  debitoItens     LancamentoItem[] @relation("DebitoItens")
  creditoItens    LancamentoItem[] @relation("CreditoItens")

  @@unique([municipioId, codigo])
  @@index([municipioId, natureza])
  @@index([codigoPai])
  @@map("contas_contabeis")
}

model ExercicioOrcamentario {
  id              String   @id @default(cuid())
  municipioId     String
  exercicio       Int      // ano (ex: 2026)
  descricao       String?
  status          String   @default("ABERTO") // ABERTO, ENCERRADO
  dataInicio      DateTime
  dataFim         DateTime
  criadoEm        DateTime @default(now())
  usuarioId       String

  dotacoes        Dotacao[]
  empenhos        Empenho[]
  lancamentos     Lancamento[]

  @@unique([municipioId, exercicio])
  @@index([municipioId])
  @@map("exercicios_orcamentarios")
}

model Dotacao {
  id                   String   @id @default(cuid())
  municipioId          String
  exercicioId          String
  // Classificação orçamentária completa
  unidadeOrcamentaria  String   // ex: 02.001 (Secretaria de Educação)
  funcao               String   // ex: 12 (Educação)
  subfuncao            String   // ex: 361
  programa             String   // ex: 0001
  acao                 String   // ex: 2001
  elementoDespesa      String   // ex: 3.1.90.11.00 (Vencimentos)
  fonteRecurso         String   // ex: 00 (Recursos Ordinários)
  // Descrições
  descricaoUnidade     String?
  descricaoElemento    String?
  // Valores
  valorDotacaoInicial  Float    @default(0)
  valorSuplementacao   Float    @default(0)
  valorReducao         Float    @default(0)
  situacao             SituacaoDotacao @default(ATIVA)
  criadoEm             DateTime @default(now())
  usuarioId            String

  exercicio            ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  empenhos             Empenho[]

  // Saldo calculado = dotacaoInicial + suplementacao - reducao - empenhos emitidos

  orcamentos  Orcamento[]
  unidades  UnidadeOrcamentaria[]
  @@unique([municipioId, exercicioId, unidadeOrcamentaria, funcao, subfuncao, programa, acao, elementoDespesa, fonteRecurso])
  @@index([municipioId, exercicioId])
  @@map("dotacoes")
}

model Empenho {
  id                String   @id @default(cuid())
  municipioId       String
  numero            String   // ex: "2026NE000001"
  exercicioId       String
  dotacaoId         String
  fornecedorNome    String
  fornecedorCpfCnpj String?
  descricao         String   @db.Text
  modalidade        ModalidadeEmpenho @default(ORDINARIO)
  situacao          SituacaoEmpenho   @default(EMITIDO)
  valorOriginal     Float
  valorAnulado      Float    @default(0)
  valorLiquidado    Float    @default(0)
  valorPago         Float    @default(0)
  dataEmissao       DateTime @default(now())
  dataLiquidacao    DateTime?
  dataPagamento     DateTime?
  processoLicitatorio String? // referência ao processo licitatório
  contaContaId      String?  // conta a pagar destino
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  usuarioId         String

  exercicio         ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  dotacao           Dotacao  @relation(fields: [dotacaoId], references: [id])
  lancamentos       Lancamento[]


  liquidacoes  LiquidacaoEmpenho[]
  liquidacoesSimples  Liquidacao[]
  pagamentos  PagamentoEmpenho[]
  pagamentosSimples  Pagamento[]
  @@unique([municipioId, numero])
  @@index([municipioId, situacao])
  @@index([dotacaoId])
  @@map("empenhos")
}

model Lancamento {
  id              String   @id @default(cuid())
  municipioId     String
  numero          String   // ex: "L2026000001"
  exercicioId     String
  empenhoId       String?  // opcional — lançamentos livres possíveis
  data            DateTime @default(now())
  historico       String   @db.Text // descrição do lançamento
  valor           Float
  tipoLancamento  TipoLancamento  // DEBITO ou CREDITO (do 1º item)
  criadoEm        DateTime @default(now())
  usuarioId       String

  exercicio       ExercicioOrcamentario @relation(fields: [exercicioId], references: [id])
  empenho         Empenho? @relation(fields: [empenhoId], references: [id])
  itens           LancamentoItem[]

  @@unique([municipioId, numero])
  @@index([municipioId, data])
  @@map("lancamentos")
}

model LancamentoItem {
  id              String   @id @default(cuid())
  municipioId     String
  lancamentoId    String
  contaDebitoId   String
  contaCreditoId  String
  tipo            TipoLancamento
  valor           Float
  ordem           Int      @default(0)

  lancamento      Lancamento      @relation(fields: [lancamentoId], references: [id])
  contaDebito     ContaContabil   @relation("DebitoItens",  fields: [contaDebitoId], references: [id], map: "lancamento_itens_contaDebitoId_fkey")
  contaCredito    ContaContabil   @relation("CreditoItens", fields: [contaCreditoId], references: [id], map: "lancamento_itens_contaCreditoId_fkey")

  @@index([lancamentoId])
  @@index([contaDebitoId])
  @@index([contaCreditoId])
  @@map("lancamento_itens")
}

model RegraContabilizacao {
  id              String   @id @default(cuid())
  municipioId     String
  codigo          String
  descricao       String
  // Fórmula do lançamento padrão
  contaDebitoId   String?
  contaCreditoId  String?
  contaDebito     String?  // código da conta
  contaCredito    String?  // código da conta
  naturezaDespesa String?  // filtro por elemento
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  @@unique([municipioId, codigo])
  @@map("regras_contabilizacao")
}

enum NaturezaDespesa {
  PESSOAL_ENCARGOS        // 3.1 — maior fatia das despesas municipais
  JUROS_ENCARGOS_DIVIDA   // 3.2 — serviço da dívida pública
  OUTRAS_CORRENTES        // 3.3 — material consumo, serviços, diárias
  INVESTIMENTOS           // 4.4 — obras, equipamentos
  INVERSOES_FINANCEIRAS   // 4.5 — aquisição imóveis, participações
  AMORTIZACAO_DIVIDA      // 4.6 — principal da dívida
  RESERVA_CONTINGENCIA    // 9.9
}

enum CategoriaEconomica {
  CORRENTE    // custeio das atividades
  CAPITAL     // expansão patrimonial
}

enum ModalidadeAplicacao {
  APLICACOES_DIRETAS         // 90
  TRANSFERENCIAS_MUNICIPIOS  // 40
  TRANSFERENCIAS_ENTIDADES   // 50
  TRANSFERENCIAS_EXTERIOR    // 71
  APLICACOES_INTRA_ORCAMENTARIAS // 91
}

enum SituacaoLOA {
  ELABORACAO
  ENVIADA_CAMARA     // enviada à Câmara Municipal
  APROVADA_CAMARA
  PROMULGADA          // Lei aprovada
  VIGENTE
  ENCERRADA
}

enum SituacaoLDO {
  ELABORACAO
  ENVIADA_CAMARA
  APROVADA
  VIGENTE
  ENCERRADA
}

enum TipoSuplemento {
  SUPLEMENTAR      // reforça dotação existente (Art. 41 I Lei 4.320)
  ESPECIAL         // cria dotação nova (Art. 41 II)
  EXTRAORDINARIO   // calamidade/guerra (Art. 41 III — MP)
  REMANEJAMENTO    // cancela para suplementar
}

enum FonteSuplemento {
  EXCESSO_ARRECADACAO
  SUPERAVIT_FINANCEIRO
  ANULACAO_DOTACAO
  OPERACAO_CREDITO
  RESERVA_CONTINGENCIA
}

enum TipoEmpenho {
  ORDINARIO   // valor certo (Art. 60 Lei 4.320)
  ESTIMATIVO  // valor aproximado (contratos de duração continuada)
  GLOBAL      // contratos parcelados
}

model PPA {
  id          String   @id @default(cuid())
  municipioId String

  exercicioInicio Int   // ex: 2026
  exercicioFim    Int   // ex: 2029
  titulo          String
  descricao       String? @db.Text
  situacao        String  @default("ELABORACAO") // ELABORACAO/APROVADO/VIGENTE/ENCERRADO
  urlLei          String?
  numeroLei       String?

  programas       ProgramaPPA[]

  usuarioId       String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([municipioId])
}

model ProgramaPPA {
  id          String   @id @default(cuid())
  ppaId       String
  municipioId String

  codigo      String     // ex: "0001"
  nome        String
  objetivo    String? @db.Text
  publicoAlvo String?
  indicador   String?    // indicador de resultado
  unidadeMedida String?

  acoes       AcaoPPA[]

  ppa         PPA @relation(fields: [ppaId], references: [id])

  @@index([ppaId])
  @@index([municipioId])
}

model AcaoPPA {
  id          String   @id @default(cuid())
  programaId  String
  municipioId String

  codigo      String   // ex: "2001"
  nome        String
  tipo        String   // PROJETO/ATIVIDADE/OPERACAO_ESPECIAL
  unidadeResponsavel String?

  // Metas físicas e financeiras por exercício
  meta2026    Decimal? @db.Decimal(15,2)
  meta2027    Decimal? @db.Decimal(15,2)
  meta2028    Decimal? @db.Decimal(15,2)
  meta2029    Decimal? @db.Decimal(15,2)

  valor2026   Decimal? @db.Decimal(15,2)
  valor2027   Decimal? @db.Decimal(15,2)
  valor2028   Decimal? @db.Decimal(15,2)
  valor2029   Decimal? @db.Decimal(15,2)

  programa    ProgramaPPA @relation(fields: [programaId], references: [id])

  @@index([programaId])
}

model LDO {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int   // exercício de vigência
  titulo      String
  situacao    SituacaoLDO @default(ELABORACAO)
  urlLei      String?
  numeroLei   String?

  // LRF — Metas Fiscais (Art. 4 §1)
  metaReceitaCorrente    Decimal? @db.Decimal(15,2)
  metaDespesaCorrente    Decimal? @db.Decimal(15,2)
  metaResultadoPrimario  Decimal? @db.Decimal(15,2)
  metaResultadoNominal   Decimal? @db.Decimal(15,2)
  metaDividaConsolidada  Decimal? @db.Decimal(15,2)
  limitePessoalPct       Decimal? @db.Decimal(5,2)  // % RCL (LRF Art. 19: 54%)

  // Metas de investimento
  metaInvestimento       Decimal? @db.Decimal(15,2)

  observacoes String? @db.Text

  metas       MetaLDO[]

  usuarioId   String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, exercicio])
}

model MetaLDO {
  id      String @id @default(cuid())
  ldoId   String
  tipo    String // FISCAL/FISICA/INVESTIMENTO
  descricao String
  valor   Decimal? @db.Decimal(15,2)
  unidade String?

  ldo     LDO @relation(fields: [ldoId], references: [id])
}

model LOA {
  id          String   @id @default(cuid())
  municipioId String

  exercicio   Int
  titulo      String
  situacao    SituacaoLOA @default(ELABORACAO)
  urlLei      String?
  numeroLei   String?

  // Totais aprovados
  totalReceita Decimal? @db.Decimal(15,2)
  totalDespesa Decimal? @db.Decimal(15,2)

  observacoes  String? @db.Text

  unidades     UnidadeOrcamentaria[]
  suplementos  Suplemento[]

  usuarioId    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([municipioId, exercicio])
  @@index([municipioId])
}

model UnidadeOrcamentaria {
  id          String   @id @default(cuid())
  loaId       String
  municipioId String

  codigo      String   // ex: "02.01"
  orgao       String   // ex: "02"
  unidade     String   // ex: "01"
  nome        String

  dotacoes    Dotacao[]

  loa         LOA @relation(fields: [loaId], references: [id])

  @@index([loaId])
  @@index([municipioId])
}

model Suplemento {
  id          String   @id @default(cuid())
  loaId       String
  municipioId String

  numero      String   // "SUP-2026-001"
  tipo        TipoSuplemento
  fonte       FonteSuplemento
  justificativa String @db.Text
