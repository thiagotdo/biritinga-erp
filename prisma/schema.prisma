  IMPROVIDO           // Mantido o indeferimento
  DESISTIDO
}

enum TipoTransparencia {
  // Art. 8 LAI — obrigatórios
  ESTRUTURA_ORGANIZACIONAL      // organograma, competências
  ACOES_PROGRAMAS               // planos, projetos, programas
  LICITACOES_CONTRATOS          // editais, contratos, aditivos
  REPASSES_TRANSFERENCIAS       // convênios, subvenções, auxílios
  RECEITAS_DESPESAS             // execução orçamentária diária
  OBRAS_PUBLICAS                // andamento de obras
