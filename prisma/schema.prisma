model FamiliaReferenciada {
  id          String @id @default(cuid())
  municipioId String

  // Número do prontuário SUAS: "2026-00001"
  numeroProntuario String

  // Responsável familiar
  responsavelNome  String
  responsavelCpf   String?
  responsavelNis   String?    // NIS (Número de Identificação Social)
  responsavelSexo  String?
  responsavelDatNasc DateTime?

  // Endereço
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cep          String?
  referencia   String?   // ponto de referência

  // Contato
  telefone     String?
  telefone2    String?

  // Classificação
  nivelVulnerabilidade NivelVulnerabilidade @default(MEDIO)
  situacao             SituacaoFamilia @default(ATIVA)

  // Composição familiar (armazenada como JSON para flexibilidade)
  // [{nome, cpf, nis, dataNasc, parentesco, pcd, bolsaFamilia, ...}]
  membrosJson  String? @db.Text

  // Renda
  rendaFamiliar  Decimal? @db.Decimal(10, 2)
  percapita      Decimal? @db.Decimal(8, 2)
  quantidadeMembros Int @default(1)

  // Programas
  bolsaFamilia  Boolean @default(false)
  bpc           Boolean @default(false)
  cadunico      Boolean @default(false)
  numeroCadunico String?

  // Situação habitacional
  tipoMoradia   String?  // PROPRIO/ALUGADO/CEDIDO/OCUPAÇÃO
  condicaoMoradia String? @db.Text

  // Vulnerabilidades (flags rápidas)
  criancas      Boolean @default(false)  // tem crianças (ECA)
  idosos        Boolean @default(false)  // tem idosos (Estatuto do Idoso)
  pcd           Boolean @default(false)  // tem PcD (Lei 13.146)
  gestante      Boolean @default(false)
  violencia     Boolean @default(false)  // em situação de violência
  substancias   Boolean @default(false)  // uso de substâncias
  situacaoRua   Boolean @default(false)  // situação de rua

  unidadeId   String?
  unidade     UnidadeSuas? @relation(fields: [unidadeId], references: [id])

  tecnicoRefId String?    // técnico de referência (usuário do sistema)
  observacoes  String? @db.Text

  dataIngresso  DateTime @default(now())
  dataDesligamento DateTime?
  motivoDesligamento String?

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  atendimentos  AtendimentoSuas[]
  beneficios    BeneficioFamilia[]

  @@unique([municipioId, numeroProntuario])
  @@unique([municipioId, responsavelCpf])
  @@index([municipioId, unidadeId])
}

model AtendimentoSuas {
  id          String @id @default(cuid())
  municipioId String

  familiaId   String
  familia     FamiliaReferenciada @relation(fields: [familiaId], references: [id])

  unidadeId   String
  unidade     UnidadeSuas @relation(fields: [unidadeId], references: [id])

  tipo        TipoAtendimentoSuas
  situacao    SituacaoAtendimento @default(AGENDADO)

  dataAtendimento DateTime
  duracaoMinutos  Int?

  tecnicoNome    String?   // técnico que realizou
  tecnicoId      String?   // usuário do sistema

  // Prontuário do atendimento
  objetivo       String? @db.Text
  descricao      String? @db.Text    // relato do atendimento
  encaminhamentos String? @db.Text   // para onde foi encaminhado

  // Vulnerabilidades identificadas neste atendimento
  vulnerabilidadesIdentificadas String? @db.Text

  planoAcao      String? @db.Text    // plano de ação estabelecido

  usuarioId   String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([municipioId, familiaId])
  @@index([municipioId, dataAtendimento])
}

model BeneficioFamilia {
  id          String @id @default(cuid())
  municipioId String

  familiaId   String
  familia     FamiliaReferenciada @relation(fields: [familiaId], references: [id])

