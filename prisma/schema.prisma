  CORREIO
  PORTAL_ESIC
  PRESENCIAL
}

enum MotivoIndeferimento {
  // Art. 23 LAI — informações sigilosas
  INFORMACAO_SIGILOSA_GRAU_1    // reservada
  INFORMACAO_SIGILOSA_GRAU_2    // secreta
  INFORMACAO_SIGILOSA_GRAU_3    // ultrassecreta
  DADO_PESSOAL                  // Art. 31 — privacidade
  SEGREDO_INDUSTRIA             // segredo industrial/comercial
  // Art. 13 Decreto 7.724
  PEDIDO_GENERICO               // demasiado genérico, sem objeto claro
  TRABALHO_PRODUCAO             // exige análise/produção de dados inexistentes
  INFORMACAO_INEXISTENTE        // não há dados sobre o assunto
